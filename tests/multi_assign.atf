fn find(xs: [int], t: int) -> int? {
    return if xs.contains(t) { xs.index_of(t) } else { nil }
}
fn main() {
    var a = 1
    var b = 2
    a, b = b, a
    println(a, b)
    var x = 0
    var y = 0
    x, y = (10, 20)
    println(x, y)
    let pairs = [(1, "one"), (2, "two")]
    for (n, w) in pairs { println(n, w) }
    for i, (n, w) in pairs { println(i, n, w) }
    let arr = [5, 6]
    arr[0], arr[1] = arr[1], arr[0]
    println(arr, find(arr, 6), find(arr, 9))
}
