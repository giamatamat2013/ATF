--- py -> atf
struct Item {
    name: str,
    price: float
}

fn total(items: [Item]) -> float {
    var s = 0.0
    for it in items {
        s += it.price
    }
    return s
}

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let items = [Item("a", 1.5), Item("b", 2.25)]
    println("total = {total(items):.2f}")
    let squares = [x * x for x in 1..6 if x % 2 == 1]
    println("{squares} {fib(10)}")
    var counts: {str: int} = {}
    for w in "a b a c".split_whitespace() {
        counts[w] = counts.get(w, 0) + 1
    }
    println(counts)
}

--- rs -> atf
struct Point {
    x: int,
    y: int
}

enum Shape {
    Circle(float),
    Rect(float, float)
}

fn area(s: Shape) -> float {
    match s {
        Shape.Circle(r) => return 3.14 * r * r
        Shape.Rect(w, h) => return w * h
    }
}

fn gcd(a: int, b: int) -> int {
    if b == 0 {
        return a
    } else {
        return gcd(b, a % b)
    }
}

fn main() {
    let p = Point{ x: 3, y: 4 }
    var v: [int] = []
    for i in (0..5) {
        v.push(i * p.x)
    }
    println("{v} {gcd(48, 18)}")
    println("{area(Shape.Rect(2.0, 3.5)):.2f}")
    var m: {str: int} = {}
    m["a"] = 1
    println("{m["a"] + p.y}")
}

--- atf -> atf
enum Shape {
    Circle(float),
    Rect(float, float)
}

fn area(s: Shape) -> float {
    return match s {
        Shape.Circle(r) => 3.14 * r * r
        Shape.Rect(w, h) => w * h
    }
}

fn main() {
    let shapes = [Shape.Circle(1.0), Shape.Rect(2.0, 3.0)]
    var total = 0.0
    for s in shapes {
        total += area(s)
    }
    println("total = {total:.2f}")
}

--- atf -> py
from __future__ import annotations
from dataclasses import dataclass


class Shape:
    pass


@dataclass
class Circle(Shape):
    f0: float


@dataclass
class Rect(Shape):
    f0: float
    f1: float


def area(s: Shape) -> float:
    match s:
        case Circle(r):
            return 3.14 * r * r
        case Rect(w, h):
            return w * h


def main():
    shapes = [Circle(1.0), Rect(2.0, 3.0)]
    total = 0.0
    for s in shapes:
        total += area(s)
    print(f"total = {total:.2f}")


if __name__ == "__main__":
    main()

--- atf -> rs
#[derive(Debug, Clone, PartialEq)]
enum Shape {
    Circle(f64),
    Rect(f64, f64),
}

fn area(s: &Shape) -> f64 {
    return match s {
        Shape::Circle(r) => 3.14 * r * r,
        Shape::Rect(w, h) => w * h,
    };
}

fn main() {
    let shapes = vec![Shape::Circle(1.0), Shape::Rect(2.0, 3.0)];
    let mut total = 0.0;
    for s in &shapes {
        total += area(&s);
    }
    println!("total = {:.2}", total);
}

