// global variable / constant initialization order: declarations may appear in any order
const C3 = C2 * 2
const C2 = C1 + 1
const C1 = 10
const NAME = "glob" + "al"
const FL = 1.5 * 2.0
const NEG = -C1
const BIG = 1 << 40
const MASK = BIG - 1
const T = true and not false
const S2 = NAME + "!"

var g_later_user = g_base + 1
var g_base = 100
var g_list = [C1, C2, C3]
var g_map = {"a": C1}
var g_calls = 0
var g_from_fn = compute(5)
var g_str = NAME.upper()
var g_counter = 0

fn compute(x: int) -> int {
    g_calls += 1
    return x * C3
}

fn bump() -> int {
    g_counter += 1
    return g_counter
}

struct Cfg { level: int, name: str }
var g_cfg = Cfg(C2, NAME)

fn main() {
    println(C1, C2, C3, NAME, FL, NEG, BIG, MASK, T, S2)
    println(g_base, g_later_user, g_list, g_map, g_from_fn, g_calls, g_str, g_cfg)
    println(bump(), bump(), g_counter)
    g_list.push(99)
    g_map["b"] = 2
    g_cfg.level += 1
    println(g_list, g_map, g_cfg)
}
