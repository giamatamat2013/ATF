// integer overflow / wrapping, division and modulo with negatives, shifts, powers
fn id(x: int) -> int { return x }

fn main() {
    let mx = INT_MAX
    let mn = INT_MIN
    println(mx, mn)
    println(mx + 1, mn - 1, mx * 2, mn * -1, -mn, mn / 1)
    println(id(mx) + id(1), id(mn) - id(1), id(mx) * id(mx), id(mn) * id(mn))
    println(3037000500 * 3037000500)
    println(id(3037000500) * id(3037000500))
    // compile-time constant folding must wrap the same way as runtime arithmetic
    println(9223372036854775807 + 1)
    println(-9223372036854775807 - 2)
    println(0x7FFFFFFFFFFFFFFF * 3)
    println(0xFFFFFFFFFFFFFFFF)
    println(0x8000000000000000)
    // truncating division and remainder with the sign of the dividend
    println(7 / 2, -7 / 2, 7 / -2, -7 / -2)
    println(7 % 3, -7 % 3, 7 % -3, -7 % -3)
    println(id(7) / id(2), id(-7) / id(2), id(7) / id(-2), id(-7) / id(-2))
    println(id(7) % id(3), id(-7) % id(3), id(7) % id(-3), id(-7) % id(-3))
    // (INT_MIN / -1 at run time is tested separately in bug_intmin_div.atf)
    println(mn % 1, mn / 1)
    println(id(0) / id(5), id(0) % id(-5), id(5) % id(5), id(-5) % id(5))
    // powers of two division must not be optimised into wrong shifts
    for x in [-9, -8, -7, -1, 0, 1, 7, 8, 9] {
        print(x / 4, x % 4, x / 8, x % 8, x / 2, x % 2, "| ")
    }
    println()
    for x in [-9, -8, -7, -1, 0, 1, 7, 8, 9] {
        print(x / -4, x % -4, x / 1, x % 1, "| ")
    }
    println()
    // shifts
    println(1 << 62, 1 << 63, 1 << 0, -1 << 1)
    println(-16 >> 2, -1 >> 63, -1 >>> 63, -1 >>> 1, 16 >>> 2)
    println(mn >> 63, mn >>> 63, mn >> 1, mn >>> 1)
    let s = id(3)
    println(1 << s, 256 >> s, -256 >> s, -256 >>> s)
    // bit operations
    println(5 & 3, 5 | 3, 5 ^ 3, ~5, ~0, ~mn, -1 & mx, mn | 1)
    println(0b1010 ^ 0b0110, 0o777, 0xdead_beef, 1_000_000_000_000)
    // powers
    println(2 ** 10, 2 ** 62, 2 ** 63, 2 ** 64, 3 ** 40, (-2) ** 63, (-3) ** 3, 0 ** 0, 1 ** 1000000)
    println(id(2) ** id(10), id(-2) ** id(3), id(7) ** id(0))
    println(-2 ** 2, 2 ** 3 ** 2, (2 ** 3) ** 2)
    // compound assignment operators
    var v = 100
    v += 5
    v -= 10
    v *= -3
    v /= 7
    v %= 30
    println(v)
    v = 6
    v <<= 4
    v >>= 1
    v |= 1
    v &= 0xF1
    v ^= 0xFF
    v **= 2
    println(v)
    // int methods
    println((-5).abs(), mn.abs(), 2.pow(16), 10.min(3), 10.max(30), 15.clamp(0, 10), (-7).sign(), 0.sign())
    println(255.to_hex(), (-255).to_hex(), 5.to_bin(), 0.to_bin(), mx.to_hex(), mn.to_hex())
    println(7.popcount(), (-1).popcount(), mn.popcount(), 4.is_even(), (-3).is_odd(), (-4).is_odd())
    println(gcd(12, 18), gcd(-12, 18), gcd(0, 0), gcd(0, 7), gcd(17, 5))
    println(abs(-3), min(3, -4), max(-1, -2), clamp(5, 6, 9), sign(-12))
}
