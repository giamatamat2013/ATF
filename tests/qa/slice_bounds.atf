// slicing with out-of-range bounds must panic with a clear message (indexing out of range panics too)
fn show(what: str, m: str?) {
    println(what + ":", m ?? "<no panic>")
}

fn main() {
    let a = [1, 2, 3, 4, 5]
    let s = "hello"
    var lo = 2
    var hi = 10
    var neg = -1
    show("arr ok", catch_panic(|| { println(a[1..3], a[0..5], a[5..5], a[..0]) }))
    show("arr hi past end", catch_panic(|| { println(a[lo..hi]) }))
    show("arr lo past end", catch_panic(|| { println(a[hi..]) }))
    show("arr lo > hi", catch_panic(|| { println(a[4..lo]) }))
    show("arr negative lo", catch_panic(|| { println(a[neg..3]) }))
    show("arr negative hi", catch_panic(|| { println(a[0..neg]) }))
    show("str ok", catch_panic(|| { println(s[1..3], s[0..5], s[5..5], s[..0]) }))
    show("str hi past end", catch_panic(|| { println(s[lo..hi]) }))
    show("str lo past end", catch_panic(|| { println(s[hi..]) }))
    show("str lo > hi", catch_panic(|| { println(s[4..lo]) }))
    show("str negative lo", catch_panic(|| { println(s[neg..3]) }))
    show("str negative hi", catch_panic(|| { println(s[0..neg]) }))
    show("substr", catch_panic(|| { println(s.substr(3, 10)) }))
    show("substr neg count", catch_panic(|| { println(s.substr(3, -2)) }))
}
