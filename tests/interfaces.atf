interface Shape {
    fn area(self) -> float
    fn name(self) -> str
}

struct Circle { r: float }
impl Circle {
    fn area(self) -> float { return 3.14159 * self.r * self.r }
    fn name(self) -> str { return "circle" }
}

struct Rect { w: float, h: float }
impl Rect {
    fn area(self) -> float { return self.w * self.h }
    fn name(self) -> str { return "rect {self.w}x{self.h}" }
}

interface Describable {
    fn to_str(self) -> str
}

impl int {
    fn name(self) -> str { return "int {self}" }
    fn area(self) -> float { return float(self) }
}

fn total(shapes: [Shape]) -> float {
    var t = 0.0
    for s in shapes { t += s.area() }
    return t
}

fn main() {
    let shapes: [Shape] = [Circle(1.0), Rect(2.0, 3.0), 7]
    for s in shapes { println(s.name(), s.area()) }
    println(total(shapes))
    let d: Describable = Circle(2.0)
    println(d)
    let s: Shape = Rect(1.0, 1.0)
    println(s == s, s)
}
