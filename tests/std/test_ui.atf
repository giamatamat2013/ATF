    ui_keypress("ctrl+home")
    ui_keypress("shift+down")
    ui_keypress("shift+down")
    state("selected")
    ui_keypress("delete")
    state("deleted")
    ui_keypress("ctrl+z")
    state("undo")
    ui_keypress("tab")
    state("tab inserts spaces")
    ui_click(60, 90)
    ui_click(60, 90)
    state("double click picks a word")
    ui_click(15, 62)
    ui_click(15, 62)
    ui_click(15, 62)
    state("triple click picks the line")
}

fn layers() {
    println("layers")
    ui_headless(app, 400, 520)
    log = ""
    println(ui_click_text("File"), ui_open.len(), ui_overlays.len())
    println(ui_click_text("New"), ui_open.len(), log)
    ui_click_text("File")
    ui_keypress("esc")
    println("esc closes the menu", ui_open.len())
    ui_click_text("File")
    ui_click(380, 500)
    println("a click outside closes it", ui_open.len(), log)
    ui_click_text("b")
    println("select open", ui_open.len())
    ui_click_text("c")
    println("select picked", choice, ui_open.len())
    ui_click_text("Two")
    println("tab", tabsel)
    ui_click(15, 330)
    println("canvas pointer", ptr)
    ui_mouse_move(20, 240)
    println("tooltip shown", ui_overlays.len())
    ui_mouse_move(300, 5)
    println("tooltip gone", ui_overlays.len())
    ui_click_text("Details")
    println("dialog", showing, ui_overlays.len())
    ui_click(5, 5)
    println("dialog closed by the backdrop", showing)
    ui_click_text("Details")
    ui_keypress("esc")
    println("dialog closed by Esc", showing)
    ui_click_text("Details")
    ui_click_text("Close")
    println("dialog closed by its button", showing)
}

fn canvas_pixels() {
    println("canvas")
    ui_headless(app, 400, 520)
    let pic = render(app, 400, 520)
    // the canvas starts at (10, 323)
    println(px(pic, 400, 520, 20, 330), px(pic, 400, 520, 70, 330), px(pic, 400, 520, 90, 343), px(pic, 400, 520, 150, 343))
}

fn pixel_view() -> Node {
    // a 2 x 2 picture stretched over 40 x 40 pixels: red, green / blue, white
    let pic = [0xFF0000, 0x00FF00, 0x0000FF, 0xFFFFFF]
    return canvas(|c| { c.pixels(0, 0, 40, 40, pic, 2, 2) }).size(40, 40)
}

fn smooth_view() -> Node {
    // the same 2 x 2 picture, scaled smoothly
    let pic = [0xFF0000, 0x00FF00, 0x0000FF, 0xFFFFFF]
    return canvas(|c| { c.pixels_smooth(0, 0, 40, 40, pic, 2, 2) }).size(40, 40)
}

fn game_input() {
    println("pixels and mouse look")
    let pic = render(pixel_view, 40, 40)
    println(px(pic, 40, 40, 5, 5), px(pic, 40, 40, 35, 5), px(pic, 40, 40, 5, 35), px(pic, 40, 40, 35, 35))
    // smooth: the corners keep their color, the points between them are mixed
    let sm = render(smooth_view, 40, 40)
    println(px(sm, 40, 40, 0, 0), px(sm, 40, 40, 39, 0), px(sm, 40, 40, 0, 39), px(sm, 40, 40, 39, 39))
    println(px(sm, 40, 40, 20, 0), px(sm, 40, 40, 0, 20), px(sm, 40, 40, 20, 20))
    // without a window nothing is held down and the mouse does not move
    ui_mouse_capture(true)
    let (dx, dy) = ui_mouse_delta()
    println(dx, dy, ui_key_down("w"), ui_mouse_held(0))
    ui_mouse_capture(false)
}

fn shortcuts_and_dialogs() {
    println("shortcuts and dialogs")
    ui_headless(app, 400, 520)
    log = ""
    ui_shortcut("ctrl+s", || { log = log + "save " })
    ui_shortcut("Ctrl+S", || { log = log + "save2 " })
    ui_shortcut("f5", || { log = log + "run " })
    ui_shortcut("delete", || { log = log + "del " })
    ui_keypress("ctrl+s")
    ui_keypress("f5")
    ui_keypress("delete")
    ui_click(30, 25)
    ui_keypress("delete")
    println(log, ui_keypress("nonsense"))
    ui_answers(false, "")
    println(confirm_box("Quit", "Sure?"), ui_last_dialog(), open_file_dialog() == nil)
    ui_answers(true, "C:\\x\\y.txt")
    println(confirm_box("Quit", "Sure?"), open_file_dialog()!, save_file_dialog("Save", "Text|*.txt", "txt")!)
    clipboard_set("copied")
    println(clipboard_get())
}

fn main() {
    colors()
    layout()
    styles()
    typing()
    area()
    layers()
    canvas_pixels()
    game_input()
    shortcuts_and_dialogs()
    delete_file(SHOT)
}
