// tests for std/yaml
import "std/yaml"
import "std/json"

var failures = 0

fn check(label: str, got: str, want: str) {
    if got == want {
        println("ok   {label}: {got}")
    } else {
        failures += 1
        println("FAIL {label}: got {got}, want {want}")
    }
}

// the document as JSON text, or the error
fn as_json(text: str) -> str {
    return match yaml_parse(text) {
        Result.Ok(v) => json_stringify(v)
        Result.Err(e) => "Err(" + e + ")"
    }
}

fn main() -> int {
    check("map", as_json("a: 1\nb: two\n"), "\{\"a\":1,\"b\":\"two\"}")
    check("nested", as_json("x:\n  y:\n    z: true\n"), "\{\"x\":\{\"y\":\{\"z\":true}}}")
    check("sequence", as_json("- 1\n- 2.5\n- null\n"), "[1,2.5,null]")
    check("sequence of maps", as_json("- a: 1\n  b: 2\n- a: 3\n"), "[\{\"a\":1,\"b\":2},\{\"a\":3}]")
    check("sequence under key", as_json("k:\n- x\n- y\n"), "\{\"k\":[\"x\",\"y\"]}")
    check("flow", as_json("v: [1, \{x: y}, \"q, r\"]\n"), "\{\"v\":[1,\{\"x\":\"y\"},\"q, r\"]}")
    check("empty flow", as_json("e: []\nf: \{}\n"), "\{\"e\":[],\"f\":\{}}")
    check("single quotes", as_json("t: 'it''s'\n"), "\{\"t\":\"it's\"}")
    check("comments", as_json("# top\na: 1 # one\n\nb: 2\n"), "\{\"a\":1,\"b\":2}")
    check("literal block", as_json("t: |\n  a\n  b\n"), "\{\"t\":\"a\\nb\\n\"}")
    check("folded block", as_json("t: >-\n  a\n  b\n"), "\{\"t\":\"a b\"}")
    check("numbers and words", as_json("i: 42\nf: 1.5\nn: -3\ns: yes\n"), "\{\"i\":42,\"f\":1.5,\"n\":-3,\"s\":\"yes\"}")
    check("document marker", as_json("---\na: 1\n"), "\{\"a\":1}")
    check("empty text", as_json(""), "null")
    check("bad line", as_json("a: 1\nnonsense\n"), "Err(line 2: expected 'key: value')")

    let doc = "name: app\nhosts:\n  - a\n  - b\nusers:\n  - name: ada\n    roles: [admin, dev]\n"
    let back = yaml_parse(yaml_stringify(yaml_parse(doc).unwrap()))
    check("round trip", json_stringify(back.unwrap()), as_json(doc))

    check("write string", yaml_stringify(json_str("a: b")), "\"a: b\"\n")
    check("write number-like string", yaml_stringify(json_str("42")), "\"42\"\n")
    check("write map", yaml_stringify(json_object_of({"n": json_int(1)})), "n: 1\n")
    check("write empty", yaml_stringify(json_array()), "[]\n")

    println("failures: {failures}")
    return failures
}
