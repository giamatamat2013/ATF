// tests for std/random (the numbers are random, so only properties are checked)
import "std/random"

fn main() {
    rand_seed(7)
    var ok = true
    for i in 0..500 {
        let a = random_range(3, 10)
        let b = random_range(0, 100, 5)
        let c = random_range(10, 0, -3)
        if a < 3 or a >= 10 { ok = false }
        if b < 0 or b >= 100 or b % 5 != 0 { ok = false }
        if c > 10 or c <= 0 or (10 - c) % 3 != 0 { ok = false }
    }
    println("random_range:", ok)

    let pool = [1, 2, 3, 4, 5, 6]
    var sample_ok = true
    for i in 0..200 {
        let s = random_sample(pool, 4)
        if s.len() != 4 or s.unique().len() != 4 { sample_ok = false }
        for x in s { if not (x in pool) { sample_ok = false } }
    }
    println("random_sample:", sample_ok, random_sample(pool, 0), random_sample(pool, 6).sorted(), pool)

    let ch = random_choices(["a", "b"], 50)
    println("random_choices:", ch.len(), ch.all(|x| x == "a" or x == "b"))

    var heavy = 0
    for i in 0..1000 { if random_weighted(["rare", "common"], [1.0, 9.0]) == "common" { heavy += 1 } }
    println("random_weighted:", heavy > 800, heavy < 980, random_weighted(["only", "never"], [1.0, 0.0]))

    var total = 0.0
    var inside = 0
    for i in 0..2000 {
        let g = random_gauss(100.0, 15.0)
        total += g
        if g > 70.0 and g < 130.0 { inside += 1 }
    }
    println("random_gauss:", abs(total / 2000.0 - 100.0) < 3.0, inside > 1800)

    println("random_bool:", random_bool(1.0), random_bool(0.0))
    println("random_shuffled:", random_shuffled(pool).sorted() == pool, pool)

    let s = random_string(12)
    println("random_string:", s.len(), text_ok(s), random_string(5, "x"), random_string(0))
    let h = random_hex(8)
    println("random_hex:", h.len(), h.lower() == h, random_hex(0).len())

    var uuid_ok = true
    for i in 0..50 {
        let u = random_uuid()
        if u.len() != 36 or u[8..9] != "-" or u[13..14] != "-" or u[18..19] != "-" or u[23..24] != "-" { uuid_ok = false }
        if u[14..15] != "4" or not ("89ab".contains(u[19..20])) { uuid_ok = false }
    }
    println("random_uuid:", uuid_ok, random_uuid() != random_uuid())

    rand_seed(99)
    let first = random_string(10)
    rand_seed(99)
    println("repeatable:", first == random_string(10))

    println(catch_panic(|| { random_range(5, 5) }))
    println(catch_panic(|| { random_range(0, 5, 0) }))
    println(catch_panic(|| { random_sample([1, 2], 3) }))
}

fn text_ok(s: str) -> bool {
    for i in 0..s.len() {
        let c = s.byte_at(i)
        if not (c.is_alpha() or c.is_digit()) { return false }
    }
    return true
}
