// tests for std/zlib
import "std/zlib"
import "std/hex"
import "std/hash"

const V_Z9 = ""
const V_Z1 = ""
const V_Z0 = ""
const V_RAW = ""
const V_GZ = ""
const V_EMPTY = "78da030000000001"
const V_DYN = ""
const V_DYN_LEN = 2768
const V_DYN_CRC = 3219460373

var failures = 0

fn check(label: str, ok: bool) {
    if ok {
        println("ok   {label}")
    } else {
        failures += 1
        println("FAIL {label}")
    }
}

fn err_text(r: Result<str, str>) -> str {
    return match r {
        Result.Ok(v) => "(no error)"
        Result.Err(e) => e
    }
}

// the text that the Python vectors were made from
fn sample() -> str {
    var sb = str_builder()
    sb.add("The quick brown fox jumps over the lazy dog. ".repeat(6))
    sb.add("Pack my box with five dozen liquor jugs! 0123456789 ".repeat(3))
    for i in 0..256 { sb.add_byte(byte(i)) }
    return sb.finish()
}

fn unhex(h: str) -> str {
    return hex_decode(h).unwrap()
}

// repeatable pseudo-random bytes
fn noise(n: int, seed: int) -> str {
    var sb = str_builder()
    var x = seed
    for i in 0..n {
        x = (x * 1103515245 + 12345) & 0x7FFFFFFF
        sb.add_byte(byte((x >> 16) & 255))
    }
    return sb.finish()
}

fn is_text(r: Result<str, str>, want: str) -> bool {
    return r.is_ok() and r.unwrap() == want
}

fn roundtrip(label: str, data: str, level: int) {
    check("zlib {label} level {level}", is_text(zlib_decompress(zlib_compress(data, level)), data))
    check("gzip {label} level {level}", is_text(gzip_decompress(gzip_compress(data, level)), data))
    check("raw  {label} level {level}", is_text(zlib_inflate_raw(zlib_deflate_raw(data, level)), data))
}

fn main() -> int {
    let s = sample()

    // streams made by Python's zlib: fixed Huffman (levels 9 and 1), stored, raw, gzip, empty, dynamic Huffman
    check("python level 9", is_text(zlib_decompress(unhex(V_Z9)), s))
    check("python level 1", is_text(zlib_decompress(unhex(V_Z1)), s))
    check("python stored", is_text(zlib_decompress(unhex(V_Z0)), s))
    check("python raw deflate", is_text(zlib_inflate_raw(unhex(V_RAW)), s))
    check("python gzip", is_text(gzip_decompress(unhex(V_GZ)), s))
    check("python empty", is_text(zlib_decompress(unhex(V_EMPTY)), ""))
    let dyn = zlib_decompress(unhex(V_DYN))
    check("python dynamic Huffman", dyn.is_ok() and dyn.unwrap().len() == V_DYN_LEN and hash_crc32(dyn.unwrap()) == V_DYN_CRC)

    // damaged data is reported, never a crash
    let z9 = unhex(V_Z9)
    check("truncated", zlib_decompress(z9.substr(0, z9.len() - 10)).is_err())
    check("only the header", zlib_decompress(z9.substr(0, 2)).is_err())
    let bad_sum = z9.substr(0, z9.len() - 1) + "\x00"
    check("bad checksum", err_text(zlib_decompress(bad_sum)).contains("checksum"))
    check("not zlib", zlib_decompress("hello world, this is not compressed").is_err())
    check("empty input", zlib_decompress("").is_err())
    check("not gzip", gzip_decompress("hello world, this is not compressed").is_err())
    let gz = unhex(V_GZ)
    check("gzip bad crc", err_text(gzip_decompress(gz.substr(0, gz.len() - 8) + "\x00\x00\x00\x00" + gz.substr(gz.len() - 4, 4))).contains("checksum"))
    check("gzip truncated", gzip_decompress(gz.substr(0, gz.len() - 12)).is_err())
    check("bad block type", zlib_inflate_raw("\x07\x00\x00").is_err())
    check("bad stored length", zlib_inflate_raw("\x01\x05\x00\x00\x00abcde").is_err())
    check("stored block", is_text(zlib_inflate_raw("\x01\x05\x00\xfa\xffhello"), "hello"))
    var damaged = 0
    for i in 2..z9.len() - 4 {
        // flipping any one byte must give an error or a different text, and must not crash
        let broken = z9.substr(0, i) + char_str(byte(255 - int(z9.byte_at(i)))) + z9.substr(i + 1, z9.len() - i - 1)
        let r = zlib_decompress(broken)
        if r.is_err() or r.unwrap() != s { damaged += 1 }
    }
    check("every damaged byte is noticed", damaged == z9.len() - 6)

    // our own compressor and decompressor
    let sizes = [0, 1, 2, 3, 100, 1000]
    for n in sizes {
        for level in [0, 1, 6, 9] { roundtrip("noise {n}", noise(n, n + 1), level) }
    }
    for level in [0, 1, 6, 9] {
        roundtrip("text", s, level)
        roundtrip("zeros", "\x00".repeat(70000), level)
        roundtrip("long run", "a".repeat(100000), level)
        roundtrip("period 3", "abc".repeat(40000), level)
        roundtrip("noise 200000", noise(200000, 99), level)
    }
    var mix = str_builder()
    for i in 0..300 {
        mix.add(noise(50, i))
        mix.add("a repeated phrase, a repeated phrase ".repeat(i % 7))
    }
    roundtrip("mixed", mix.finish(), 6)

    let rep = "a".repeat(100000)
    check("repetitive data gets small", zlib_compress(rep).len() < 1000)
    check("repetitive text gets smaller", zlib_compress(s).len() < s.len())
    let nz = noise(200000, 5)
    check("noise stays nearly the same size", zlib_compress(nz).len() <= nz.len() + 5 * (nz.len() / 65535 + 1) + 6)
    check("level 0 stores", zlib_compress("hello", 0).len() == 5 + 11)
    check("zlib header", zlib_compress("x").byte_at(0) == byte(0x78))

    if failures == 0 {
        println("all zlib tests passed")
        return 0
    }
    println("{failures} zlib tests FAILED")
    return 1
}
