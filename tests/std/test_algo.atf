// tests for std/algo
import "std/algo"

fn main() {
    let s = [1, 3, 3, 5, 8]
    println(algo_lower_bound(s, 3), algo_upper_bound(s, 3), algo_lower_bound(s, 0), algo_lower_bound(s, 9), algo_upper_bound(s, 8))
    println(algo_binary_search(s, 5), algo_binary_search(s, 4), algo_binary_search([] as [int], 1))
    println(algo_lower_bound(["a", "c", "e"], "d"))

    println(algo_prefix_sums([1, 2, 3, 4]), algo_differences([1, 4, 9, 16]), algo_iota(4), algo_iota(3, 10))
    println(algo_dot([1, 2, 3], [4, 5, 6]))

    let r = [1, 2, 3, 4, 5]
    algo_rotate(r, 2)
    println(r)
    algo_rotate(r, -1)
    println(r)
    algo_rotate(r, 10)
    println(r)

    let p = [1, 2, 3]
    var seen = 1
    while algo_next_permutation(p) { seen += 1 }
    println(seen, p)
    let q = [1, 1, 2]
    var all: [[int]] = [q.copy()]
    while algo_next_permutation(q) { all.push(q.copy()) }
    println(all)

    println(algo_permutations([1, 2, 3]))
    println(algo_permutations(["x"]).len(), algo_permutations([] as [int]).len())
    println(algo_combinations([1, 2, 3, 4], 2))
    println(algo_combinations([1, 2, 3], 0), algo_combinations([1, 2, 3], 4))
    println(algo_product([1, 2], ["a", "b"]))
    println(algo_subsets([1, 2, 3]))
    println(algo_pairwise([1, 2, 3, 4]), algo_cycle([1, 2, 3], 7))

    println(algo_flatten([[1, 2], [3], []]), algo_flat_map(["ab", "c"], |w| w.chars()))
    println(algo_group_by(["ant", "bee", "ape", "cow", "bat"], |w| w[0..1]))
    println(algo_count_by([1, 2, 3, 4, 5, 6, 7], |n| n % 3))
    println(algo_key_by(["ant", "bee", "ape"], |w| w[0..1]))
    println(algo_unique_by(["ant", "bee", "ape", "bat"], |w| w[0..1]))
    println(algo_take_while([1, 2, 5, 1], |x| x < 3), algo_drop_while([1, 2, 5, 1], |x| x < 3))
    println(algo_find_index([4, 5, 6], |x| x > 4), algo_find_index([4, 5, 6], |x| x > 9))
    println(algo_argmin([3, 1, 2, 1]), algo_argmax([3, 9, 2, 9]), algo_argmax(["b", "z", "a"]))
    println(algo_zip3([1, 2, 3], ["a", "b"], [true, false, true]))
    println(algo_split_at([1, 2, 3, 4], 1), algo_split_at([1, 2], 5))

    println(algo_union([1, 2, 2, 3], [3, 4]), algo_intersection([1, 2, 2, 3], [2, 3, 5]), algo_difference([1, 2, 2, 3], [2]))
    println(catch_panic(|| { algo_argmin([] as [int]) }))
}
