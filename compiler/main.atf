// ATF compiler driver (self-hosted):  atf run|build|check file.atf
import "util"
import "lexer"
import "ast"
import "parser"
import "types"
import "tir"
import "checker"
import "check_expr"
import "check_expr2"
import "check_call"
import "check_stmt"
import "synth"
import "x64"
import "pe"
import "codegen"
import "interpreter"
import "opt"
import "repl"
import "fmt"
import "cli"

const VERSION = "1.2.0 (self-hosted)"
const PRELUDE_SRC = include_str("../atf/stdlib/prelude.atf")
const PRELUDE_NAME = "<std>/prelude.atf"

const USAGE = """ATF {VERSION} - a small, fast, compiled programming language

usage:
  atf run   file.atf [args...]     compile and run
  atf shell                         interactive command line for ATF commands
  atf interpret file.atf            interpret a program; use native backend when needed
  atf build file.atf [-o out.exe]  compile to a native executable
  atf check file.atf               check for errors only
  atf repl                         interactive mode
  atf fmt file.atf [--check]       re-indent source files
  atf test [folder|file ...]       run test_*.atf / *_test.atf (and compare with a .out file)
  atf new name                     start a project folder (main.atf, test_main.atf)
  atf doc file.atf [-o out.md]     Markdown documentation from the doc comments
  atf watch file.atf [args...]     run again whenever the file or its imports change
  atf version
"""

struct Module {
    items: [Item],
    prelude: bool
}

var loaded: {str: bool} = {}
var modules: [Module] = []

// the standard library modules (import "std/name") live in  <install dir>/stdlib
fn std_dir() -> str {
    let here = path_dir(exe_path())
    let beside = here + "/stdlib"
    if file_exists(beside + "/std.atf") { return beside }
    return norm_path(here + "/../stdlib")
}

// resolve an import name relative to the importing file
fn resolve_import(name: str, from_file: str) -> str {
    var n = name
    if not n.ends_with(".atf") { n = n + ".atf" }
    if n.starts_with("std/") { return std_dir() + "/" + n[4..] }
    let p = norm_path(path_dir(from_file) + "/" + n)
    if file_exists(p) { return p }
    let p2 = std_dir() + "/" + n
    if file_exists(p2) { return p2 }
    return p
}

fn load_module(path: str, prelude: bool, src_text: str?, from_pos: Pos) {
    if path in loaded { return }
    loaded[path] = true
    var text = ""
    if src_text != nil {
        text = src_text!
    } else {
        let data = read_file(path)
        if data == nil { fail(from_pos, "cannot find file '{path}'") }
        text = data!
    }
    if text.starts_with("\u{FEFF}") { text = text[3..] }
    text = text.replace("\r\n", "\n")
    sources[path] = text
    let items = parse_source(text, path)
    for it in items {
        match it {
            Item.Import(d) => {
                let ip = resolve_import(d.path, path)
                if not file_exists(ip) {
                    fail(d.pos, "cannot find module '{d.path}'",
                         "imports are relative to this file, or  import \"std/name\"  for the standard library")
                }
                load_module(ip, prelude or ip.starts_with(std_dir()), nil, d.pos)
            }
            _ => {}
        }
    }
    modules.push(Module(items, prelude))
}

// "1.2.3" -> 1002003, so that versions compare as numbers; 0 when v is not three numbers
fn version_value(v: str) -> int {
    let parts = v.split(" ")[0].split(".")
    if parts.len() != 3 { return 0 }
    var n = 0
    for p in parts {
        if not p.isdigit() { return 0 }
        n = n * 1000 + p.to_int()
    }
    return n
}

// a program written for a newer ATF may not compile here: say so, but compile it anyway
fn warn_if_newer(path: str) {
    let want = declared_version.get(path, "")
    let here = VERSION.split(" ")[0]
    if want != "" and version_value(want) > version_value(here) {
        eprintln("warning: this file was written for ATF {want}, but this compiler is ATF {here}; it may not compile")
    }
}

// compile a program file; returns the executable's bytes or nil (errors are in diags)
fn compile_file(path: str, check_only: bool) -> Bytes? {
    var exe: Bytes? = nil
    let ok = guarded(|| {
        load_module(PRELUDE_NAME, true, PRELUDE_SRC, NOPOS)
        load_module(path, false, nil, NOPOS)
        warn_if_newer(path)
        var ms: [([Item], bool)] = []
        for m in modules { ms.push((m.items, m.prelude)) }
        let prog = check_program(ms)
        if prog != nil and not check_only {
            if getenv("ATF_NOOPT") == nil { optimize_program(prog!) }
            exe = generate_exe(prog!)
        }
    })
    if not ok or diags.len() > 0 {
        eprintln(render_diags())
        return nil
    }
    if check_only { return Bytes([]) }
    return exe
}

fn exe_path_for(path: str, out: str?) -> str {
    if out != nil { return out! }
    var base = path
    let dot = base.rfind(".")
    if dot > 0 and dot > base.rfind("/") and dot > base.rfind("\\") { base = base[..dot] }
    return base + ".exe"
}

fn run_compiled_bytes(path: str, exe: Bytes, args: [str]) -> int {
    let dir = temp_dir() + "atf"
    make_dir(dir)
    var name = path
    let slash = name.rfind("/")
    let bslash = name.rfind("\\")
    if bslash > slash { name = name[bslash + 1..] } else if slash >= 0 { name = name[slash + 1..] }
    let tmp = "{dir}\\{name}-{int_to_hex(str_hash(path) & 0xFFFFFFFF)}.exe"
    if not write_file(tmp, exe.to_str()) {
        eprintln("error: cannot write {tmp}")
        return 1
    }
    return run_process(tmp, args)
}

extern "kernel32" fn SetConsoleCtrlHandler(handler: int, add: i32) -> i32

var shell_ctrl_c_pending: bool

fn shell_ctrl_handler(code: int) -> int {
    if code == 0 {
        shell_ctrl_c_pending = true
        return 1
    }
    return 0
}

fn shell_set_ctrl_handler(add: bool) {
    let handler = shell_ctrl_handler
    SetConsoleCtrlHandler((handler as ptr<int>)[0], if add { 1 } else { 0 })
}

fn shell_is_cli_command(command: str) -> bool {
    for name in ["run", "build", "check", "repl", "interpret", "fmt", "test", "new", "doc", "watch", "version"] {
        if command == name or command.starts_with(name + " ") { return true }
    }
    return false
}

fn run_shell() -> int {
    println("ATF {VERSION} command line. Enter ATF code or a compiler command; type exit to quit.")
    println("Commands include run, build, check, repl, interpret, fmt, test, new, doc, watch, and version.")
    let repl = repl_new()
    shell_ctrl_c_pending = false
    shell_set_ctrl_handler(true)
    loop {
        print("ATF> ")
        flush()
        let line = read_line()
        if shell_ctrl_c_pending {
            shell_ctrl_c_pending = false
            println("[Ctrl+C] stopped; ATF shell is ready")
            continue
        }
        if line == nil { break }
        var command = line!.trim()
        if command == "" { continue }
        if command == "exit" or command == "quit" { break }
        if command == "help" or command == "--help" or command == "-h" {
            print(USAGE)
            continue
        }
        var explicit_cli = false
        if command.starts_with("atf ") {
            command = command[4..].trim_start()
            explicit_cli = true
        }
        if command == "" { print(USAGE); continue }
        if command == "shell" {
            eprintln("already in the ATF command line; type exit to quit")
            continue
        }
        if explicit_cli or shell_is_cli_command(command) {
            run_command(quote_arg(exe_path()) + " " + command)
        } else if repl_input(repl, command) {
            break
        }
        if shell_ctrl_c_pending {
            shell_ctrl_c_pending = false
            println("[Ctrl+C] stopped; ATF shell is ready")
        }
    }
    repl_cleanup(repl)
    shell_set_ctrl_handler(false)
    return 0
}

fn main(args: [str]) -> int {
    if getenv("ATF_PATH_STYLE") == "base" { path_style_base = true }
    if args.len() < 1 or args[0] == "-h" or args[0] == "--help" or args[0] == "help" {
        print(USAGE)
        return 0
    }
    let cmd = args[0]
    if cmd == "shell" { return run_shell() }
    if cmd == "repl" { return run_repl() }
    if cmd == "fmt" { return run_fmt(args[1..]) }
    if cmd == "test" { return run_test_cmd(args[1..]) }
    if cmd == "new" { return run_new_cmd(args[1..]) }
    if cmd == "doc" { return run_doc_cmd(args[1..]) }
    if cmd == "watch" { return run_watch_cmd(args[1..]) }
    if cmd == "interpret" {
        if args.len() < 2 { eprintln("error: missing file name\n\n" + USAGE); return 2 }
        let path = args[1]
        if not file_exists(path) { eprintln("error: file not found: {path}"); return 2 }
        var prog: Program? = nil
        let ok = guarded(|| {
            load_module(PRELUDE_NAME, true, PRELUDE_SRC, NOPOS)
            load_module(path, false, nil, NOPOS)
            warn_if_newer(path)
            var ms: [([Item], bool)] = []
            for m in modules { ms.push((m.items, m.prelude)) }
            prog = check_program(ms)
        })
        if not ok or diags.len() > 0 { eprintln(render_diags()); return 1 }
        if prog == nil { return 1 }
        let result = interp_run(prog!)
        if not result.0 {
            eprintln("note: this program needs native ATF features; using the compiled backend")
            let exe = compile_file(path, false)
            if exe == nil { return 1 }
            return run_compiled_bytes(path, exe!, args[2..])
        }
        print(result.1)
        return 0
    }
    if cmd == "version" {
        println("ATF {VERSION}")
        return 0
    }
    if cmd == "run" or cmd == "build" or cmd == "check" {
        if args.len() < 2 {
            eprintln("error: missing file name\n\n" + USAGE)
            return 2
        }
        let path = args[1]
        if not file_exists(path) {
            eprintln("error: file not found: {path}")
            return 2
        }
        let exe = compile_file(path, cmd == "check")
        if exe == nil { return 1 }
        if cmd == "check" {
            println("ok")
            return 0
        }
        if cmd == "build" {
            var out: str? = nil
            for i in 0..args.len() - 1 {
                if args[i] == "-o" { out = args[i + 1] }
            }
            let target = exe_path_for(path, out)
            if not write_file(target, exe!.to_str()) {
                eprintln("error: cannot write {target}")
                return 1
            }
            println("built {target}")
            return 0
        }
        return run_compiled_bytes(path, exe!, args[2..])
    }
    eprintln("error: unknown command '{cmd}'\n\n" + USAGE)
    return 2
}
