// Automatic imports: a program that uses a name from the standard library (json_parse, ui_run, Node, ...)
// does not need  import "std/json"  at the top. stdlib/index.txt (made by tools/stdlib_index.py) says which
// module defines each name. The scan is lexical: it is cheap, and a name the program defines itself never
// pulls a module in.

fn ai_is_word(b: byte) -> bool {
    return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '_'
}

fn ai_is_start(b: byte) -> bool {
    return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or b == '_'
}

// the name a top-level declaration line defines ("fn foo(", "struct Bar", "extern \"dll\" fn baz("), or ""
fn ai_decl_name(line: str) -> str {
    var s = line
    if s.starts_with("pub ") { s = s[4..] }
    if s.starts_with("extern ") {
        let k = s.find(" fn ")
        if k < 0 { return "" }
        s = s[k + 1..]
    }
    for kw in ["fn ", "struct ", "enum ", "const ", "var ", "let ", "interface ", "type "] {
        if s.starts_with(kw) {
            let rest = s[kw.len()..]
            var j = 0
            while j < rest.len() and ai_is_word(rest.byte_at(j)) { j += 1 }
            return rest[..j]
        }
    }
    return ""
}

// the std module names (without "std/") that the program files in `user` need and do not import yet
fn auto_import_modules(sdir: str, texts: {str: str}, user: [str]) -> [str] {
    var found: [str] = []
    let data = read_file(sdir + "/index.txt")
    if data == nil { return found }
    var idx: {str: str} = {}
    for line in data!.lines() {
        let parts = line.split(" ")
        if parts.len() == 2 { idx[parts[0]] = parts[1] }
    }
    var defined: {str: bool} = {}
    for k, t in texts {
        for line in t.lines() {
            let nm = ai_decl_name(line)
            if nm != "" { defined[nm] = true }
        }
    }
    var picked: {str: bool} = {}
    for p in user {
        let t = texts[p]
        let n = t.len()
        var in_str = false
        var depth = 0
        var i = 0
        while i < n {
            let b = t.byte_at(i)
            if in_str and depth == 0 {
                if b == '\\' { i += 2; continue }
                if b == '"' { in_str = false } else if b == '{' { depth = 1 }
                i += 1
                continue
            }
            if depth > 0 {
                if b == '{' { depth += 1 } else if b == '}' {
                    depth -= 1
                    i += 1
                    continue
                } else if b == '"' {
                    i += 1
                    while i < n and t.byte_at(i) != '"' { i += 1 }
                    i += 1
                    continue
                }
            } else {
                if b == '/' and i + 1 < n and t.byte_at(i + 1) == '/' {
                    while i < n and t.byte_at(i) != '\n' { i += 1 }
                    continue
                }
                if b == '"' {
                    if i + 2 < n and t.byte_at(i + 1) == '"' and t.byte_at(i + 2) == '"' {
                        i += 3
                        while i + 2 < n and not (t.byte_at(i) == '"' and t.byte_at(i + 1) == '"' and t.byte_at(i + 2) == '"') { i += 1 }
                        i += 3
                        continue
                    }
                    in_str = true
                    i += 1
                    continue
                }
            }
            if b == '\'' {
                if i + 2 < n and t.byte_at(i + 2) == '\'' { i += 3; continue }
                if i + 3 < n and t.byte_at(i + 1) == '\\' and t.byte_at(i + 3) == '\'' { i += 4; continue }
            }
            if ai_is_start(b) and (i == 0 or not (ai_is_word(t.byte_at(i - 1)) or t.byte_at(i - 1) == '.')) {
                var j = i
                while j < n and ai_is_word(t.byte_at(j)) { j += 1 }
                let w = t[i..j]
                if w in idx and not (w in defined) {
                    var ok = b >= 'A' and b <= 'Z'
                    if not ok {
                        var k = j
                        while k < n and t.byte_at(k) == ' ' { k += 1 }
                        if k < n and (t.byte_at(k) == '(' or (t.byte_at(k) == ':' and k + 1 < n and t.byte_at(k + 1) == ':')) { ok = true }
                    }
                    let m = idx[w]
                    if ok and not (m in picked) {
                        picked[m] = true
                        found.push(m)
                    }
                }
                i = j
                continue
            }
            i += 1
        }
    }
    return found
}
