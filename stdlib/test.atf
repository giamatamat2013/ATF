// std/test - a small test framework for ATF programs.
//
//   import "std/test"
//
//   fn main() -> int {
//       test("addition", || {
//           expect_eq(1 + 1, 2)
//           expect(2 > 1, "two is bigger")
//       })
//       test("a panic is a failure", || { expect_eq([1, 2][0], 1) })
//       expect_panics("division by zero", || { let z = 0; println(1 / z) })
//       test_property("abs is never negative", any_int(), |n| abs(n) >= 0)   // 100 random values
//       return test_report()          // prints a summary, returns 0 when everything passed (else 1)
//   }
//
// A failed expectation is recorded and the test goes on; a panic inside a test fails that test
// and the next test still runs. Every test prints one line, "ok" or "FAIL" followed by the reasons.

var test_count = 0
var test_failed_count = 0
var test_current_failures: [str] = []

// records a failure for the running test
fn test_fail(msg: str) { test_current_failures.push(msg) }

// Runs f as a test called name and prints "ok   name" or "FAIL name" with the reasons.
fn test(name: str, f: fn()) {
    test_count += 1
    test_current_failures = []
    let p = catch_panic(f)
    if p != nil { test_fail("panic: " + p!) }
    if test_current_failures.len() == 0 {
        println("ok   {name}")
    } else {
        test_failed_count += 1
        println("FAIL {name}")
        for m in test_current_failures { println("       {m}") }
    }
}

// fails the test when cond is false
fn expect(cond: bool, msg: str = "expectation failed") {
    if not cond { test_fail(msg) }
}

// fails the test when got != want, showing both values
fn expect_eq<T>(got: T, want: T) {
    if got != want { test_fail("got {got}, want {want}") }
}

// fails the test when got == other
fn expect_ne<T>(got: T, other: T) {
    if got == other { test_fail("got {got}, expected something else") }
}

// fails the test when two floats differ by more than eps
fn expect_near(got: float, want: float, eps: float = 0.000001) {
    if fabs(got - want) > eps { test_fail("got {got}, want {want} (within {eps})") }
}

// Runs f as a test called name that passes only when f panics.
fn expect_panics(name: str, f: fn()) {
    test_count += 1
    if catch_panic(f) == nil {
        test_failed_count += 1
        println("FAIL {name}")
        println("       expected a panic, but there was none")
    } else {
        println("ok   {name}")
    }
}

// Runs a test called name that makes `runs` random values with make and checks that holds is true
// for every one. The first value that breaks it (holds is false or panics) fails the test and is shown.
//   test_property("reversing twice gives the list back", any_int_list(), |a| a.reversed().reversed() == a)
fn test_property<T>(name: str, make: fn() -> T, holds: fn(T) -> bool, runs: int = 100) {
    test(name, || {
        for i in 0..runs {
            let value = make()
            var ok = false
            let p = catch_panic(|| { ok = holds(value) })
            if p != nil {
                test_fail("run {i + 1}: panic for {value}: {p!}")
                return
            }
            if not ok {
                test_fail("run {i + 1}: not true for {value}")
                return
            }
        }
    })
}

// makes random ints from lo to hi (both included), for test_property
fn any_int(lo: int = -1000, hi: int = 1000) -> fn() -> int {
    return || rand_int(lo, hi)
}

// makes random true / false values, for test_property
fn any_bool() -> fn() -> bool {
    return || rand_int(0, 1) == 1
}

// makes random floats from lo up to hi, for test_property
fn any_float(lo: float = -1000.0, hi: float = 1000.0) -> fn() -> float {
    return || lo + rand_float() * (hi - lo)
}

// makes random text up to max_len letters long, using the letters in `letters`, for test_property
fn any_str(max_len: int = 10, letters: str = "abcdefghijklmnopqrstuvwxyz ") -> fn() -> str {
    return || {
        var sb = str_builder()
        for _ in 0..rand_int(0, max_len) { sb.add(letters[rand_int(0, letters.len() - 1)]) }
        return sb.finish()
    }
}

// makes random int lists up to max_len long, with ints from lo to hi, for test_property
fn any_int_list(max_len: int = 10, lo: int = -100, hi: int = 100) -> fn() -> [int] {
    return || [rand_int(lo, hi) for _ in 0..rand_int(0, max_len)]
}

// makes random values by picking one from the list, for test_property
fn any_of<T>(choices: [T]) -> fn() -> T {
    return || choices[rand_int(0, choices.len() - 1)]
}

// prints how many tests ran and failed; returns 0 when all passed and 1 otherwise (use it as the exit code of main)
fn test_report() -> int {
    if test_failed_count == 0 {
        println("{test_count} tests, all passed")
        return 0
    }
    println("{test_count} tests, {test_failed_count} failed")
    return 1
}
