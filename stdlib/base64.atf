// std/base64 - Base64 encoding and decoding (RFC 4648), standard and URL-safe alphabets.
//
//   import "std/base64"
//   b64_encode("hello")              == "aGVsbG8="
//   b64_decode("aGVsbG8=").unwrap()  == "hello"
//   b64_encode_url("\xfb\xff")       == "-_8"         (URL-safe alphabet, no padding by default)
//
// Text (str) is treated as raw bytes, so binary data round-trips exactly.
// Decoding returns Result<str, str>: Err carries a readable message with the position of the problem.
// Whitespace (spaces, tabs, CR, LF) inside the input is ignored when decoding; padding '=' is optional.

const B64_STD_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const B64_URL_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// encodes the bytes p[0..n] with the given 64-character alphabet
fn b64_encode_raw(p: ptr<byte>, n: int, alphabet: str, pad: bool) -> str {
    let full = n / 3
    let rest = n - full * 3
    var out_len = full * 4
    if rest > 0 {
        if pad { out_len += 4 } else { out_len += rest + 1 }
    }
    let r = str_new(out_len)
    let d = str_data(r)
    let a = str_data(alphabet)
    var o = 0
    var i = 0
    while i + 3 <= n {
        let v = (p[i] << 16) | (p[i + 1] << 8) | p[i + 2]
        d[o] = a[(v >> 18) & 63]
        d[o + 1] = a[(v >> 12) & 63]
        d[o + 2] = a[(v >> 6) & 63]
        d[o + 3] = a[v & 63]
        o += 4
        i += 3
    }
    if rest == 1 {
        let v = p[i] << 16
        d[o] = a[(v >> 18) & 63]
        d[o + 1] = a[(v >> 12) & 63]
        if pad {
            d[o + 2] = '='
            d[o + 3] = '='
        }
    } else if rest == 2 {
        let v = (p[i] << 16) | (p[i + 1] << 8)
        d[o] = a[(v >> 18) & 63]
        d[o + 1] = a[(v >> 12) & 63]
        d[o + 2] = a[(v >> 6) & 63]
        if pad { d[o + 3] = '=' }
    }
    return r
}

// Base64 of the bytes of s (standard alphabet, with '=' padding)
fn b64_encode(s: str) -> str {
    return b64_encode_raw(str_data(s), str_len(s), B64_STD_ALPHABET, true)
}

// Base64 of a byte array (standard alphabet, with '=' padding)
fn b64_encode_bytes(b: [byte]) -> str {
    return b64_encode_raw(b.data, b.len, B64_STD_ALPHABET, true)
}

// URL- and filename-safe Base64 ('-' and '_' instead of '+' and '/'); no padding unless pad is true
fn b64_encode_url(s: str, pad: bool = false) -> str {
    return b64_encode_raw(str_data(s), str_len(s), B64_URL_ALPHABET, pad)
}

// value of one Base64 character, or -1 if it is not part of the alphabet
fn b64_char_value(c: byte, url: bool) -> int {
    if c >= 'A' and c <= 'Z' { return c - 'A' }
    if c >= 'a' and c <= 'z' { return c - 'a' + 26 }
    if c >= '0' and c <= '9' { return c - '0' + 52 }
    if url {
        if c == '-' { return 62 }
        if c == '_' { return 63 }
    } else {
        if c == '+' { return 62 }
        if c == '/' { return 63 }
    }
    return -1
}

fn b64_show_char(c: byte) -> str {
    if c >= 32 and c < 127 { return "'" + char_str(c) + "'" }
    return "byte 0x" + pad_zero(int_to_hex(c), 2)
}

fn b64_decode_impl(s: str, url: bool) -> Result<str, str> {
    let n = str_len(s)
    let p = str_data(s)
    var sb = str_builder()
    var acc = 0
    var bits = 0
    var count = 0          // significant characters seen
    var pads = 0           // '=' characters seen
    var first_pad = -1
    for i in 0..n {
        let c = p[i]
        if c == ' ' or c == 9 or c == 10 or c == 13 { continue }
        if c == '=' {
            if pads == 0 { first_pad = i }
            pads += 1
            continue
        }
        let v = b64_char_value(c, url)
        if v < 0 {
            return Result.Err("invalid base64 character {b64_show_char(c)} at position {i}")
        }
        if pads > 0 {
            return Result.Err("unexpected padding '=' at position {first_pad} (padding may only appear at the end)")
        }
        acc = (acc << 6) | v
        bits += 6
        count += 1
        if bits >= 8 {
            bits -= 8
            sb.add_byte(byte((acc >> bits) & 255))
        }
    }
    let rem = count % 4
    if rem == 1 {
        return Result.Err("invalid base64 length: {count} data characters (a group cannot have just one character)")
    }
    if pads > 0 {
        if (count + pads) % 4 != 0 or pads > 2 {
            return Result.Err("wrong amount of padding: {pads} '=' after {count} data characters")
        }
    }
    // the unused low bits of the last character must be zero (canonical encoding)
    if bits > 0 and (acc & ((1 << bits) - 1)) != 0 {
        return Result.Err("invalid base64: the last character has non-zero unused bits")
    }
    return Result.Ok(sb.finish())
}

// decodes standard Base64 ('+' '/'); returns the decoded bytes as text
fn b64_decode(s: str) -> Result<str, str> {
    return b64_decode_impl(s, false)
}

// decodes URL-safe Base64 ('-' '_')
fn b64_decode_url(s: str) -> Result<str, str> {
    return b64_decode_impl(s, true)
}

// decodes standard Base64 into a byte array
fn b64_decode_bytes(s: str) -> Result<[byte], str> {
    match b64_decode_impl(s, false) {
        Result.Ok(t) => return Result.Ok(t.bytes())
        Result.Err(e) => return Result.Err(e)
    }
}

// true if s is valid standard Base64
fn b64_is_valid(s: str) -> bool {
    return b64_decode_impl(s, false).is_ok()
}
