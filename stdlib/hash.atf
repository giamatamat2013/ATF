// std/hash - checksums and cryptographic hash functions.
//
//   import "std/hash"
//   hash_crc32("hello")      == 0x3610a686            (CRC-32/IEEE, as used by zip, png, gzip)
//   hash_adler32("hello")    == 0x062c0215
//   hash_fnv1a32("hello")    == 0x4f9f2cab
//   hash_fnv1a64("hello")    -> 64-bit FNV-1a (may print as a negative int; use hash_hex64)
//   hash_md5("abc")          == "900150983cd24fb0d6963f7d28e17f72"
//   hash_sha1("abc")         == "a9993e364706816aba3e25717850c26c9cd0d89d"
//   hash_sha256("abc")       == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
//   hash_hmac_sha256(key, message)   (RFC 2104 HMAC, hex result)
//
// Text (str) is hashed as raw bytes (UTF-8 for normal text). Digest functions return lowercase hex;
// the *_raw variants return the digest bytes as a str (useful for HMAC or Base64).
// Note: MD5 and SHA-1 are broken for security purposes; use them only for checksums / compatibility.

const HASH_M32 = 0xFFFFFFFF

// ---------------------------------------------------------------- formatting helpers
// 8 lowercase hex digits of the low 32 bits of x
fn hash_hex32(x: int) -> str {
    return pad_zero(int_to_hex(x & HASH_M32), 8)
}

// 16 lowercase hex digits of x seen as an unsigned 64-bit number
fn hash_hex64(x: int) -> str {
    return hash_hex32(x >>> 32) + hash_hex32(x)
}

// lowercase hex of every byte of s
fn hash_to_hex(s: str) -> str {
    let digits = "0123456789abcdef"
    let n = str_len(s)
    let r = str_new(n * 2)
    let d = str_data(r)
    let p = str_data(s)
    for i in 0..n {
        d[i * 2] = str_data(digits)[p[i] >> 4]
        d[i * 2 + 1] = str_data(digits)[p[i] & 15]
    }
    return r
}

// ---------------------------------------------------------------- checksums
var hash_crc_table: [int] = []

fn hash_crc32_init() {
    hash_crc_table = array_make::<int>(256)
    for n in 0..256 {
        var c = n
        for k in 0..8 {
            if c & 1 != 0 { c = 0xEDB88320 ^ (c >> 1) } else { c = c >> 1 }
        }
        hash_crc_table[n] = c
    }
}

// continues a CRC-32 computation: hash_crc32(a + b) == hash_crc32_update(hash_crc32(a), b)
fn hash_crc32_update(crc: int, s: str) -> int {
    if hash_crc_table.len() == 0 { hash_crc32_init() }
    let t = hash_crc_table.data
    var c = (crc ^ HASH_M32) & HASH_M32
    let p = str_data(s)
    for i in 0..str_len(s) {
        c = t[(c ^ p[i]) & 255] ^ (c >> 8)
    }
    return c ^ HASH_M32
}

// CRC-32 (IEEE 802.3, reflected polynomial 0xEDB88320) of the bytes of s; 0 .. 0xFFFFFFFF
fn hash_crc32(s: str) -> int {
    return hash_crc32_update(0, s)
}

// Adler-32 checksum (as used by zlib)
fn hash_adler32(s: str) -> int {
    var a = 1
    var b = 0
    let p = str_data(s)
    for i in 0..str_len(s) {
        a = (a + p[i]) % 65521
        b = (b + a) % 65521
    }
    return (b << 16) | a
}

// 32-bit FNV-1a hash (0 .. 0xFFFFFFFF)
fn hash_fnv1a32(s: str) -> int {
    var h = 0x811C9DC5
    let p = str_data(s)
    for i in 0..str_len(s) {
        h = ((h ^ p[i]) * 0x01000193) & HASH_M32
    }
    return h
}

// 64-bit FNV-1a hash (all 64 bits are used, so the int may be negative)
fn hash_fnv1a64(s: str) -> int {
    var h = -3750763034362895579       // 0xcbf29ce484222325
    let p = str_data(s)
    for i in 0..str_len(s) {
        h = (h ^ p[i]) * 0x100000001B3
    }
    return h
}

// djb2 string hash (h * 33 + c), 32-bit
fn hash_djb2(s: str) -> int {
    var h = 5381
    let p = str_data(s)
    for i in 0..str_len(s) {
        h = (h * 33 + p[i]) & HASH_M32
    }
    return h
}

// ---------------------------------------------------------------- shared padding
// message + 0x80 + zeros + 64-bit bit length (big- or little-endian), a multiple of 64 bytes long
fn hash_pad(s: str, big_endian: bool) -> str {
    let n = str_len(s)
    var total = n + 9
    total = (total + 63) / 64 * 64
    let r = str_new(total)
    let d = str_data(r)
    __memcpy(d, str_data(s), n)
    d[n] = byte(0x80)
    for i in n + 1..total { d[i] = byte(0) }
    let bits = n * 8
    for i in 0..8 {
        let b = byte((bits >>> (8 * i)) & 255)
        if big_endian { d[total - 1 - i] = b } else { d[total - 8 + i] = b }
    }
    return r
}

fn hash_rotl32(x: int, n: int) -> int {
    return ((x << n) | (x >>> (32 - n))) & HASH_M32
}

fn hash_rotr32(x: int, n: int) -> int {
    return ((x >>> n) | (x << (32 - n))) & HASH_M32
}

fn hash_be32(p: ptr<byte>, i: int) -> int {
    return (p[i] << 24) | (p[i + 1] << 16) | (p[i + 2] << 8) | p[i + 3]
}

fn hash_le32(p: ptr<byte>, i: int) -> int {
    return p[i] | (p[i + 1] << 8) | (p[i + 2] << 16) | (p[i + 3] << 24)
}

// words -> bytes (each word is 32 bits)
fn hash_words_bytes(w: [int], big_endian: bool) -> str {
    let r = str_new(w.len() * 4)
    let d = str_data(r)
    for i in 0..w.len() {
        for k in 0..4 {
            let shift = if big_endian { 24 - 8 * k } else { 8 * k }
            d[i * 4 + k] = byte((w[i] >> shift) & 255)
        }
    }
    return r
}

// ---------------------------------------------------------------- MD5 (RFC 1321)
var hash_md5_k: [int] = []
var hash_md5_s: [int] = []

fn hash_md5_init() {
    hash_md5_k = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
    ]
    hash_md5_s = [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
    ]
}

// MD5 digest of s as 16 raw bytes
fn hash_md5_raw(s: str) -> str {
    if hash_md5_k.len() == 0 { hash_md5_init() }
    let msg = hash_pad(s, false)
    let p = str_data(msg)
    var a0 = 0x67452301
    var b0 = 0xefcdab89
    var c0 = 0x98badcfe
    var d0 = 0x10325476
    let m = array_make::<int>(16)
    var off = 0
    while off < str_len(msg) {
        for i in 0..16 { m[i] = hash_le32(p, off + i * 4) }
        var a = a0
        var b = b0
        var c = c0
        var d = d0
        for i in 0..64 {
            var f = 0
            var g = 0
            if i < 16 {
                f = (b & c) | ((~b) & d)
                g = i
            } else if i < 32 {
                f = (d & b) | ((~d) & c)
                g = (5 * i + 1) % 16
            } else if i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } else {
                f = c ^ (b | ((~d) & HASH_M32))
                g = (7 * i) % 16
            }
            f = (f + a + hash_md5_k[i] + m[g]) & HASH_M32
            a = d
            d = c
            c = b
            b = (b + hash_rotl32(f, hash_md5_s[i])) & HASH_M32
        }
        a0 = (a0 + a) & HASH_M32
        b0 = (b0 + b) & HASH_M32
        c0 = (c0 + c) & HASH_M32
        d0 = (d0 + d) & HASH_M32
        off += 64
    }
    return hash_words_bytes([a0, b0, c0, d0], false)
}

// MD5 digest of s as 32 lowercase hex digits
fn hash_md5(s: str) -> str { return hash_to_hex(hash_md5_raw(s)) }

// ---------------------------------------------------------------- SHA-1 (FIPS 180-4)
// SHA-1 digest of s as 20 raw bytes
fn hash_sha1_raw(s: str) -> str {
    let msg = hash_pad(s, true)
    let p = str_data(msg)
    var h0 = 0x67452301
    var h1 = 0xEFCDAB89
    var h2 = 0x98BADCFE
    var h3 = 0x10325476
    var h4 = 0xC3D2E1F0
    let w = array_make::<int>(80)
    var off = 0
    while off < str_len(msg) {
        for i in 0..16 { w[i] = hash_be32(p, off + i * 4) }
        for i in 16..80 { w[i] = hash_rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1) }
        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        for i in 0..80 {
            var f = 0
            var k = 0
            if i < 20 {
                f = (b & c) | ((~b) & d)
                k = 0x5A827999
            } else if i < 40 {
                f = b ^ c ^ d
                k = 0x6ED9EBA1
            } else if i < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 0x8F1BBCDC
            } else {
                f = b ^ c ^ d
                k = 0xCA62C1D6
            }
            let t = (hash_rotl32(a, 5) + (f & HASH_M32) + e + k + w[i]) & HASH_M32
            e = d
            d = c
            c = hash_rotl32(b, 30)
            b = a
            a = t
        }
        h0 = (h0 + a) & HASH_M32
        h1 = (h1 + b) & HASH_M32
        h2 = (h2 + c) & HASH_M32
        h3 = (h3 + d) & HASH_M32
        h4 = (h4 + e) & HASH_M32
        off += 64
    }
    return hash_words_bytes([h0, h1, h2, h3, h4], true)
}

// SHA-1 digest of s as 40 lowercase hex digits
fn hash_sha1(s: str) -> str { return hash_to_hex(hash_sha1_raw(s)) }

// ---------------------------------------------------------------- SHA-256 (FIPS 180-4)
var hash_sha256_k: [int] = []

fn hash_sha256_init() {
    hash_sha256_k = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
}

// SHA-256 digest of s as 32 raw bytes
fn hash_sha256_raw(s: str) -> str {
    if hash_sha256_k.len() == 0 { hash_sha256_init() }
    let kk = hash_sha256_k
    let msg = hash_pad(s, true)
    let p = str_data(msg)
    let h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    let w = array_make::<int>(64)
    var off = 0
    while off < str_len(msg) {
        for i in 0..16 { w[i] = hash_be32(p, off + i * 4) }
        for i in 16..64 {
            let s0 = hash_rotr32(w[i - 15], 7) ^ hash_rotr32(w[i - 15], 18) ^ (w[i - 15] >>> 3)
            let s1 = hash_rotr32(w[i - 2], 17) ^ hash_rotr32(w[i - 2], 19) ^ (w[i - 2] >>> 10)
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & HASH_M32
        }
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for i in 0..64 {
            let S1 = hash_rotr32(e, 6) ^ hash_rotr32(e, 11) ^ hash_rotr32(e, 25)
            let ch = (e & f) ^ ((~e) & g)
            let t1 = (hh + S1 + (ch & HASH_M32) + kk[i] + w[i]) & HASH_M32
            let S0 = hash_rotr32(a, 2) ^ hash_rotr32(a, 13) ^ hash_rotr32(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = (S0 + maj) & HASH_M32
            hh = g
            g = f
            f = e
            e = (d + t1) & HASH_M32
            d = c
            c = b
            b = a
            a = (t1 + t2) & HASH_M32
        }
        h[0] = (h[0] + a) & HASH_M32
        h[1] = (h[1] + b) & HASH_M32
        h[2] = (h[2] + c) & HASH_M32
        h[3] = (h[3] + d) & HASH_M32
        h[4] = (h[4] + e) & HASH_M32
        h[5] = (h[5] + f) & HASH_M32
        h[6] = (h[6] + g) & HASH_M32
        h[7] = (h[7] + hh) & HASH_M32
        off += 64
    }
    return hash_words_bytes(h, true)
}

// SHA-256 digest of s as 64 lowercase hex digits
fn hash_sha256(s: str) -> str { return hash_to_hex(hash_sha256_raw(s)) }

// ---------------------------------------------------------------- HMAC (RFC 2104)
// HMAC-SHA256 of message with key, as 32 raw bytes
fn hash_hmac_sha256_raw(key: str, message: str) -> str {
    var k = key
    if str_len(k) > 64 { k = hash_sha256_raw(k) }
    let ipad = str_new(64)
    let opad = str_new(64)
    for i in 0..64 {
        var kb = 0
        if i < str_len(k) { kb = str_data(k)[i] }
        str_data(ipad)[i] = byte(kb ^ 0x36)
        str_data(opad)[i] = byte(kb ^ 0x5c)
    }
    return hash_sha256_raw(opad + hash_sha256_raw(ipad + message))
}

// HMAC-SHA256 of message with key, as 64 lowercase hex digits
fn hash_hmac_sha256(key: str, message: str) -> str {
    return hash_to_hex(hash_hmac_sha256_raw(key, message))
}
