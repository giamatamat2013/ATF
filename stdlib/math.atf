// std/math - number theory helpers (like Python's math) and descriptive statistics (like Python's statistics).
//
//   import "std/math"
//   math_factorial(10)                  == 3628800
//   math_is_prime(97)                   == true
//   math_primes(20)                     == [2, 3, 5, 7, 11, 13, 17, 19]
//   stats_mean([1.0, 2.0, 3.0, 4.0])    == 2.5
//   stats_stdev([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]) == 2.0
//
// The statistics functions take [float] and panic on an empty array (and the sample versions on fewer than 2 values).

// n! as an int; panics for a negative n and for n > 20 (the result would not fit in 64 bits)
fn math_factorial(n: int) -> int {
    assert(n >= 0, "math_factorial: n must not be negative")
    assert(n <= 20, "math_factorial: n! does not fit in an int for n > 20")
    var r = 1
    for i in 2..=n { r *= i }
    return r
}

// n choose k (the number of ways to pick k of n); 0 when k is outside 0..n
fn math_binomial(n: int, k: int) -> int {
    if k < 0 or k > n { return 0 }
    let kk = min(k, n - k)
    var r = 1
    for i in 1..=kk { r = r * (n - kk + i) / i }
    return r
}

// the largest int r with r * r <= n; panics for a negative n
fn math_isqrt(n: int) -> int {
    assert(n >= 0, "math_isqrt: n must not be negative")
    if n < 2 { return n }
    var r = int(sqrt(float(n)))
    while r * r > n { r -= 1 }
    while (r + 1) * (r + 1) <= n { r += 1 }
    return r
}

// true when n is a prime number (trial division, fine up to about 10^12)
fn math_is_prime(n: int) -> bool {
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 or n % 3 == 0 { return false }
    var i = 5
    while i * i <= n {
        if n % i == 0 or n % (i + 2) == 0 { return false }
        i += 6
    }
    return true
}

// all primes <= limit, smallest first (sieve of Eratosthenes)
fn math_primes(limit: int) -> [int] {
    var out: [int] = []
    if limit < 2 { return out }
    let composite = array_make::<bool>(limit + 1)
    for i in 2..=limit {
        if composite[i] { continue }
        out.push(i)
        var j = i * i
        while j <= limit {
            composite[j] = true
            j += i
        }
    }
    return out
}

// the prime factors of n with repeats, smallest first: math_prime_factors(12) == [2, 2, 3]; [] for n < 2
fn math_prime_factors(n: int) -> [int] {
    var out: [int] = []
    var m = n
    var p = 2
    while p * p <= m {
        while m % p == 0 {
            out.push(p)
            m /= p
        }
        p += if p == 2 { 1 } else { 2 }
    }
    if m > 1 { out.push(m) }
    return out
}

// the n-th Fibonacci number (fib(0) == 0, fib(1) == 1); panics when n < 0 or n > 92 (it would overflow)
fn math_fib(n: int) -> int {
    assert(n >= 0 and n <= 92, "math_fib: n must be 0..92")
    var a = 0
    var b = 1
    for i in 0..n { a, b = b, a + b }
    return a
}

// (base ** exp) % m without overflow for m up to 3 billion; exp must not be negative
fn math_mod_pow(base: int, exp: int, m: int) -> int {
    assert(exp >= 0, "math_mod_pow: exp must not be negative")
    assert(m > 0, "math_mod_pow: m must be positive")
    var result = 1 % m
    var b = ((base % m) + m) % m
    var e = exp
    while e > 0 {
        if e & 1 == 1 { result = result * b % m }
        b = b * b % m
        e >>= 1
    }
    return result
}

// a + (b - a) * t: the point t of the way from a to b (t = 0.5 is the middle)
fn math_lerp(a: float, b: float, t: float) -> float { return a + (b - a) * t }

// the sum of the values
fn stats_sum(a: [float]) -> float {
    var total = 0.0
    for x in a { total += x }
    return total
}

// the average
fn stats_mean(a: [float]) -> float {
    assert(a.len() > 0, "stats_mean: the array is empty")
    return stats_sum(a) / float(a.len())
}

// the middle value (the average of the two middle values when the count is even)
fn stats_median(a: [float]) -> float {
    assert(a.len() > 0, "stats_median: the array is empty")
    let s = a.sorted()
    let n = s.len()
    if n % 2 == 1 { return s[n / 2] }
    return (s[n / 2 - 1] + s[n / 2]) / 2.0
}

// the most common value (the first one that reaches the highest count on ties)
fn stats_mode<T>(a: [T]) -> T {
    assert(a.len() > 0, "stats_mode: the array is empty")
    var counts: {T: int} = {}
    var best = a[0]
    var best_n = 0
    for x in a {
        let n = counts.get(x, 0) + 1
        counts[x] = n
        if n > best_n {
            best_n = n
            best = x
        }
    }
    return best
}

// population variance (divides by n)
fn stats_variance(a: [float]) -> float {
    let m = stats_mean(a)
    var total = 0.0
    for x in a { total += (x - m) * (x - m) }
    return total / float(a.len())
}

// sample variance (divides by n - 1); needs at least 2 values
fn stats_sample_variance(a: [float]) -> float {
    assert(a.len() >= 2, "stats_sample_variance: needs at least 2 values")
    let m = stats_mean(a)
    var total = 0.0
    for x in a { total += (x - m) * (x - m) }
    return total / float(a.len() - 1)
}

// population standard deviation
fn stats_stdev(a: [float]) -> float { return sqrt(stats_variance(a)) }

// sample standard deviation
fn stats_sample_stdev(a: [float]) -> float { return sqrt(stats_sample_variance(a)) }

// the p-th percentile (p from 0 to 100) with linear interpolation between neighbours:
// stats_percentile(a, 50.0) is the median
fn stats_percentile(a: [float], p: float) -> float {
    assert(a.len() > 0, "stats_percentile: the array is empty")
    assert(p >= 0.0 and p <= 100.0, "stats_percentile: p must be 0..100")
    let s = a.sorted()
    let pos = p / 100.0 * float(s.len() - 1)
    let lo = int(floor(pos))
    let hi = min(lo + 1, s.len() - 1)
    return s[lo] + (s[hi] - s[lo]) * (pos - float(lo))
}

// the Pearson correlation of two arrays of the same length (nan when one of them is constant)
fn stats_correlation(a: [float], b: [float]) -> float {
    assert(a.len() == b.len() and a.len() >= 2, "stats_correlation: needs two arrays of the same length (at least 2)")
    let ma = stats_mean(a)
    let mb = stats_mean(b)
    var sab = 0.0
    var saa = 0.0
    var sbb = 0.0
    for i in 0..a.len() {
        sab += (a[i] - ma) * (b[i] - mb)
        saa += (a[i] - ma) * (a[i] - ma)
        sbb += (b[i] - mb) * (b[i] - mb)
    }
    return sab / sqrt(saa * sbb)
}
