// std/json - JSON parsing and generation (RFC 8259).
//
//   import "std/json"
//
//   let r = json_parse("\{\"name\": \"Ada\", \"langs\": [\"en\", \"fr\"], \"age\": 36}")
//   match r {
//       Result.Ok(v) => println(v.get_str("name", "?"), v.query("langs[1]"), v.get_int("age", 0))
//       Result.Err(e) => println("bad json: " + e)       // e.g. "line 1, column 9: expected ':' ..."
//   }
//
//   let doc = json_object()
//   doc.set("ok", JsonValue.Bool(true))
//   doc.set("items", json_array_of([JsonValue.Int(1), JsonValue.Int(2)]))
//   println(json_stringify(doc))            // {"ok":true,"items":[1,2]}
//   println(json_stringify(doc, 2))         // pretty-printed with 2-space indentation
//
// Numbers: integers that fit in 64 bits become JsonValue.Int, all other numbers JsonValue.Float.
// Objects keep the order of their keys (they are {str: JsonValue} maps); a repeated key keeps the last value.
// Strings are UTF-8; \uXXXX escapes (including surrogate pairs) are decoded to UTF-8.

enum JsonValue {
    Null,
    Bool(bool),
    Int(int),
    Float(float),
    Str(str),
    Array([JsonValue]),
    Object({str: JsonValue})
}

// ---------------------------------------------------------------- constructors
fn json_null() -> JsonValue { return JsonValue.Null }
fn json_bool(b: bool) -> JsonValue { return JsonValue.Bool(b) }
fn json_int(i: int) -> JsonValue { return JsonValue.Int(i) }
fn json_float(f: float) -> JsonValue { return JsonValue.Float(f) }
fn json_str(s: str) -> JsonValue { return JsonValue.Str(s) }
// a new, empty array value (add elements with push)
fn json_array() -> JsonValue {
    let a: [JsonValue] = []
    return JsonValue.Array(a)
}
fn json_array_of(items: [JsonValue]) -> JsonValue { return JsonValue.Array(items) }
// a new, empty object value (add members with set)
fn json_object() -> JsonValue {
    let m: {str: JsonValue} = {}
    return JsonValue.Object(m)
}
fn json_object_of(members: {str: JsonValue}) -> JsonValue { return JsonValue.Object(members) }
// convenience: arrays of plain values
fn json_str_array(items: [str]) -> JsonValue { return JsonValue.Array(items.map(|s| JsonValue.Str(s))) }
fn json_int_array(items: [int]) -> JsonValue { return JsonValue.Array(items.map(|i| JsonValue.Int(i))) }
fn json_float_array(items: [float]) -> JsonValue { return JsonValue.Array(items.map(|f| JsonValue.Float(f))) }

// ---------------------------------------------------------------- accessors
impl JsonValue {
    // "null", "bool", "int", "float", "string", "array" or "object"
    fn kind(self) -> str {
        return match self {
            JsonValue.Null => "null"
            JsonValue.Bool(b) => "bool"
            JsonValue.Int(i) => "int"
            JsonValue.Float(f) => "float"
            JsonValue.Str(s) => "string"
            JsonValue.Array(a) => "array"
            JsonValue.Object(o) => "object"
        }
    }
    fn is_null(self) -> bool { return self.kind() == "null" }
    fn is_bool(self) -> bool { return self.kind() == "bool" }
    // true for both Int and Float
    fn is_number(self) -> bool {
        let k = self.kind()
        return k == "int" or k == "float"
    }
    fn is_int(self) -> bool { return self.kind() == "int" }
    fn is_str(self) -> bool { return self.kind() == "string" }
    fn is_array(self) -> bool { return self.kind() == "array" }
    fn is_object(self) -> bool { return self.kind() == "object" }

    fn as_bool(self) -> bool? {
        match self {
            JsonValue.Bool(b) => return b
            _ => return nil
        }
    }
    // Int values, and Float values that are whole numbers in the int range
    fn as_int(self) -> int? {
        match self {
            JsonValue.Int(i) => return i
            JsonValue.Float(f) => {
                if f == __floor(f) and f >= -9223372036854775808.0 and f < 9223372036854775808.0 { return f as int }
                return nil
            }
            _ => return nil
        }
    }
    // any number as a float
    fn as_float(self) -> float? {
        match self {
            JsonValue.Int(i) => return i as float
            JsonValue.Float(f) => return f
            _ => return nil
        }
    }
    fn as_str(self) -> str? {
        match self {
            JsonValue.Str(s) => return s
            _ => return nil
        }
    }
    // the elements of an array (the same array object: changes are visible in the value)
    fn as_array(self) -> [JsonValue]? {
        match self {
            JsonValue.Array(a) => return a
            _ => return nil
        }
    }
    // the members of an object (the same map object)
    fn as_object(self) -> {str: JsonValue}? {
        match self {
            JsonValue.Object(o) => return o
            _ => return nil
        }
    }
    // number of elements (array), members (object) or bytes (string); 0 for other values
    fn len(self) -> int {
        return match self {
            JsonValue.Array(a) => a.len()
            JsonValue.Object(o) => o.len()
            JsonValue.Str(s) => s.len()
            _ => 0
        }
    }
    // member of an object; nil if this is not an object or the key is missing
    fn get(self, key: str) -> JsonValue? {
        match self {
            JsonValue.Object(o) => return o.try_get(key)
            _ => return nil
        }
    }
    // element of an array; nil if this is not an array or i is out of range (negative i counts from the end)
    fn at(self, i: int) -> JsonValue? {
        match self {
            JsonValue.Array(a) => {
                var k = i
                if k < 0 { k += a.len() }
                if k < 0 or k >= a.len() { return nil }
                return a[k]
            }
            _ => return nil
        }
    }
    fn has(self, key: str) -> bool {
        match self {
            JsonValue.Object(o) => return o.has(key)
            _ => return false
        }
    }
    // keys of an object in order ([] for other values)
    fn keys(self) -> [str] {
        match self {
            JsonValue.Object(o) => return o.keys()
            _ => {
                let none: [str] = []
                return none
            }
        }
    }
    // typed member lookups with a default for missing / wrongly typed members
    fn get_str(self, key: str, default: str) -> str {
        if let v = self.get(key) { return v.as_str() ?? default }
        return default
    }
    fn get_int(self, key: str, default: int) -> int {
        if let v = self.get(key) { return v.as_int() ?? default }
        return default
    }
    fn get_float(self, key: str, default: float) -> float {
        if let v = self.get(key) { return v.as_float() ?? default }
        return default
    }
    fn get_bool(self, key: str, default: bool) -> bool {
        if let v = self.get(key) { return v.as_bool() ?? default }
        return default
    }
    // Follows a path like  "users[0].name"  or  "matrix[1][2]"  or  "a.b.c"; nil if any step is missing.
    // Keys containing '.' or '[' cannot be reached this way (use get).
    fn query(self, path: str) -> JsonValue? {
        var cur = self
        let n = str_len(path)
        let p = str_data(path)
        var i = 0
        while i < n {
            let c = p[i]
            if c == '.' {
                i += 1
                continue
            }
            if c == '[' {
                var j = i + 1
                var neg = false
                if j < n and p[j] == '-' {
                    neg = true
                    j += 1
                }
                var idx = 0
                let start = j
                while j < n and p[j] >= '0' and p[j] <= '9' {
                    idx = idx * 10 + (p[j] - '0')
                    j += 1
                }
                if j == start or j >= n or p[j] != ']' { return nil }
                if neg { idx = -idx }
                cur = cur.at(idx)?
                i = j + 1
                continue
            }
            var j = i
            while j < n and p[j] != '.' and p[j] != '[' { j += 1 }
            cur = cur.get(path[i..j])?
            i = j
        }
        return cur
    }
    // sets a member of an object (does nothing for other values)
    fn set(self, key: str, v: JsonValue) {
        match self {
            JsonValue.Object(o) => o.set(key, v)
            _ => {}
        }
    }
    // removes a member of an object; true if it was there
    fn remove(self, key: str) -> bool {
        match self {
            JsonValue.Object(o) => return o.remove(key)
            _ => return false
        }
    }
    // appends to an array (does nothing for other values)
    fn push(self, v: JsonValue) {
        match self {
            JsonValue.Array(a) => a.push(v)
            _ => {}
        }
    }
    // compact JSON text (used by println and string interpolation)
    fn to_str(self) -> str { return json_stringify(self) }
}

// ---------------------------------------------------------------- stringify
// JSON string literal for s (with quotes). Control characters are escaped; other bytes are copied,
// so UTF-8 text stays readable. With ascii_only, non-ASCII characters become \uXXXX escapes.
fn json_quote(s: str, ascii_only: bool = false) -> str {
    var sb = str_builder()
    json_write_str(sb, s, ascii_only)
    return sb.finish()
}

fn json_hex4(sb: StrBuilder, v: int) {
    let digits = "0123456789abcdef"
    sb.add("\\u")
    sb.add_byte(str_data(digits)[(v >> 12) & 15])
    sb.add_byte(str_data(digits)[(v >> 8) & 15])
    sb.add_byte(str_data(digits)[(v >> 4) & 15])
    sb.add_byte(str_data(digits)[v & 15])
}

fn json_write_str(sb: StrBuilder, s: str, ascii_only: bool) {
    sb.add_byte('"')
    let p = str_data(s)
    let n = str_len(s)
    var i = 0
    while i < n {
        let c = p[i]
        if c == '"' { sb.add("\\\"") }
        else if c == '\\' { sb.add("\\\\") }
        else if c == 10 { sb.add("\\n") }
        else if c == 13 { sb.add("\\r") }
        else if c == 9 { sb.add("\\t") }
        else if c == 8 { sb.add("\\b") }
        else if c == 12 { sb.add("\\f") }
        else if c < 32 or c == 127 { json_hex4(sb, c) }
        else if c >= 128 and ascii_only {
            // decode one UTF-8 sequence; invalid bytes become U+FFFD
            var cp = 0xFFFD
            var len = 1
            if c >= 0xC2 and c < 0xE0 and i + 1 < n and p[i + 1] & 0xC0 == 0x80 {
                cp = ((c & 0x1F) << 6) | (p[i + 1] & 0x3F)
                len = 2
            } else if c >= 0xE0 and c < 0xF0 and i + 2 < n and p[i + 1] & 0xC0 == 0x80 and p[i + 2] & 0xC0 == 0x80 {
                cp = ((c & 0x0F) << 12) | ((p[i + 1] & 0x3F) << 6) | (p[i + 2] & 0x3F)
                len = 3
            } else if c >= 0xF0 and c < 0xF5 and i + 3 < n and p[i + 1] & 0xC0 == 0x80 and p[i + 2] & 0xC0 == 0x80 and p[i + 3] & 0xC0 == 0x80 {
                cp = ((c & 0x07) << 18) | ((p[i + 1] & 0x3F) << 12) | ((p[i + 2] & 0x3F) << 6) | (p[i + 3] & 0x3F)
                len = 4
            }
            if cp >= 0x10000 {
                let v = cp - 0x10000
                json_hex4(sb, 0xD800 + (v >> 10))
                json_hex4(sb, 0xDC00 + (v & 0x3FF))
            } else {
                json_hex4(sb, cp)
            }
            i += len
            continue
        }
        else { sb.add_byte(c) }
        i += 1
    }
    sb.add_byte('"')
}

fn json_float_text(f: float) -> str {
    if f != f or f - f != 0.0 { return "null" }     // NaN and infinities have no JSON form
    return float_to_str(f)
}

fn json_newline(sb: StrBuilder, indent: int, level: int) {
    sb.add_byte('\n')
    for i in 0..indent * level { sb.add_byte(' ') }
}

fn json_write(sb: StrBuilder, v: JsonValue, indent: int, level: int, ascii_only: bool, sort_keys: bool) {
    match v {
        JsonValue.Null => sb.add("null")
        JsonValue.Bool(b) => sb.add(if b { "true" } else { "false" })
        JsonValue.Int(i) => sb.add(int_to_str(i))
        JsonValue.Float(f) => sb.add(json_float_text(f))
        JsonValue.Str(s) => json_write_str(sb, s, ascii_only)
        JsonValue.Array(a) => {
            if a.len() == 0 {
                sb.add("[]")
                return
            }
            sb.add_byte('[')
            for i in 0..a.len() {
                if i > 0 { sb.add_byte(',') }
                if indent > 0 { json_newline(sb, indent, level + 1) }
                json_write(sb, a[i], indent, level + 1, ascii_only, sort_keys)
            }
            if indent > 0 { json_newline(sb, indent, level) }
            sb.add_byte(']')
        }
        JsonValue.Object(o) => {
            if o.len() == 0 {
                sb.add("\{}")
                return
            }
            sb.add_byte('{')
            var keys = o.keys()
            if sort_keys { keys.sort() }
            for i in 0..keys.len() {
                if i > 0 { sb.add_byte(',') }
                if indent > 0 { json_newline(sb, indent, level + 1) }
                json_write_str(sb, keys[i], ascii_only)
                sb.add_byte(':')
                if indent > 0 { sb.add_byte(' ') }
                json_write(sb, o[keys[i]], indent, level + 1, ascii_only, sort_keys)
            }
            if indent > 0 { json_newline(sb, indent, level) }
            sb.add_byte('}')
        }
    }
}

// JSON text for v. indent = 0 gives compact output; indent > 0 pretty-prints with that many spaces
// per level. sort_keys orders object members by key; ascii_only escapes all non-ASCII characters.
// NaN and infinite floats are written as null.
fn json_stringify(v: JsonValue, indent: int = 0, sort_keys: bool = false, ascii_only: bool = false) -> str {
    var sb = str_builder()
    json_write(sb, v, indent, 0, ascii_only, sort_keys)
    return sb.finish()
}

// ---------------------------------------------------------------- parser
const JSON_MAX_DEPTH = 1000

struct JsonParser {
    src: str,
    p: ptr<byte>,
    n: int,
    pos: int,
    failed: bool,
    err: str,
    depth: int
}

impl JsonParser {
    // records the first error (with line and column of byte offset at)
    fn fail_at(self, at: int, msg: str) {
        if self.failed { return }
        self.failed = true
        var line = 1
        var col = 1
        var i = 0
        while i < at and i < self.n {
            if self.p[i] == 10 {
                line += 1
                col = 1
            } else if self.p[i] & 0xC0 != 0x80 {
                col += 1
            }
            i += 1
        }
        self.err = "line {line}, column {col}: {msg}"
    }
    fn fail(self, msg: str) { self.fail_at(self.pos, msg) }

    // description of the current character for error messages
    fn here(self) -> str {
        if self.pos >= self.n { return "end of input" }
        let c = self.p[self.pos]
        if c >= 32 and c < 127 { return "'" + char_str(c) + "'" }
        return "byte 0x" + pad_zero(int_to_hex(c), 2)
    }

    fn skip_ws(self) {
        while self.pos < self.n {
            let c = self.p[self.pos]
            if c == ' ' or c == 9 or c == 10 or c == 13 { self.pos += 1 } else { return }
        }
    }

    fn value(self) -> JsonValue {
        self.skip_ws()
        if self.pos >= self.n {
            self.fail("unexpected end of input, expected a value")
            return JsonValue.Null
        }
        let c = self.p[self.pos]
        if c == '{' { return self.object() }
        if c == '[' { return self.array() }
        if c == '"' {
            let s = self.string()
            return JsonValue.Str(s)
        }
        if c == '-' or (c >= '0' and c <= '9') { return self.number() }
        if c == 't' { return self.literal("true", JsonValue.Bool(true)) }
        if c == 'f' { return self.literal("false", JsonValue.Bool(false)) }
        if c == 'n' { return self.literal("null", JsonValue.Null) }
        if c == '\'' {
            self.fail("strings must use double quotes, not single quotes")
        } else if c == '}' or c == ']' {
            self.fail("unexpected {self.here()}, expected a value")
        } else {
            self.fail("unexpected {self.here()}, expected a value (object, array, string, number, true, false or null)")
        }
        return JsonValue.Null
    }

    fn literal(self, word: str, v: JsonValue) -> JsonValue {
        let m = str_len(word)
        var ok = self.pos + m <= self.n
        if ok {
            for i in 0..m {
                if self.p[self.pos + i] != str_data(word)[i] { ok = false }
            }
        }
        if ok and self.pos + m < self.n {
            let c = self.p[self.pos + m]
            if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' { ok = false }
        }
        if not ok {
            var j = self.pos
            while j < self.n and ((self.p[j] >= 'a' and self.p[j] <= 'z') or (self.p[j] >= 'A' and self.p[j] <= 'Z')) { j += 1 }
            if j == self.pos { j = self.pos + 1 }
            self.fail("invalid literal '{self.src[self.pos..j]}' (expected {word})")
            return JsonValue.Null
        }
        self.pos += m
        return v
    }

    fn number(self) -> JsonValue {
        let start = self.pos
        var is_float = false
        if self.p[self.pos] == '-' { self.pos += 1 }
        if self.pos >= self.n or self.p[self.pos] < '0' or self.p[self.pos] > '9' {
            self.fail("expected a digit after '-'")
            return JsonValue.Null
        }
        if self.p[self.pos] == '0' {
            self.pos += 1
            if self.pos < self.n and self.p[self.pos] >= '0' and self.p[self.pos] <= '9' {
                self.fail_at(start, "numbers cannot have leading zeros")
                return JsonValue.Null
            }
        } else {
            while self.pos < self.n and self.p[self.pos] >= '0' and self.p[self.pos] <= '9' { self.pos += 1 }
        }
        if self.pos < self.n and self.p[self.pos] == '.' {
            is_float = true
            self.pos += 1
            if self.pos >= self.n or self.p[self.pos] < '0' or self.p[self.pos] > '9' {
                self.fail("expected a digit after the decimal point")
                return JsonValue.Null
            }
            while self.pos < self.n and self.p[self.pos] >= '0' and self.p[self.pos] <= '9' { self.pos += 1 }
        }
        if self.pos < self.n and (self.p[self.pos] == 'e' or self.p[self.pos] == 'E') {
            is_float = true
            self.pos += 1
            if self.pos < self.n and (self.p[self.pos] == '+' or self.p[self.pos] == '-') { self.pos += 1 }
            if self.pos >= self.n or self.p[self.pos] < '0' or self.p[self.pos] > '9' {
                self.fail("expected a digit in the exponent")
                return JsonValue.Null
            }
            while self.pos < self.n and self.p[self.pos] >= '0' and self.p[self.pos] <= '9' { self.pos += 1 }
        }
        let text = self.src[start..self.pos]
        if not is_float {
            // exact 64-bit integer if it fits, otherwise fall back to a float
            let neg = self.p[start] == '-'
            var v = 0
            var overflow = false
            var i = start
            if neg { i += 1 }
            while i < self.pos {
                let d = self.p[i] - '0'
                // accumulate negatively so that INT_MIN fits
                if v < (-9223372036854775807 - 1 + d) / 10 { overflow = true }
                v = v * 10 - d
                i += 1
            }
            if not overflow and not (not neg and v == -9223372036854775807 - 1) {
                if neg { return JsonValue.Int(v) }
                return JsonValue.Int(-v)
            }
        }
        let f = parse_float_str(text)
        if f == nil {
            self.fail_at(start, "invalid number '{text}'")
            return JsonValue.Null
        }
        return JsonValue.Float(f!)
    }

    fn hex4(self) -> int {
        if self.pos + 4 > self.n {
            self.fail("incomplete \\u escape (expected 4 hex digits)")
            return -1
        }
        var v = 0
        for i in 0..4 {
            let c = self.p[self.pos + i]
            var d = -1
            if c >= '0' and c <= '9' { d = c - '0' }
            else if c >= 'a' and c <= 'f' { d = c - 'a' + 10 }
            else if c >= 'A' and c <= 'F' { d = c - 'A' + 10 }
            if d < 0 {
                self.fail_at(self.pos + i, "invalid hex digit in \\u escape")
                return -1
            }
            v = v * 16 + d
        }
        self.pos += 4
        return v
    }

    fn add_utf8(self, sb: StrBuilder, cp: int) {
        if cp < 0x80 {
            sb.add_byte(byte(cp))
        } else if cp < 0x800 {
            sb.add_byte(byte(0xC0 | (cp >> 6)))
            sb.add_byte(byte(0x80 | (cp & 63)))
        } else if cp < 0x10000 {
            sb.add_byte(byte(0xE0 | (cp >> 12)))
            sb.add_byte(byte(0x80 | ((cp >> 6) & 63)))
            sb.add_byte(byte(0x80 | (cp & 63)))
        } else {
            sb.add_byte(byte(0xF0 | (cp >> 18)))
            sb.add_byte(byte(0x80 | ((cp >> 12) & 63)))
            sb.add_byte(byte(0x80 | ((cp >> 6) & 63)))
            sb.add_byte(byte(0x80 | (cp & 63)))
        }
    }

    // parses a string literal starting at the opening quote
    fn string(self) -> str {
        let start = self.pos
        self.pos += 1
        var sb = str_builder()
        loop {
            // copy a run of plain characters at once
            let run = self.pos
            while self.pos < self.n {
                let c = self.p[self.pos]
                if c == '"' or c == '\\' or c < 32 { break }
                self.pos += 1
            }
            if self.pos > run {
                sb.reserve(self.pos - run)
                __memcpy(sb.data + sb.len, self.p + run, self.pos - run)
                sb.len += self.pos - run
            }
            if self.pos >= self.n {
                self.fail_at(start, "unterminated string (missing closing quote)")
                return ""
            }
            let c = self.p[self.pos]
            if c == '"' {
                self.pos += 1
                return sb.finish()
            }
            if c < 32 {
                if c == 10 {
                    self.fail("unescaped newline in string (write \\n)")
                } else {
                    self.fail("unescaped control character (byte 0x" + pad_zero(int_to_hex(c), 2) + ") in string")
                }
                return ""
            }
            // backslash escape
            self.pos += 1
            if self.pos >= self.n {
                self.fail_at(start, "unterminated string (missing closing quote)")
                return ""
            }
            let e = self.p[self.pos]
            self.pos += 1
            if e == '"' { sb.add_byte('"') }
            else if e == '\\' { sb.add_byte('\\') }
            else if e == '/' { sb.add_byte('/') }
            else if e == 'n' { sb.add_byte(10) }
            else if e == 't' { sb.add_byte(9) }
            else if e == 'r' { sb.add_byte(13) }
            else if e == 'b' { sb.add_byte(8) }
            else if e == 'f' { sb.add_byte(12) }
            else if e == 'u' {
                var cp = self.hex4()
                if cp < 0 { return "" }
                if cp >= 0xD800 and cp < 0xDC00 {
                    // high surrogate: must be followed by \u low surrogate
                    if self.pos + 1 < self.n and self.p[self.pos] == '\\' and self.p[self.pos + 1] == 'u' {
                        self.pos += 2
                        let lo = self.hex4()
                        if lo < 0 { return "" }
                        if lo >= 0xDC00 and lo < 0xE000 {
                            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                        } else {
                            self.fail_at(self.pos - 6, "invalid low surrogate in \\u escape")
                            return ""
                        }
                    } else {
                        self.fail_at(self.pos - 6, "lone high surrogate in \\u escape")
                        return ""
                    }
                } else if cp >= 0xDC00 and cp < 0xE000 {
                    self.fail_at(self.pos - 6, "lone low surrogate in \\u escape")
                    return ""
                }
                self.add_utf8(sb, cp)
            } else {
                self.fail_at(self.pos - 2, "invalid escape '\\" + char_str(e) + "' in string")
                return ""
            }
        }
        return ""
    }

    fn array(self) -> JsonValue {
        let open = self.pos
        self.pos += 1
        var items: [JsonValue] = []
        self.depth += 1
        if self.depth > JSON_MAX_DEPTH {
            self.fail("nesting is too deep (more than {JSON_MAX_DEPTH} levels)")
            return JsonValue.Null
        }
        self.skip_ws()
        if self.pos < self.n and self.p[self.pos] == ']' {
            self.pos += 1
            self.depth -= 1
            return JsonValue.Array(items)
        }
        loop {
            let v = self.value()
            if self.failed { return JsonValue.Null }
            items.push(v)
            self.skip_ws()
            if self.pos >= self.n {
                self.fail_at(open, "unterminated array (missing ']')")
                return JsonValue.Null
            }
            let c = self.p[self.pos]
            if c == ',' {
                self.pos += 1
                self.skip_ws()
                if self.pos < self.n and self.p[self.pos] == ']' {
                    self.fail("trailing comma before ']'")
                    return JsonValue.Null
                }
                continue
            }
            if c == ']' {
                self.pos += 1
                break
            }
            self.fail("expected ',' or ']' after an array element, found {self.here()}")
            return JsonValue.Null
        }
        self.depth -= 1
        return JsonValue.Array(items)
    }

    fn object(self) -> JsonValue {
        let open = self.pos
        self.pos += 1
        var members: {str: JsonValue} = {}
        self.depth += 1
        if self.depth > JSON_MAX_DEPTH {
            self.fail("nesting is too deep (more than {JSON_MAX_DEPTH} levels)")
            return JsonValue.Null
        }
        self.skip_ws()
        if self.pos < self.n and self.p[self.pos] == '}' {
            self.pos += 1
            self.depth -= 1
            return JsonValue.Object(members)
        }
        loop {
            self.skip_ws()
            if self.pos >= self.n {
                self.fail_at(open, "unterminated object (missing '}')")
                return JsonValue.Null
            }
            if self.p[self.pos] != '"' {
                if self.p[self.pos] == '}' {
                    self.fail("trailing comma before '}'")
                } else {
                    self.fail("expected a string key in double quotes, found {self.here()}")
                }
                return JsonValue.Null
            }
            let key = self.string()
            if self.failed { return JsonValue.Null }
            self.skip_ws()
            if self.pos >= self.n or self.p[self.pos] != ':' {
                self.fail("expected ':' after the key {json_quote(key)}, found {self.here()}")
                return JsonValue.Null
            }
            self.pos += 1
            let v = self.value()
            if self.failed { return JsonValue.Null }
            members[key] = v
            self.skip_ws()
            if self.pos >= self.n {
                self.fail_at(open, "unterminated object (missing '}')")
                return JsonValue.Null
            }
            let c = self.p[self.pos]
            if c == ',' {
                self.pos += 1
                continue
            }
            if c == '}' {
                self.pos += 1
                break
            }
            self.fail("expected ',' or '}' after an object member, found {self.here()}")
            return JsonValue.Null
        }
        self.depth -= 1
        return JsonValue.Object(members)
    }
}

// Parses JSON text. On failure the error says what is wrong and where, e.g.
//   "line 2, column 14: expected ',' or '}' after an object member, found '\"'"
fn json_parse(text: str) -> Result<JsonValue, str> {
    var start = 0
    // skip a UTF-8 byte order mark
    if str_len(text) >= 3 and str_data(text)[0] == 0xEF and str_data(text)[1] == 0xBB and str_data(text)[2] == 0xBF { start = 3 }
    let jp = JsonParser{ src: text, p: str_data(text), n: str_len(text), pos: start, failed: false, err: "", depth: 0 }
    let v = jp.value()
    if not jp.failed {
        jp.skip_ws()
        if jp.pos < jp.n { jp.fail("unexpected {jp.here()} after the end of the JSON value") }
    }
    if jp.failed { return Result.Err(jp.err) }
    return Result.Ok(v)
}

// Parses JSON text and panics with the error message if it is invalid.
fn json_parse_or_panic(text: str) -> JsonValue {
    match json_parse(text) {
        Result.Ok(v) => return v
        Result.Err(e) => panic("invalid JSON: " + e)
    }
}

// reads and parses a JSON file
fn json_read_file(path: str) -> Result<JsonValue, str> {
    let text = read_file(path)
    if text == nil { return Result.Err("cannot read file '{path}'") }
    return json_parse(text!)
}

// writes v to a file (pretty-printed with 2 spaces when indent is not given) followed by a newline
fn json_write_file(path: str, v: JsonValue, indent: int = 2) -> bool {
    return write_file(path, json_stringify(v, indent) + "\n")
}
