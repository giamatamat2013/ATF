// std/task - cooperative jobs that run a little on every frame, so long work never freezes a window.
//
//   import "std/task"
//   var i = 0
//   task_spawn(|| { i += 1; return i >= 1000 })   // the job returns true when it is finished
//   task_run(4)                                   // call once per frame: runs jobs for at most 4 ms
//
// A job is a function `fn() -> bool`. Each call should do a small piece of work (one chunk, one row)
// and return true when everything is done. Jobs run in the order they were spawned, one step each
// per round, until the time budget of task_run is used up.
//
//   task_each(1000, |k| { build_chunk(k) })       // a job for "for k in 0..1000", done a few at a time

struct TaskJob {
    run: fn() -> bool
}

var task_queue: [TaskJob] = []
var task_done_count = 0

// add a job; work is called again and again until it returns true
fn task_spawn(work: fn() -> bool) {
    task_queue.push(TaskJob(work))
}

// a job that calls body(0), body(1) ... body(n - 1), one per step
fn task_each(n: int, body: fn(int)) {
    var next = 0
    task_spawn(|| {
        if next >= n { return true }
        body(next)
        next += 1
        return next >= n
    })
}

// run the queued jobs for at most budget_ms milliseconds (at least one step runs when jobs exist).
// Returns the number of jobs still waiting.
fn task_run(budget_ms: int = 4) -> int {
    let start = clock()
    let limit = float(budget_ms) / 1000.0
    while task_queue.len() > 0 {
        let job = task_queue[0]
        if job.run() {
            task_queue.remove(0)
            task_done_count += 1
        } else if task_queue.len() > 1 {
            task_queue.remove(0)
            task_queue.push(job)
        }
        if clock() - start >= limit { break }
    }
    return task_queue.len()
}

// run every job to the end now (for tests or shutdown)
fn task_finish() {
    while task_queue.len() > 0 { task_run(1000) }
}

// number of jobs still waiting
fn task_pending() -> int { return task_queue.len() }

// number of jobs that have finished so far
fn task_completed() -> int { return task_done_count }

// drop all waiting jobs without running them
fn task_clear() {
    task_queue = []
}
