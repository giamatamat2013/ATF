// std/markdown - turns Markdown text into HTML.
//
//   import "std/markdown"
//   let page = markdown_to_html("# Hello\n\nThis is **bold**, *italic* and `code`.")
//   // <h1>Hello</h1>
//   // <p>This is <strong>bold</strong>, <em>italic</em> and <code>code</code>.</p>
//
// Supported: headings (#), paragraphs, **bold**, *italic*, `code`, [links](url), ![images](src),
// lists (- item, * item, 1. item), > quotes, ``` code blocks ```, --- lines, and \ before a
// character to show it as it is. Text is HTML-escaped, so < and & are safe to write.

// < > & and " written as HTML entities
fn md_escape(s: str) -> str {
    var sb = str_builder()
    for i in 0..s.len() {
        let c = s.byte_at(i)
        match c {
            '<' => sb.add("&lt;")
            '>' => sb.add("&gt;")
            '&' => sb.add("&amp;")
            '"' => sb.add("&quot;")
            _ => sb.add_byte(c)
        }
    }
    return sb.finish()
}

fn md_is_word_byte(c: byte) -> bool => c.is_alpha() or c.is_digit() or c >= 128

// the HTML for one line or paragraph of Markdown text (bold, italic, code, links and images)
fn markdown_inline(s: str) -> str {
    var sb = str_builder()
    let n = s.len()
    var i = 0
    while i < n {
        let c = s.byte_at(i)
        // \* shows a star
        if c == '\\' and i + 1 < n and not md_is_word_byte(s.byte_at(i + 1)) {
            sb.add(md_escape(s[i + 1..i + 2]))
            i += 2
            continue
        }
        // `code`
        if c == '`' {
            let end = s.find_from("`", i + 1)
            if end > i {
                sb.add("<code>" + md_escape(s[i + 1..end]) + "</code>")
                i = end + 1
                continue
            }
        }
        // **bold** or __bold__
        if (c == '*' or c == '_') and i + 1 < n and s.byte_at(i + 1) == c {
            let mark = s[i..i + 2]
            let end = s.find_from(mark, i + 2)
            if end > i + 2 {
                sb.add("<strong>" + markdown_inline(s[i + 2..end]) + "</strong>")
                i = end + 2
                continue
            }
        }
        // *italic* or _italic_ (an _ inside a word, as in snake_case, stays as it is)
        if c == '*' or (c == '_' and (i == 0 or not md_is_word_byte(s.byte_at(i - 1)))) {
            let end = s.find_from(s[i..i + 1], i + 1)
            if end > i + 1 {
                sb.add("<em>" + markdown_inline(s[i + 1..end]) + "</em>")
                i = end + 1
                continue
            }
        }
        // [text](url) and ![alt](src)
        let is_image = c == '!' and i + 1 < n and s.byte_at(i + 1) == '['
        if c == '[' or is_image {
            let open = if is_image { i + 1 } else { i }
            let close = s.find_from("](", open + 1)
            let end = if close > 0 { s.find_from(")", close + 2) } else { -1 }
            if close > 0 and end > 0 {
                let label = s[open + 1..close]
                let url = md_escape(s[close + 2..end])
                if is_image {
                    sb.add("<img src=\"" + url + "\" alt=\"" + md_escape(label) + "\">")
                } else {
                    sb.add("<a href=\"" + url + "\">" + markdown_inline(label) + "</a>")
                }
                i = end + 1
                continue
            }
        }
        sb.add(md_escape(s[i..i + 1]))
        i += 1
    }
    return sb.finish()
}

// the level (1-6) of a "# heading" line, or 0
fn md_heading_level(line: str) -> int {
    var level = 0
    while level < line.len() and line.byte_at(level) == '#' { level += 1 }
    if level == 0 or level > 6 { return 0 }
    if level < line.len() and line.byte_at(level) != ' ' { return 0 }
    return level
}

// true for a line of three or more -, * or _ (a horizontal line)
fn md_is_rule(line: str) -> bool {
    let t = line.replace(" ", "")
    if t.len() < 3 { return false }
    for ch in ["-", "*", "_"] {
        if t == ch * t.len() { return true }
    }
    return false
}

// the text of a list item and whether the list is numbered, or nil when the line is not a list item
fn md_list_item(line: str) -> (str, bool)? {
    let t = line.trim_start()
    if t.starts_with("- ") or t.starts_with("* ") or t.starts_with("+ ") { return (t[2..].trim(), false) }
    var d = 0
    while d < t.len() and t.byte_at(d).is_digit() { d += 1 }
    if d > 0 and t[d..].starts_with(". ") { return (t[d + 2..].trim(), true) }
    return nil
}

fn md_starts_block(line: str) -> bool {
    let t = line.trim_start()
    return md_heading_level(t) > 0 or t.starts_with("```") or t.starts_with(">") or md_is_rule(t) or md_list_item(t) != nil
}

// the HTML for a whole Markdown document, one block (heading, paragraph, list, ...) per line
fn markdown_to_html(text: str) -> str {
    let lines = text.replace("\r\n", "\n").split("\n")
    var out: [str] = []
    var i = 0
    while i < lines.len() {
        let line = lines[i]
        let t = line.trim()
        if t == "" {
            i += 1
            continue
        }
        // ``` code block ```
        if t.starts_with("```") {
            let lang = t[3..].trim()
            var code: [str] = []
            i += 1
            while i < lines.len() and not lines[i].trim().starts_with("```") {
                code.push(md_escape(lines[i]))
                i += 1
            }
            i += 1
            let cls = if lang == "" { "" } else { " class=\"language-" + md_escape(lang) + "\"" }
            out.push("<pre><code" + cls + ">" + "\n".join(code) + "</code></pre>")
            continue
        }
        // # heading
        let level = md_heading_level(t)
        if level > 0 {
            out.push("<h{level}>" + markdown_inline(t[level..].trim()) + "</h{level}>")
            i += 1
            continue
        }
        // --- a horizontal line
        if md_is_rule(t) {
            out.push("<hr>")
            i += 1
            continue
        }
        // > a quote (it may hold any other Markdown)
        if t.starts_with(">") {
            var quoted: [str] = []
            while i < lines.len() and lines[i].trim().starts_with(">") {
                var q = lines[i].trim()[1..]
                if q.starts_with(" ") { q = q[1..] }
                quoted.push(q)
                i += 1
            }
            out.push("<blockquote>\n" + markdown_to_html("\n".join(quoted)) + "</blockquote>")
            continue
        }
        // - a list
        if let first = md_list_item(t) {
            let numbered = first.1
            let tag = if numbered { "ol" } else { "ul" }
            var items: [str] = []
            while i < lines.len() {
                let item = md_list_item(lines[i])
                if item == nil or item!.1 != numbered { break }
                items.push("<li>" + markdown_inline(item!.0) + "</li>")
                i += 1
            }
            out.push("<{tag}>\n" + "\n".join(items) + "\n</{tag}>")
            continue
        }
        // a paragraph: lines up to a blank line or another kind of block
        var para: [str] = [t]
        i += 1
        while i < lines.len() and lines[i].trim() != "" and not md_starts_block(lines[i]) {
            para.push(lines[i].trim())
            i += 1
        }
        out.push("<p>" + markdown_inline("\n".join(para)) + "</p>")
    }
    if out.len() == 0 { return "" }
    return "\n".join(out) + "\n"
}
