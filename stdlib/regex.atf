// std/regex - regular expressions (a backtracking matcher working on bytes).
//
//   import "std/regex"
//   let re = regex_compile("(\\d+)-(\\d+)").unwrap()
//   if let m = re.find("tel 12-345") { println(m.text, m.group(1), m.group(2), m.start) }   // 12-345 12 345 4
//   println(re.is_match("no digits"))                          // false
//   println(re.replace_all("1-2 and 3-4", "$2:$1"))            // 2:1 and 4:3
//   println(regex_split(",\\s*", "a, b,c"))                    // ["a", "b", "c"]
//
// Supported: literals, . (any byte except newline), classes [a-z0-9_] and [^...], \d \w \s and their
// upper-case negations, \b \B, anchors ^ $, groups (...) and (?:...), alternation a|b, and the
// repeats * + ? {n} {n,} {n,m} (add ? after one for the lazy form). Escape a special character with \.
// Not supported: look-around, back-references and named groups.
// Text is matched byte by byte, so . matches one byte of a multi-byte character.

struct RxNode {
    kind: int          // 0 char, 1 any, 2 set, 3 sequence, 4 alternation, 5 repeat, 6 group, 7 start, 8 end, 9 word edge, 10 not word edge, 11 empty
    ch: int            // the byte of a char node, the number of a group node
    set: [bool]
    kids: [RxNode]
    min: int
    max: int           // -1 means no limit
    lazy: bool
}

fn rx_node(kind: int) -> RxNode {
    return RxNode{ kind: kind, ch: 0, set: [], kids: [], min: 0, max: 0, lazy: false }
}

// a compiled regular expression
struct Regex {
    pattern: str
    root: RxNode
    groups: int        // number of capture groups
}

// one match: the byte range [start, end), its text and the text of every group (index 0 is the whole match, "" for a group that did not take part)
struct RxMatch {
    start: int
    end: int
    text: str
    groups: [str]
}

impl RxMatch {
    // the text of group i (0 is the whole match); "" when there is no such group
    fn group(self, i: int) -> str {
        if i < 0 or i >= self.groups.len() { return "" }
        return self.groups[i]
    }
}

struct RxParser {
    p: str
    i: int
    ngroups: int
    err: str
    icase: bool
}

struct RxState {
    s: str
    caps: [int]
    end: int
}

fn rx_is_word(c: int) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

fn rx_class_set(c: byte) -> [bool] {
    let set = array_make::<bool>(256)
    for b in 0..256 {
        var hit = false
        if c == 'd' or c == 'D' { hit = b >= '0' and b <= '9' }
        if c == 'w' or c == 'W' { hit = rx_is_word(b) }
        if c == 's' or c == 'S' { hit = b == ' ' or b == 9 or b == 10 or b == 11 or b == 12 or b == 13 }
        if c == 'D' or c == 'W' or c == 'S' { hit = not hit }
        set[b] = hit
    }
    return set
}

fn rx_escape_byte(c: byte) -> int {
    if c == 'n' { return 10 }
    if c == 't' { return 9 }
    if c == 'r' { return 13 }
    return int(c)
}

fn rx_fail(ps: RxParser, msg: str) {
    if ps.err == "" { ps.err = msg + " at position {ps.i}" }
}

fn rx_peek(ps: RxParser) -> int {
    if ps.i >= ps.p.len() { return -1 }
    return int(ps.p.byte_at(ps.i))
}

fn rx_icase_set(set: [bool]) {
    for b in 'a'..='z' {
        let u = b - 32
        if set[b] or set[u] {
            set[b] = true
            set[u] = true
        }
    }
}

fn rx_char_node(ps: RxParser, c: int) -> RxNode {
    if ps.icase and ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')) {
        let n = rx_node(2)
        n.set = array_make::<bool>(256)
        n.set[c] = true
        rx_icase_set(n.set)
        return n
    }
    let n = rx_node(0)
    n.ch = c
    return n
}

fn rx_parse_class(ps: RxParser) -> RxNode {
    let n = rx_node(2)
    n.set = array_make::<bool>(256)
    var negate = false
    if rx_peek(ps) == '^' {
        negate = true
        ps.i += 1
    }
    var first = true
    var closed = false
    while ps.i < ps.p.len() {
        var c = int(ps.p.byte_at(ps.i))
        ps.i += 1
        if c == ']' and not first {
            closed = true
            break
        }
        first = false
        if c == '\\' {
            if ps.i >= ps.p.len() { break }
            let e = ps.p.byte_at(ps.i)
            ps.i += 1
            if e == 'd' or e == 'w' or e == 's' or e == 'D' or e == 'W' or e == 'S' {
                let cs = rx_class_set(e)
                for b in 0..256 {
                    if cs[b] { n.set[b] = true }
                }
                continue
            }
            c = rx_escape_byte(e)
        }
        var hi = c
        if rx_peek(ps) == '-' and ps.i + 1 < ps.p.len() and ps.p.byte_at(ps.i + 1) != ']' {
            ps.i += 1
            hi = int(ps.p.byte_at(ps.i))
            ps.i += 1
            if hi == '\\' and ps.i < ps.p.len() {
                hi = rx_escape_byte(ps.p.byte_at(ps.i))
                ps.i += 1
            }
            if hi < c {
                rx_fail(ps, "bad range in a character class")
                return n
            }
        }
        for b in c..=hi { n.set[b] = true }
    }
    if not closed {
        rx_fail(ps, "missing ] in a character class")
        return n
    }
    if ps.icase { rx_icase_set(n.set) }
    if negate {
        for b in 0..256 { n.set[b] = not n.set[b] }
    }
    return n
}

fn rx_parse_atom(ps: RxParser) -> RxNode {
    let c = int(ps.p.byte_at(ps.i))
    ps.i += 1
    if c == '(' {
        var idx = 0
        if rx_peek(ps) == '?' {
            if ps.i + 1 < ps.p.len() and ps.p.byte_at(ps.i + 1) == ':' {
                ps.i += 2
            } else {
                rx_fail(ps, "unsupported group syntax (only (?:...) is available)")
                return rx_node(11)
            }
        } else {
            ps.ngroups += 1
            idx = ps.ngroups
        }
        let inner = rx_parse_alt(ps)
        if rx_peek(ps) != ')' {
            rx_fail(ps, "missing )")
            return inner
        }
        ps.i += 1
        if idx == 0 { return inner }
        let g = rx_node(6)
        g.ch = idx
        g.kids = [inner]
        return g
    }
    if c == '[' { return rx_parse_class(ps) }
    if c == '.' { return rx_node(1) }
    if c == '^' { return rx_node(7) }
    if c == '$' { return rx_node(8) }
    if c == '*' or c == '+' or c == '?' {
        ps.i -= 1
        rx_fail(ps, "nothing to repeat")
        ps.i += 1
        return rx_node(11)
    }
    if c == '\\' {
        if ps.i >= ps.p.len() {
            rx_fail(ps, "a pattern cannot end with \\")
            return rx_node(11)
        }
        let e = ps.p.byte_at(ps.i)
        ps.i += 1
        if e == 'd' or e == 'w' or e == 's' or e == 'D' or e == 'W' or e == 'S' {
            let n = rx_node(2)
            n.set = rx_class_set(e)
            return n
        }
        if e == 'b' { return rx_node(9) }
        if e == 'B' { return rx_node(10) }
        return rx_char_node(ps, rx_escape_byte(e))
    }
    return rx_char_node(ps, c)
}

// reads {n}, {n,} or {n,m} at ps.i (which is on the {); returns false and leaves ps.i alone when it is not one
fn rx_parse_braces(ps: RxParser, n: RxNode) -> bool {
    var j = ps.i + 1
    var lo = 0
    var digits = 0
    while j < ps.p.len() and ps.p.byte_at(j) >= '0' and ps.p.byte_at(j) <= '9' {
        lo = lo * 10 + int(ps.p.byte_at(j) - '0')
        j += 1
        digits += 1
    }
    if digits == 0 or j >= ps.p.len() { return false }
    var hi = lo
    if ps.p.byte_at(j) == ',' {
        j += 1
        hi = -1
        var d2 = 0
        var v = 0
        while j < ps.p.len() and ps.p.byte_at(j) >= '0' and ps.p.byte_at(j) <= '9' {
            v = v * 10 + int(ps.p.byte_at(j) - '0')
            j += 1
            d2 += 1
        }
        if d2 > 0 { hi = v }
    }
    if j >= ps.p.len() or ps.p.byte_at(j) != '}' { return false }
    if hi >= 0 and hi < lo {
        rx_fail(ps, "the repeat \{n,m\} has m smaller than n")
        return false
    }
    n.min = lo
    n.max = hi
    ps.i = j + 1
    return true
}

fn rx_parse_seq(ps: RxParser) -> RxNode {
    let seq = rx_node(3)
    while ps.err == "" and ps.i < ps.p.len() {
        let c = ps.p.byte_at(ps.i)
        if c == '|' or c == ')' { break }
        var atom = rx_parse_atom(ps)
        if ps.err != "" { break }
        loop {
            let q = rx_peek(ps)
            let rep = rx_node(5)
            if q == '*' {
                rep.min = 0
                rep.max = -1
                ps.i += 1
            } else if q == '+' {
                rep.min = 1
                rep.max = -1
                ps.i += 1
            } else if q == '?' {
                rep.min = 0
                rep.max = 1
                ps.i += 1
            } else if q == '{' and rx_parse_braces(ps, rep) {
                // parsed
            } else {
                break
            }
            if rx_peek(ps) == '?' {
                rep.lazy = true
                ps.i += 1
            }
            rep.kids = [atom]
            atom = rep
        }
        seq.kids.push(atom)
    }
    if seq.kids.len() == 1 { return seq.kids[0] }
    return seq
}

fn rx_parse_alt(ps: RxParser) -> RxNode {
    let first = rx_parse_seq(ps)
    if rx_peek(ps) != '|' { return first }
    let alt = rx_node(4)
    alt.kids = [first]
    while rx_peek(ps) == '|' and ps.err == "" {
        ps.i += 1
        alt.kids.push(rx_parse_seq(ps))
    }
    return alt
}

// Compiles a pattern. The error text says what is wrong and where. With ignore_case, letters match in both cases.
fn regex_compile(pattern: str, ignore_case: bool = false) -> Result<Regex, str> {
    let ps = RxParser{ p: pattern, i: 0, ngroups: 0, err: "", icase: ignore_case }
    let root = rx_parse_alt(ps)
    if ps.err == "" and ps.i < pattern.len() { rx_fail(ps, "unmatched )") }
    if ps.err != "" { return Result.Err("regex \"{pattern}\": " + ps.err) }
    return Result.Ok(Regex{ pattern: pattern, root: root, groups: ps.ngroups })
}

// the compiled pattern; panics when it is not valid
fn regex(pattern: str, ignore_case: bool = false) -> Regex {
    return regex_compile(pattern, ignore_case).unwrap()
}

// ---------------------------------------------------------------- matching
fn rx_one(n: RxNode, s: str, i: int) -> bool {
    let c = s.byte_at(i)
    if n.kind == 0 { return c == n.ch }
    if n.kind == 1 { return c != 10 }
    return n.set[int(c)]
}

fn rx_accept(st: RxState, j: int) -> bool {
    st.end = j
    return true
}

fn rx_seq(kids: [RxNode], idx: int, st: RxState, i: int, k: fn(int) -> bool) -> bool {
    if idx == kids.len() { return k(i) }
    return rx_m(kids[idx], st, i, |j| rx_seq(kids, idx + 1, st, j, k))
}

fn rx_rep(n: RxNode, st: RxState, i: int, count: int, k: fn(int) -> bool) -> bool {
    let child = n.kids[0]
    let can_more = n.max < 0 or count < n.max
    if n.lazy {
        if count >= n.min and k(i) { return true }
        if can_more {
            return rx_m(child, st, i, |j| {
                if j == i and count >= n.min { return false }
                return rx_rep(n, st, j, count + 1, k)
            })
        }
        return false
    }
    if can_more {
        if rx_m(child, st, i, |j| {
            if j == i and count >= n.min { return false }
            return rx_rep(n, st, j, count + 1, k)
        }) { return true }
    }
    return count >= n.min and k(i)
}

fn rx_m(n: RxNode, st: RxState, i: int, k: fn(int) -> bool) -> bool {
    let len = st.s.len()
    let kind = n.kind
    if kind <= 2 {
        if i < len and rx_one(n, st.s, i) { return k(i + 1) }
        return false
    }
    if kind == 3 { return rx_seq(n.kids, 0, st, i, k) }
    if kind == 4 {
        for kid in n.kids {
            if rx_m(kid, st, i, k) { return true }
        }
        return false
    }
    if kind == 5 {
        let child = n.kids[0]
        if child.kind <= 2 {
            // a single byte repeated: count how many fit and try the counts one by one, no deep recursion
            var cnt = 0
            while (n.max < 0 or cnt < n.max) and i + cnt < len and rx_one(child, st.s, i + cnt) { cnt += 1 }
            if cnt < n.min { return false }
            if n.lazy {
                for c in n.min..=cnt {
                    if k(i + c) { return true }
                }
                return false
            }
            var c = cnt
            while c >= n.min {
                if k(i + c) { return true }
                c -= 1
            }
            return false
        }
        return rx_rep(n, st, i, 0, k)
    }
    if kind == 6 {
        let g = n.ch
        return rx_m(n.kids[0], st, i, |j| {
            let o0 = st.caps[g * 2]
            let o1 = st.caps[g * 2 + 1]
            st.caps[g * 2] = i
            st.caps[g * 2 + 1] = j
            if k(j) { return true }
            st.caps[g * 2] = o0
            st.caps[g * 2 + 1] = o1
            return false
        })
    }
    if kind == 7 { return i == 0 and k(i) }
    if kind == 8 { return i == len and k(i) }
    if kind == 9 or kind == 10 {
        let before = i > 0 and rx_is_word(int(st.s.byte_at(i - 1)))
        let after = i < len and rx_is_word(int(st.s.byte_at(i)))
        return ((before != after) == (kind == 9)) and k(i)
    }
    return k(i)
}

fn rx_find_at(re: Regex, s: str, from: int) -> RxMatch? {
    let st = RxState{ s: s, caps: array_make::<int>((re.groups + 1) * 2), end: 0 }
    var start = from
    while start <= s.len() {
        for c in 0..st.caps.len() { st.caps[c] = -1 }
        if rx_m(re.root, st, start, |j| rx_accept(st, j)) {
            var groups: [str] = [s[start..st.end]]
            for g in 1..=re.groups {
                if st.caps[g * 2] >= 0 {
                    groups.push(s[st.caps[g * 2]..st.caps[g * 2 + 1]])
                } else {
                    groups.push("")
                }
            }
            return RxMatch{ start: start, end: st.end, text: s[start..st.end], groups: groups }
        }
        start += 1
    }
    return nil
}

impl Regex {
    // the first match in s, or nil
    fn find(self, s: str) -> RxMatch? { return rx_find_at(self, s, 0) }

    // the first match that starts at byte position from or later, or nil
    fn find_from(self, s: str, from: int) -> RxMatch? {
        if from < 0 or from > s.len() { return nil }
        return rx_find_at(self, s, from)
    }

    // true when the pattern matches somewhere in s
    fn is_match(self, s: str) -> bool { return rx_find_at(self, s, 0) != nil }

    // true when the pattern matches the whole of s
    fn full_match(self, s: str) -> bool { return regex_anchored(self, s) }

    // all the matches, left to right, not overlapping
    fn find_all(self, s: str) -> [RxMatch] {
        var out: [RxMatch] = []
        var pos = 0
        while pos <= s.len() {
            let m = rx_find_at(self, s, pos)
            if m == nil { break }
            out.push(m!)
            if m!.end > m!.start { pos = m!.end } else { pos = m!.end + 1 }
        }
        return out
    }

    // replaces the first match; in repl, $0 is the whole match, $1 to $9 are groups and $$ is a dollar sign
    fn replace(self, s: str, repl: str) -> str {
        let m = rx_find_at(self, s, 0)
        if m == nil { return s }
        return s[0..m!.start] + rx_expand(repl, m!) + s[m!.end..]
    }

    // replaces every match (see replace for $1)
    fn replace_all(self, s: str, repl: str) -> str {
        var sb = str_builder()
        var last = 0
        for m in self.find_all(s) {
            sb.add(s[last..m.start])
            sb.add(rx_expand(repl, m))
            last = m.end
        }
        sb.add(s[last..])
        return sb.finish()
    }

    // replaces every match with whatever f returns for it
    fn replace_with(self, s: str, f: fn(RxMatch) -> str) -> str {
        var sb = str_builder()
        var last = 0
        for m in self.find_all(s) {
            sb.add(s[last..m.start])
            sb.add(f(m))
            last = m.end
        }
        sb.add(s[last..])
        return sb.finish()
    }

    // the pieces of s between the matches
    fn split(self, s: str) -> [str] {
        var out: [str] = []
        var last = 0
        for m in self.find_all(s) {
            if m.end == m.start and (m.start == 0 or m.start >= s.len()) { continue }
            out.push(s[last..m.start])
            last = m.end
        }
        out.push(s[last..])
        return out
    }
}

// true when some match of re covers the whole of s (tries the pattern at 0 with a required end)
fn regex_anchored(re: Regex, s: str) -> bool {
    let st = RxState{ s: s, caps: array_make::<int>((re.groups + 1) * 2), end: 0 }
    for c in 0..st.caps.len() { st.caps[c] = -1 }
    return rx_m(re.root, st, 0, |j| j == s.len())
}

fn rx_expand(repl: str, m: RxMatch) -> str {
    if not repl.contains("$") { return repl }
    var sb = str_builder()
    var i = 0
    while i < repl.len() {
        let c = repl.byte_at(i)
        if c == '$' and i + 1 < repl.len() {
            let d = repl.byte_at(i + 1)
            if d == '$' {
                sb.add("$")
                i += 2
                continue
            }
            if d >= '0' and d <= '9' {
                sb.add(m.group(int(d - '0')))
                i += 2
                continue
            }
        }
        sb.add_byte(c)
        i += 1
    }
    return sb.finish()
}

// true when the pattern matches somewhere in s; panics when the pattern is not valid
fn regex_match(pattern: str, s: str) -> bool { return regex(pattern).is_match(s) }

// the pieces of s between the matches of the pattern; panics when the pattern is not valid
fn regex_split(pattern: str, s: str) -> [str] { return regex(pattern).split(s) }

// replaces every match of the pattern in s (see Regex.replace for $1); panics when the pattern is not valid
fn regex_replace(pattern: str, s: str, repl: str) -> str { return regex(pattern).replace_all(s, repl) }

// the text of every match of the pattern in s; panics when the pattern is not valid
fn regex_find_all(pattern: str, s: str) -> [str] {
    var out: [str] = []
    for m in regex(pattern).find_all(s) { out.push(m.text) }
    return out
}
