fn main() {
    let t = clock()
    var a: [int] = []
    var seed = 12345
    for i in 0..2000000 {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        a.push(seed)
    }
    a.sort()
    println(a[0], a[1000000], a[1999999])
    var m: {int: int} = {}
    for i in 0..1000000 { m[i * 7] = i }
    var s = 0
    for i in 0..1000000 { s += m[i * 7] }
    println(s, m.len())
    var sb = ""
    for i in 0..20000 { sb = sb + "x" }
    println(sb.len())
    println("time", clock() - t)
}
