// bigint.atf - arbitrary precision factorials and powers using arrays of digits.
// Shows: a struct with operator overloading (op_mul), digit arrays stored little-endian,
//        carry propagation, to_str, loops.
// Run:   python run_atf.py run examples/bigint.atf

// a non negative big integer; digits[0] is the least significant decimal digit
struct Big {
    digits: [int]
}

impl Big {
    fn from_int(n: int) -> Big {
        if n == 0 { return Big([0]) }
        var d: [int] = []
        var m = n
        while m > 0 {
            d.push(m % 10)
            m = m / 10
        }
        return Big(d)
    }

    fn mul_small(self, k: int) -> Big {
        var out: [int] = []
        var carry = 0
        for d in self.digits {
            let v = d * k + carry
            out.push(v % 10)
            carry = v / 10
        }
        while carry > 0 {
            out.push(carry % 10)
            carry = carry / 10
        }
        return Big(out)
    }

    fn op_add(self, o: Big) -> Big {
        var out: [int] = []
        var carry = 0
        let n = max(self.digits.len(), o.digits.len())
        for i in 0..n {
            let v = self.digits.get(i, 0) + o.digits.get(i, 0) + carry
            out.push(v % 10)
            carry = v / 10
        }
        if carry > 0 { out.push(carry) }
        return Big(out)
    }

    fn op_mul(self, o: Big) -> Big {
        let out = array_make::<int>(self.digits.len() + o.digits.len())
        for i in 0..self.digits.len() {
            var carry = 0
            for j in 0..o.digits.len() {
                let v = out[i + j] + self.digits[i] * o.digits[j] + carry
                out[i + j] = v % 10
                carry = v / 10
            }
            var k = i + o.digits.len()
            while carry > 0 {
                let v = out[k] + carry
                out[k] = v % 10
                carry = v / 10
                k += 1
            }
        }
        while out.len() > 1 and out.last() == 0 { out.pop() }
        return Big(out)
    }

    fn digit_sum(self) -> int {
        return self.digits.sum()
    }

    fn to_str(self) -> str {
        var sb = str_builder()
        var i = self.digits.len() - 1
        while i >= 0 {
            sb.add(str(self.digits[i]))
            i -= 1
        }
        return sb.finish()
    }
}

fn factorial(n: int) -> Big {
    var r = Big.from_int(1)
    for i in 2..=n { r = r.mul_small(i) }
    return r
}

fn power(base: int, exp: int) -> Big {
    var r = Big.from_int(1)
    let b = Big.from_int(base)
    for i in 0..exp { r = r * b }
    return r
}

fn main() {
    for n in [5, 10, 20, 25] {
        println("{n}! = {factorial(n)}")
    }
    let f100 = factorial(100)
    println("100! has {f100.digits.len()} digits")
    println("100! = {f100}")
    println("digit sum of 100! = {f100.digit_sum()}")

    println("2^100  = {power(2, 100)}")
    println("2^1000 has {power(2, 1000).digits.len()} digits, digit sum {power(2, 1000).digit_sum()}")

    // add and multiply two big numbers
    let a = factorial(30)
    let b = power(7, 40)
    println("30! + 7^40 = {a + b}")
    println("30! * 7^40 = {a * b}")

    // a Fibonacci number far beyond the range of int, using big addition
    var x = Big.from_int(0)
    var y = Big.from_int(1)
    for i in 0..200 {
        let t = x + y
        x = y
        y = t
    }
    println("fib(200) = {x}")
}
