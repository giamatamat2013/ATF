// Hotbar slots are the first nine inventory slots; 0 means empty.
fn hotbar_block(slot: int) -> int => slot_items[slot]

fn stack_limit(item: int) -> int => if item >= 46 and item <= 51 { 1 } else { 64 }

// Keeps the 36 visible slots in step with the item counts: items you have appear in the
// first free slot (hotbar first), stacks split at 64 and items you lost disappear.
fn sync_slots() {
    for id in 1..inventory.len() {
        let lim = stack_limit(id)
        let need = if inventory[id] > 0 { (inventory[id] + lim - 1) / lim } else { 0 }
        var have = 0
        for s in 0..36 { if slot_items[s] == id { have += 1 } }
        var s = 35
        while have > need and s >= 0 {
            if slot_items[s] == id {
                slot_items[s] = 0
                have -= 1
            }
            s -= 1
        }
        while have < need {
            var free = -1
            for k in 0..36 {
                if slot_items[k] == 0 { free = k; break }
            }
            if free < 0 { break }
            slot_items[free] = id
            have += 1
        }
    }
    if inv_held >= 0 and slot_items[inv_held] <= 0 { inv_held = -1 }
}

fn slot_count(slot: int) -> int {
    let id = slot_items[slot]
    if id <= 0 { return 0 }
    let lim = stack_limit(id)
    var order = 0
    for k in 0..slot {
        if slot_items[k] == id { order += 1 }
    }
    return min(lim, inventory[id] - order * lim)
}

// Moves an item into the selected hotbar slot (or selects it when it is already there).
fn select_item(item: int) {
    for s in 0..9 {
        if slot_items[s] == item {
            selected_slot = s
            return
        }
    }
    for s in 9..36 {
        if slot_items[s] == item {
            slot_items[s] = slot_items[selected_slot]
            slot_items[selected_slot] = item
            return
        }
    }
}

fn close_inventory() {
    for g in 0..9 {
        if inv_grid[g] > 0 {
            inventory[inv_grid[g]] += 1
            inv_grid[g] = 0
        }
    }
    inv_held = -1
}

fn class_code(item: int) -> str {
    if item == 4 or item == 38 { return "L" }
    if item == 11 { return "P" }
    if item == 45 { return "S" }
    if item == 26 { return "C" }
    if item == 33 { return "I" }
    if item == 19 { return "D" }
    if item == 15 { return "O" }
    if item == 6 { return "A" }
    if item == 16 { return "G" }
    return "?"
}

fn flip_pattern(p: str) -> str {
    var rows: [str] = []
    for r in p.split("/") { rows.push(r.reverse()) }
    return "/".join(rows)
}

// Shaped recipes written as rows of material letters ("." is an empty cell).
fn recipe_lookup(p: str) -> (int, int) {
    if p == "L" { return (11, 4) }
    if p == "P/P" { return (45, 4) }
    if p == "PP/PP" { return (14, 1) }
    if p == "O/S" { return (29, 4) }
    if p == "CCC/C.C/CCC" { return (30, 1) }
    if p == "PPP/.S./.S." { return (46, 1) }
    if p == "CCC/.S./.S." { return (47, 1) }
    if p == "III/.S./.S." { return (48, 1) }
    if p == "DDD/.S./.S." { return (49, 1) }
    if p == "PP/PS/.S" { return (50, 1) }
    if p == "P/S/S" { return (51, 1) }
    if p == "OO/G." { return (20, 1) }
    if p == "CC/CO" { return (12, 4) }
    if p == "AA/O." { return (13, 2) }
    return (0, 0)
}

fn grid_pattern() -> str {
    var min_x = 3
    var max_x = -1
    var min_y = 3
    var max_y = -1
    for g in 0..9 {
        if inv_grid[g] > 0 {
            min_x = min(min_x, g % 3)
            max_x = max(max_x, g % 3)
            min_y = min(min_y, g / 3)
            max_y = max(max_y, g / 3)
        }
    }
    if max_x < 0 { return "" }
    var rows: [str] = []
    for y in min_y..=max_y {
        var row = ""
        for x in min_x..=max_x {
            let item = inv_grid[y * 3 + x]
            row = row + (if item == 0 { "." } else { class_code(item) })
        }
        rows.push(row)
    }
    return "/".join(rows)
}

fn inv_result() -> (int, int) {
    let p = grid_pattern()
    if p.len() == 0 { return (0, 0) }
    let (item, n) = recipe_lookup(p)
    if item > 0 { return (item, n) }
    return recipe_lookup(flip_pattern(p))
}

// Upper-left of a slot's 16x16 item area in panel units (a 176x166 panel, like the original).
fn inv_target_pos(t: int, big: bool) -> (int, int) {
    if t < 9 { return (8 + 18 * t, 142) }
    if t < 36 { return (8 + 18 * ((t - 9) % 9), 84 + 18 * ((t - 9) / 9)) }
    if t >= 100 and t < 109 {
        let g = t - 100
        if big { return (30 + 18 * (g % 3), 17 + 18 * (g / 3)) }
        return (98 + 18 * (g % 3), 18 + 18 * (g / 3))
    }
    if big { return (124, 35) }
    return (154, 28)
}

fn grid_cell_active(g: int) -> bool => inv_big or (g % 3 < 2 and g / 3 < 2)

fn inv_hit(x: int, y: int) -> int {
    var targets: [int] = []
    for t in 0..36 { targets.push(t) }
    for g in 0..9 {
        if grid_cell_active(g) { targets.push(100 + g) }
    }
    targets.push(200)
    for t in targets {
        let (ux, uy) = inv_target_pos(t, inv_big)
        let sx = inv_px + ux * inv_s
        let sy = inv_py + uy * inv_s
        if x >= sx - inv_s and x < sx + 17 * inv_s and y >= sy - inv_s and y < sy + 17 * inv_s { return t }
    }
    return -1
}

fn craft_from_grid() {
    let (item, n) = inv_result()
    if item == 0 { return }
    let durability = [59, 131, 250, 1561, 59, 59]
    if item >= 46 and item <= 51 and inventory[item] == 0 { tool_durability[item - 46] = durability[item - 46] }
    inventory[item] += n
    blocks_crafted += n
    // Every cell gave one item; refill the cells from the inventory so crafting can repeat.
    for g in 0..9 {
        let used = inv_grid[g]
        if used > 0 {
            if inventory[used] > 0 {
                inventory[used] -= 1
            } else {
                inv_grid[g] = 0
            }
        }
    }
    status_message = "Crafted {n} {block_name(item)}"
    status_timer = 1.4
}

fn handle_inventory_click(x: int, y: int) {
    let t = inv_hit(x, y)
    if t < 0 {
        inv_held = -1
    } else if t < 36 {
        if inv_held < 0 {
            if slot_items[t] > 0 { inv_held = t }
        } else if inv_held == t {
            inv_held = -1
        } else {
            let other = slot_items[inv_held]
            slot_items[inv_held] = slot_items[t]
            slot_items[t] = other
            inv_held = -1
        }
    } else if t >= 100 and t < 109 {
        let g = t - 100
        if inv_held >= 0 and slot_items[inv_held] > 0 {
            let item = slot_items[inv_held]
            if inv_grid[g] != item {
                if inv_grid[g] > 0 { inventory[inv_grid[g]] += 1 }
                inv_grid[g] = item
                inventory[item] -= 1
            }
        } else if inv_grid[g] > 0 {
            inventory[inv_grid[g]] += 1
            inv_grid[g] = 0
        }
    } else if t == 200 {
        craft_from_grid()
    }
    sync_slots()
}

