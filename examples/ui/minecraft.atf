// ATF 1.2.0
// BLOCKWORLD — a small first-person voxel sandbox written entirely in ATF.
// Controls: WASD move, mouse look, Space jump, Shift sprint,
// left mouse mine, right mouse place, 1-6 select blocks, Esc release mouse.

import "std/ui"

const WORLD_W = 48
const WORLD_H = 22
const WORLD_D = 48
const RENDER_W = 256
const RENDER_H = 144
const FRAME_TIME_MS = 30
const PLAYER_RADIUS = 0.27
const PLAYER_HEIGHT = 1.70
const RAY_STEP = 0.12
const VIEW_DISTANCE = 20.0
const PI_VALUE = 3.141592653589793

var world: [int] = array_make::<int>(WORLD_W * WORLD_H * WORLD_D)
var frame_pixels: [int] = array_make::<int>(RENDER_W * RENDER_H)

var player_x = 24.5
var player_y = 8.0
var player_z = 24.5
var velocity_y = 0.0
var grounded = false
var yaw = 0.0
var pitch = 0.0
var camera_x = 24.5
var camera_y = 9.62
var camera_z = 24.5

var forward_x = 0.0
var forward_y = 0.0
var forward_z = 1.0
var right_x = 1.0
var right_y = 0.0
var right_z = 0.0
var up_x = 0.0
var up_y = 1.0
var up_z = 0.0

var selected_block = 1
var mouse_captured = false
var timer_started = false
var previous_escape = false
var previous_left = false
var previous_right = false

fn sin_atf(value: float) -> float {
    var x = value
    while x > PI_VALUE { x -= 2.0 * PI_VALUE }
    while x < -PI_VALUE { x += 2.0 * PI_VALUE }
    if x > PI_VALUE / 2.0 {
        x = PI_VALUE - x
    } else if x < -PI_VALUE / 2.0 {
        x = -PI_VALUE - x
    }
    let x2 = x * x
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x4 * x4
    let x10 = x8 * x2
    return x * (1.0 - x2 / 6.0 + x4 / 120.0 - x6 / 5040.0 + x8 / 362880.0 - x10 / 39916800.0)
}

fn cos_atf(value: float) -> float => sin_atf(PI_VALUE / 2.0 - value)

fn pack_rgb(red: int, green: int, blue: int) -> int {
    let r = clamp(red, 0, 255)
    let g = clamp(green, 0, 255)
    let b = clamp(blue, 0, 255)
    return (r << 16) | (g << 8) | b
}

fn block_index(x: int, y: int, z: int) -> int => (y * WORLD_D + z) * WORLD_W + x

fn terrain_height(x: int, z: int) -> int {
    let pattern = (x / 7 + z / 8 + (x * z) / 160) % 4
    return 4 + pattern
}

fn get_block(x: int, y: int, z: int) -> int {
    if y < 0 { return 7 }
    if x < 0 or x >= WORLD_W or z < 0 or z >= WORLD_D { return 3 }
    if y >= WORLD_H { return 0 }
    return world[block_index(x, y, z)]
}

fn set_block(x: int, y: int, z: int, block: int) {
    if x < 0 or x >= WORLD_W or z < 0 or z >= WORLD_D { return }
    if y < 0 or y >= WORLD_H { return }
    world[block_index(x, y, z)] = block
}

fn build_tree(x: int, z: int, height: int) {
    for y in (height + 1)..=(height + 4) {
        set_block(x, y, z, 4)
    }
    for y in (height + 3)..=(height + 5) {
        for tx in (x - 2)..=(x + 2) {
            for tz in (z - 2)..=(z + 2) {
                let distance = abs(tx - x) + abs(tz - z)
                let limit = if y == height + 5 { 2 } else { 4 }
                if distance <= limit and get_block(tx, y, tz) == 0 {
                    set_block(tx, y, tz, 5)
                }
            }
        }
    }
}

fn create_world() {
    for x in 0..WORLD_W {
        for z in 0..WORLD_D {
            let h = terrain_height(x, z)
            for y in 0..=h {
                var block = 3
                if y == 0 {
                    block = 7
                } else if y == h {
                    block = 1
                } else if y >= h - 2 {
                    block = 2
                }
                set_block(x, y, z, block)
            }
        }
    }

    let center_x = WORLD_W / 2
    let center_z = WORLD_D / 2
    for x in 3..(WORLD_W - 3) {
        for z in 3..(WORLD_D - 3) {
            let far_from_spawn = abs(x - center_x) >= 5 or abs(z - center_z) >= 5
            if far_from_spawn and (x * 23 + z * 41 + x * z) % 71 == 9 {
                let h = terrain_height(x, z)
                build_tree(x, z, h)
            }
        }
    }

    player_x = float(center_x) + 0.5
    player_z = float(center_z) + 0.5
    player_y = float(terrain_height(center_x, center_z) + 1)
    velocity_y = 0.0
    grounded = true
    yaw = 0.0
    pitch = 0.0
    update_camera()
}

fn update_camera() {
    let sy = sin_atf(yaw)
    let cy = cos_atf(yaw)
    let sp = sin_atf(pitch)
    let cp = cos_atf(pitch)

    forward_x = sy * cp
    forward_y = sp
    forward_z = cy * cp

    right_x = cy
    right_y = 0.0
    right_z = -sy

    up_x = -sy * sp
    up_y = cp
    up_z = -cy * sp

    camera_x = player_x
    camera_y = player_y + 1.58
    camera_z = player_z
}

fn collides_body(x: float, feet_y: float, z: float) -> bool {
    let min_x = int(floor(x - PLAYER_RADIUS))
    let max_x = int(floor(x + PLAYER_RADIUS))
    let min_y = int(floor(feet_y + 0.01))
    let max_y = int(floor(feet_y + PLAYER_HEIGHT - 0.02))
    let min_z = int(floor(z - PLAYER_RADIUS))
    let max_z = int(floor(z + PLAYER_RADIUS))

    for bx in min_x..=max_x {
        for by in min_y..=max_y {
            for bz in min_z..=max_z {
                if get_block(bx, by, bz) != 0 { return true }
            }
        }
    }
    return false
}

fn move_horizontal(dx: float, dz: float) {
    let next_x = player_x + dx
    if not collides_body(next_x, player_y, player_z) {
        player_x = next_x
    } else if grounded and not collides_body(next_x, player_y + 1.0, player_z) {
        player_x = next_x
        player_y += 1.0
    }

    let next_z = player_z + dz
    if not collides_body(player_x, player_y, next_z) {
        player_z = next_z
    } else if grounded and not collides_body(player_x, player_y + 1.0, next_z) {
        player_z = next_z
        player_y += 1.0
    }
}

fn trace_ray(dx0: float, dy0: float, dz0: float, max_distance: float) -> (int, int, int, int, int, int, int, float) {
    let length = sqrt(dx0 * dx0 + dy0 * dy0 + dz0 * dz0)
    let dx = dx0 / length
    let dy = dy0 / length
    let dz = dz0 / length

    var previous_x = int(floor(camera_x))
    var previous_y = int(floor(camera_y))
    var previous_z = int(floor(camera_z))
    var t = 0.08

    while t < max_distance {
        let wx = camera_x + dx * t
        let wy = camera_y + dy * t
        let wz = camera_z + dz * t
        let bx = int(floor(wx))
        let by = int(floor(wy))
        let bz = int(floor(wz))
        let block = get_block(bx, by, bz)
        if block != 0 {
            return (block, bx, by, bz, previous_x, previous_y, previous_z, t)
        }
        previous_x = bx
        previous_y = by
        previous_z = bz
        t += RAY_STEP
    }
    return (0, -1, -1, -1, -1, -1, -1, max_distance)
}

fn face_from_hit(bx: int, by: int, bz: int, px: int, py: int, pz: int, dx: float, dy: float, dz: float) -> int {
    if by != py {
        if dy < 0.0 { return 0 }
        return 3
    }
    if bx != px {
        if dx > 0.0 { return 1 }
        return 2
    }
    if dz > 0.0 { return 1 }
    return 2
}

fn color_for_block(block: int, face: int, bx: int, by: int, bz: int, sample_y: float, distance: float) -> int {
    var red = 110
    var green = 110
    var blue = 110

    if block == 1 {
        if face == 0 {
            red = 88
            green = 169
            blue = 66
        } else if sample_y - float(by) > 0.72 {
            red = 83
            green = 151
            blue = 57
        } else {
            red = 126
            green = 86
            blue = 50
        }
    } else if block == 2 {
        red = 132
        green = 88
        blue = 52
    } else if block == 3 {
        red = 124
        green = 128
        blue = 134
    } else if block == 4 {
        if face == 0 {
            red = 174
            green = 128
            blue = 73
        } else {
            red = 137
            green = 94
            blue = 53
        }
    } else if block == 5 {
        red = 60
        green = 137
        blue = 56
    } else if block == 6 {
        red = 222
        green = 205
        blue = 128
    } else {
        red = 54
        green = 56
        blue = 61
    }

    let variation = (bx * 17 + by * 31 + bz * 13) % 9 - 4
    red = clamp(red + variation, 0, 255)
    green = clamp(green + variation, 0, 255)
    blue = clamp(blue + variation, 0, 255)

    var light = 0.82
    if face == 0 {
        light = 1.0
    } else if face == 1 {
        light = 0.82
    } else if face == 2 {
        light = 0.68
    } else {
        light = 0.48
    }
    let distance_light = clamp(1.0 - distance * 0.012, 0.58, 1.0)
    let factor = light * distance_light
    red = int(float(red) * factor)
    green = int(float(green) * factor)
    blue = int(float(blue) * factor)

    let fog = clamp((distance - 9.0) / 14.0, 0.0, 0.64)
    red = int(float(red) * (1.0 - fog) + 143.0 * fog)
    green = int(float(green) * (1.0 - fog) + 193.0 * fog)
    blue = int(float(blue) * (1.0 - fog) + 229.0 * fog)
    return pack_rgb(red, green, blue)
}

fn sky_color(ray_y: float) -> int {
    let t = clamp((ray_y + 0.15) / 0.95, 0.0, 1.0)
    let red = int(114.0 + 43.0 * t)
    let green = int(181.0 + 48.0 * t)
    let blue = int(225.0 + 27.0 * t)
    return pack_rgb(red, green, blue)
}

fn block_ui_color(block: int) -> int {
    if block == 1 { return rgb(88, 169, 66) }
    if block == 2 { return rgb(132, 88, 52) }
    if block == 3 { return rgb(124, 128, 134) }
    if block == 4 { return rgb(137, 94, 53) }
    if block == 5 { return rgb(60, 137, 56) }
    if block == 6 { return rgb(222, 205, 128) }
    return rgb(54, 56, 61)
}

fn block_name(block: int) -> str {
    if block == 1 { return "Grass" }
    if block == 2 { return "Dirt" }
    if block == 3 { return "Stone" }
    if block == 4 { return "Wood" }
    if block == 5 { return "Leaves" }
    if block == 6 { return "Sand" }
    return "Bedrock"
}

fn overlaps_player(bx: int, by: int, bz: int) -> bool {
    let overlap_x = float(bx) < player_x + PLAYER_RADIUS and float(bx + 1) > player_x - PLAYER_RADIUS
    let overlap_z = float(bz) < player_z + PLAYER_RADIUS and float(bz + 1) > player_z - PLAYER_RADIUS
    let overlap_y = float(by) < player_y + PLAYER_HEIGHT and float(by + 1) > player_y + 0.02
    return overlap_x and overlap_y and overlap_z
}

fn handle_block_action(left_now: bool, right_now: bool) {
    if left_now and not previous_left and mouse_captured {
        let (block, bx, by, bz, _, _, _, _) = trace_ray(forward_x, forward_y, forward_z, 6.0)
        if block != 0 and block != 7 and bx >= 0 {
            set_block(bx, by, bz, 0)
        }
    }

    if right_now and not previous_right and mouse_captured {
        let (block, bx, by, bz, ax, ay, az, _) = trace_ray(forward_x, forward_y, forward_z, 6.0)
        if block != 0 and bx >= 0 and ax >= 0 and get_block(ax, ay, az) == 0 and not overlaps_player(ax, ay, az) {
            set_block(ax, ay, az, selected_block)
        }
    }

    previous_left = left_now
    previous_right = right_now
}

fn game_tick() {
    let escape_now = ui_key_down("escape")
    if escape_now and not previous_escape {
        mouse_captured = not mouse_captured
        ui_mouse_capture(mouse_captured)
    }
    previous_escape = escape_now

    let left_now = ui_mouse_held(0)
    let right_now = ui_mouse_held(1)
    if not mouse_captured {
        if left_now or right_now {
            mouse_captured = true
            ui_mouse_capture(true)
            previous_left = left_now
            previous_right = right_now
        }
    }

    if mouse_captured {
        let (mouse_dx, mouse_dy) = ui_mouse_delta()
        yaw += float(mouse_dx) * 0.0028
        pitch -= float(mouse_dy) * 0.0025
        pitch = clamp(pitch, -1.35, 1.35)
        while yaw > PI_VALUE { yaw -= 2.0 * PI_VALUE }
        while yaw < -PI_VALUE { yaw += 2.0 * PI_VALUE }
    }

    if ui_key_down("1") { selected_block = 1 }
    if ui_key_down("2") { selected_block = 2 }
    if ui_key_down("3") { selected_block = 3 }
    if ui_key_down("4") { selected_block = 4 }
    if ui_key_down("5") { selected_block = 5 }
    if ui_key_down("6") { selected_block = 6 }

    if collides_body(player_x, player_y - 0.06, player_z) {
        grounded = true
        if velocity_y < 0.0 {
            velocity_y = 0.0
            player_y = float(floor(player_y - 0.06)) + 1.0
        }
    } else {
        grounded = false
    }

    if ui_key_down("space") and grounded {
        velocity_y = 7.4
        grounded = false
    }

    var move_x = 0.0
    var move_z = 0.0
    let flat_forward_x = sin_atf(yaw)
    let flat_forward_z = cos_atf(yaw)
    let flat_right_x = cos_atf(yaw)
    let flat_right_z = -sin_atf(yaw)

    if ui_key_down("w") { move_x += flat_forward_x; move_z += flat_forward_z }
    if ui_key_down("s") { move_x -= flat_forward_x; move_z -= flat_forward_z }
    if ui_key_down("d") { move_x += flat_right_x; move_z += flat_right_z }
    if ui_key_down("a") { move_x -= flat_right_x; move_z -= flat_right_z }

    let move_length = sqrt(move_x * move_x + move_z * move_z)
    if move_length > 0.001 {
        var speed = 4.2
        if ui_key_down("shift") { speed = 6.5 }
        move_x = move_x / move_length * speed * 0.03
        move_z = move_z / move_length * speed * 0.03
        move_horizontal(move_x, move_z)
    }

    if not grounded {
        velocity_y -= 18.0 * 0.03
        let next_y = player_y + velocity_y * 0.03
        if collides_body(player_x, next_y, player_z) {
            if velocity_y <= 0.0 {
                player_y = float(floor(next_y)) + 1.0
                grounded = true
            } else {
                player_y = float(floor(next_y + PLAYER_HEIGHT)) - PLAYER_HEIGHT
            }
            velocity_y = 0.0
        } else {
            player_y = next_y
        }
    } else {
        velocity_y = 0.0
    }

    update_camera()
    handle_block_action(left_now, right_now)
}

fn draw_hud(c: Canvas) {
    c.text(18, 14, "ATF BLOCKWORLD", rgb(255, 255, 255), 20, true)
    c.text(18, 40, "WASD move  |  Mouse look  |  SPACE jump  |  SHIFT sprint", rgb(235, 242, 250), 14, false)
    c.text(18, 60, "LMB mine  |  RMB place  |  1-6 select block  |  ESC release mouse", rgb(235, 242, 250), 14, false)

    c.text(18, c.h - 28, "XYZ  {int(floor(player_x))}, {int(floor(player_y))}, {int(floor(player_z))}", rgb(245, 245, 245), 14, true)
    c.text(c.w - 185, c.h - 28, "BLOCK: {block_name(selected_block)}", rgb(245, 245, 245), 14, true)

    let slot_size = 38
    let gap = 5
    let total_width = 6 * slot_size + 5 * gap
    let start_x = (c.w - total_width) / 2
    let bar_y = c.h - 62
    c.rect(start_x - 9, bar_y - 9, total_width + 18, slot_size + 18, rgba(20, 23, 29, 0.78))
    c.outline(start_x - 9, bar_y - 9, total_width + 18, slot_size + 18, 2, 1, rgb(95, 105, 117))

    for i in 0..6 {
        let x = start_x + i * (slot_size + gap)
        c.rect(x, bar_y, slot_size, slot_size, rgb(47, 52, 60))
        c.rect(x + 7, bar_y + 7, slot_size - 14, slot_size - 14, block_ui_color(i + 1))
        let border_color = if selected_block == i + 1 { rgb(255, 220, 79) } else { rgb(117, 128, 141) }
        let border_width = if selected_block == i + 1 { 3 } else { 1 }
        c.outline(x, bar_y, slot_size, slot_size, 1, border_width, border_color)
        c.text(x + 3, bar_y - 18, str(i + 1), rgb(255, 255, 255), 13, true)
    }

    let center_x = c.w / 2
    let center_y = c.h / 2
    c.line(center_x - 8, center_y, center_x - 3, center_y, 2, rgb(255, 255, 255))
    c.line(center_x + 3, center_y, center_x + 8, center_y, 2, rgb(255, 255, 255))
    c.line(center_x, center_y - 8, center_x, center_y - 3, 2, rgb(255, 255, 255))
    c.line(center_x, center_y + 3, center_x, center_y + 8, 2, rgb(255, 255, 255))

    if not mouse_captured {
        c.rect(center_x - 126, center_y + 28, 252, 42, rgba(15, 18, 24, 0.86))
        c.outline(center_x - 126, center_y + 28, 252, 42, 4, 2, rgb(255, 220, 79))
        c.text(center_x - 89, center_y + 39, "CLICK TO RESUME", rgb(255, 226, 105), 18, true)
    }
}

fn draw_game(c: Canvas) {
    let aspect_x = 1.20
    let aspect_y = 0.68

    for y in 0..RENDER_H {
        let screen_y = (1.0 - (float(y) + 0.5) * 2.0 / float(RENDER_H)) * aspect_y
        for x in 0..RENDER_W {
            let screen_x = ((float(x) + 0.5) * 2.0 / float(RENDER_W) - 1.0) * aspect_x
            let dx = forward_x + right_x * screen_x + up_x * screen_y
            let dy = forward_y + right_y * screen_x + up_y * screen_y
            let dz = forward_z + right_z * screen_x + up_z * screen_y
            let (block, bx, by, bz, px, py, pz, distance) = trace_ray(dx, dy, dz, VIEW_DISTANCE)
            var color = sky_color(dy)
            if block != 0 {
                let face = face_from_hit(bx, by, bz, px, py, pz, dx, dy, dz)
                let sample_y = camera_y + dy * distance
                color = color_for_block(block, face, bx, by, bz, sample_y, distance)
            } else {
                let ray_length = sqrt(dx * dx + dy * dy + dz * dz)
                let ndx = dx / ray_length
                let ndy = dy / ray_length
                let ndz = dz / ray_length
                let sun_dot = ndx * -0.30 + ndy * 0.48 + ndz * 0.82
                if sun_dot > 0.994 { color = pack_rgb(255, 244, 205) }
            }
            frame_pixels[y * RENDER_W + x] = color
        }
    }

    c.pixels_smooth(0, 0, c.w, c.h, frame_pixels, RENDER_W, RENDER_H)
    draw_hud(c)
}

fn view() -> Node {
    if not timer_started {
        timer_started = true
        mouse_captured = true
        ui_mouse_capture(true)
        ui_every(FRAME_TIME_MS, game_tick)
    }
    return canvas(|c| { draw_game(c) }).grow()
}

fn main() {
    create_world()
    ui_run("ATF Blockworld", 1100, 680, view)
}
