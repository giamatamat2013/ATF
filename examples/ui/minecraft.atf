// ATF 1.2.0 — BLOCKWORLD ULTRA
// First-person voxel sandbox with faster voxel DDA, smooth rendering,
// terrain, water, ores, day/night, minimap and save/load.
// Controls: WASD move, mouse look, Space jump, Shift sprint,
// left mouse mine, right mouse place, 1-8 hotbar, M minimap,
// F3 debug, F5 save, F9 load, Esc release mouse.

import "std/ui"

const WORLD_W = 64
const WORLD_H = 28
const WORLD_D = 64
const RENDER_W = 480
const RENDER_H = 300
const FRAME_TIME_MS = 30
const PLAYER_RADIUS = 0.27
const PLAYER_HEIGHT = 1.70
const VIEW_DISTANCE = 28.0
const PI_VALUE = 3.141592653589793

var world: [int] = array_make::<int>(WORLD_W * WORLD_H * WORLD_D)
var frame_pixels: [int] = array_make::<int>(RENDER_W * RENDER_H)

var player_x = 24.5
var player_y = 8.0
var player_z = 24.5
var velocity_y = 0.0
var grounded = false
var yaw = 0.0
var pitch = 0.0
var camera_x = 24.5
var camera_y = 9.62
var camera_z = 24.5
var camera_underwater = false

var forward_x = 0.0
var forward_y = 0.0
var forward_z = 1.0
var right_x = 1.0
var right_y = 0.0
var right_z = 0.0
var up_x = 0.0
var up_y = 1.0
var up_z = 0.0

var selected_block = 1
var mouse_captured = false
var timer_started = false
var previous_escape = false
var previous_left = false
var previous_right = false
var previous_m = false
var previous_f3 = false
var previous_f5 = false
var previous_f9 = false
var show_map = false
var show_debug = false
var status_message = "Welcome to Blockworld Ultra"
var status_timer = 6.0
var game_time = 0.0
var day_light = 1.0
var fps_value = 0.0
var last_tick_time = 0.0
var blocks_mined = 0
var blocks_placed = 0

fn sin_atf(value: float) -> float {
    var x = value
    while x > PI_VALUE { x -= 2.0 * PI_VALUE }
    while x < -PI_VALUE { x += 2.0 * PI_VALUE }
    if x > PI_VALUE / 2.0 {
        x = PI_VALUE - x
    } else if x < -PI_VALUE / 2.0 {
        x = -PI_VALUE - x
    }
    let x2 = x * x
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x4 * x4
    let x10 = x8 * x2
    return x * (1.0 - x2 / 6.0 + x4 / 120.0 - x6 / 5040.0 + x8 / 362880.0 - x10 / 39916800.0)
}

fn cos_atf(value: float) -> float => sin_atf(PI_VALUE / 2.0 - value)

fn pack_rgb(red: int, green: int, blue: int) -> int {
    let r = clamp(red, 0, 255)
    let g = clamp(green, 0, 255)
    let b = clamp(blue, 0, 255)
    return (r << 16) | (g << 8) | b
}

fn block_index(x: int, y: int, z: int) -> int => (y * WORLD_D + z) * WORLD_W + x

fn terrain_height(x: int, z: int) -> int {
    // Several low-frequency waves form broad hills instead of a checkerboard.
    let broad = sin_atf(float(x) * 0.105) * 2.4 + cos_atf(float(z) * 0.12) * 2.1
    let rolling = sin_atf(float(x + z) * 0.19) * 1.4 + cos_atf(float(x - z) * 0.16) * 1.0
    return clamp(7 + int(broad + rolling), 3, 13)
}

fn get_block(x: int, y: int, z: int) -> int {
    if y < 0 { return 7 }
    if x < 0 or x >= WORLD_W or z < 0 or z >= WORLD_D { return 3 }
    if y >= WORLD_H { return 0 }
    return world[block_index(x, y, z)]
}

fn set_block(x: int, y: int, z: int, block: int) {
    if x < 0 or x >= WORLD_W or z < 0 or z >= WORLD_D { return }
    if y < 0 or y >= WORLD_H { return }
    world[block_index(x, y, z)] = block
}

fn build_tree(x: int, z: int, height: int) {
    for y in (height + 1)..=(height + 4) {
        set_block(x, y, z, 4)
    }
    for y in (height + 3)..=(height + 5) {
        for tx in (x - 2)..=(x + 2) {
            for tz in (z - 2)..=(z + 2) {
                let distance = abs(tx - x) + abs(tz - z)
                let limit = if y == height + 5 { 2 } else { 4 }
                if distance <= limit and get_block(tx, y, tz) == 0 {
                    set_block(tx, y, tz, 5)
                }
            }
        }
    }
}

fn create_world() {
    // Bedrock, stone, dirt, beaches and a shallow water table.
    for x in 0..WORLD_W {
        for z in 0..WORLD_D {
            let h = terrain_height(x, z)
            for y in 0..=h {
                var block = 3
                if y == 0 {
                    block = 7
                } else if y == h {
                    if h <= 5 { block = 6 } else { block = 1 }
                } else if y >= h - 2 {
                    block = 2
                } else {
                    // Coal and gold are tucked into stone layers.
                    let ore_roll = (x * 97 + y * 53 + z * 31 + x * z * 7) % 113
                    if ore_roll < 5 {
                        block = 9
                    } else if ore_roll == 11 and y < 8 {
                        block = 10
                    }
                    // Sparse underground pockets form small caves.
                    if y > 2 and y < h - 3 {
                        let cave_noise = sin_atf(float(x) * 0.27 + float(y) * 0.34) + cos_atf(float(z) * 0.24 - float(y) * 0.31) + sin_atf(float(x + z) * 0.19)
                        if cave_noise > 2.15 { block = 0 }
                    }
                }
                set_block(x, y, z, block)
            }
            if h < 6 {
                for wy in (h + 1)..=6 {
                    set_block(x, wy, z, 8)
                }
            }
        }
    }

    // Scattered trees outside the starting clearing.
    for x in 3..(WORLD_W - 3) {
        for z in 3..(WORLD_D - 3) {
            let far_from_spawn = abs(x - WORLD_W / 2) >= 6 or abs(z - WORLD_D / 2) >= 6
            let h = terrain_height(x, z)
            if far_from_spawn and h >= 6 and (x * 23 + z * 41 + x * z) % 67 == 9 {
                build_tree(x, z, h)
            }
        }
    }

    player_x = float(WORLD_W / 2) + 0.5
    player_z = float(WORLD_D / 2) + 0.5
    player_y = float(terrain_height(WORLD_W / 2, WORLD_D / 2) + 1)
    velocity_y = 0.0
    grounded = true
    yaw = 0.0
    pitch = 0.0
    update_camera()
}

fn update_camera() {
    let sy = sin_atf(yaw)
    let cy = cos_atf(yaw)
    let sp = sin_atf(pitch)
    let cp = cos_atf(pitch)

    forward_x = sy * cp
    forward_y = sp
    forward_z = cy * cp

    right_x = cy
    right_y = 0.0
    right_z = -sy

    up_x = -sy * sp
    up_y = cp
    up_z = -cy * sp

    camera_x = player_x
    camera_y = player_y + 1.58
    camera_z = player_z
    camera_underwater = get_block(int(floor(camera_x)), int(floor(camera_y)), int(floor(camera_z))) == 8
}

fn collides_body(x: float, feet_y: float, z: float) -> bool {
    let min_x = int(floor(x - PLAYER_RADIUS))
    let max_x = int(floor(x + PLAYER_RADIUS))
    let min_y = int(floor(feet_y + 0.01))
    let max_y = int(floor(feet_y + PLAYER_HEIGHT - 0.02))
    let min_z = int(floor(z - PLAYER_RADIUS))
    let max_z = int(floor(z + PLAYER_RADIUS))

    for bx in min_x..=max_x {
        for by in min_y..=max_y {
            for bz in min_z..=max_z {
                let block = get_block(bx, by, bz)
                if block != 0 and block != 8 { return true }
            }
        }
    }
    return false
}

fn move_horizontal(dx: float, dz: float) {
    let next_x = player_x + dx
    if not collides_body(next_x, player_y, player_z) {
        player_x = next_x
    } else if grounded and not collides_body(next_x, player_y + 1.0, player_z) {
        player_x = next_x
        player_y += 1.0
    }

    let next_z = player_z + dz
    if not collides_body(player_x, player_y, next_z) {
        player_z = next_z
    } else if grounded and not collides_body(player_x, player_y + 1.0, next_z) {
        player_z = next_z
        player_y += 1.0
    }
}

fn trace_ray(dx0: float, dy0: float, dz0: float, max_distance: float) -> (int, int, int, int, int, int, int, float) {
    // Amanatides-Woo voxel traversal: no tiny fixed steps, so detailed rendering
    // costs far fewer block lookups while remaining precise.
    let length = sqrt(dx0 * dx0 + dy0 * dy0 + dz0 * dz0)
    let dx = dx0 / length
    let dy = dy0 / length
    let dz = dz0 / length

    var bx = int(floor(camera_x))
    var by = int(floor(camera_y))
    var bz = int(floor(camera_z))
    var previous_x = bx
    var previous_y = by
    var previous_z = bz

    let step_x = if dx < 0.0 { -1 } else { 1 }
    let step_y = if dy < 0.0 { -1 } else { 1 }
    let step_z = if dz < 0.0 { -1 } else { 1 }

    let delta_x = if abs(dx) < 0.000001 { 1e30 } else { abs(1.0 / dx) }
    let delta_y = if abs(dy) < 0.000001 { 1e30 } else { abs(1.0 / dy) }
    let delta_z = if abs(dz) < 0.000001 { 1e30 } else { abs(1.0 / dz) }

    var max_x = if abs(dx) < 0.000001 { 1e30 } else if dx < 0.0 { (camera_x - float(bx)) * delta_x } else { (float(bx + 1) - camera_x) * delta_x }
    var max_y = if abs(dy) < 0.000001 { 1e30 } else if dy < 0.0 { (camera_y - float(by)) * delta_y } else { (float(by + 1) - camera_y) * delta_y }
    var max_z = if abs(dz) < 0.000001 { 1e30 } else if dz < 0.0 { (camera_z - float(bz)) * delta_z } else { (float(bz + 1) - camera_z) * delta_z }
    var distance = 0.0

    while distance <= max_distance {
        let block = get_block(bx, by, bz)
        if block != 0 and not (camera_underwater and block == 8) {
            return (block, bx, by, bz, previous_x, previous_y, previous_z, distance)
        }
        previous_x = bx
        previous_y = by
        previous_z = bz

        if max_x <= max_y and max_x <= max_z {
            bx += step_x
            distance = max_x
            max_x += delta_x
        } else if max_y <= max_z {
            by += step_y
            distance = max_y
            max_y += delta_y
        } else {
            bz += step_z
            distance = max_z
            max_z += delta_z
        }
    }
    return (0, -1, -1, -1, -1, -1, -1, max_distance)
}

fn face_from_hit(bx: int, by: int, bz: int, px: int, py: int, pz: int, dx: float, dy: float, dz: float) -> int {
    if by != py {
        if dy < 0.0 { return 0 }
        return 3
    }
    if bx != px {
        if dx > 0.0 { return 1 }
        return 2
    }
    if dz > 0.0 { return 1 }
    return 2
}

fn color_for_block(block: int, face: int, bx: int, by: int, bz: int, sample_y: float, distance: float) -> int {
    var red = 110
    var green = 110
    var blue = 110

    if block == 1 {
        if face == 0 {
            red = 88
            green = 169
            blue = 66
        } else if sample_y - float(by) > 0.72 {
            red = 83
            green = 151
            blue = 57
        } else {
            red = 126
            green = 86
            blue = 50
        }
    } else if block == 2 {
        red = 132
        green = 88
        blue = 52
    } else if block == 3 {
        red = 124
        green = 128
        blue = 134
    } else if block == 4 {
        if face == 0 {
            red = 174
            green = 128
            blue = 73
        } else {
            red = 137
            green = 94
            blue = 53
        }
    } else if block == 5 {
        red = 60
        green = 137
        blue = 56
    } else if block == 6 {
        red = 222
        green = 205
        blue = 128
    } else if block == 8 {
        red = 55
        green = 132
        blue = 202
        if face == 0 { green = 165; blue = 225 }
    } else if block == 9 {
        red = 82
        green = 84
        blue = 89
        if (bx * 13 + by * 17 + bz * 23) % 5 == 0 { red = 35; green = 37; blue = 40 }
    } else if block == 10 {
        red = 145
        green = 116
        blue = 54
        if (bx * 19 + by * 11 + bz * 29) % 4 == 0 { red = 238; green = 184; blue = 52 }
    } else {
        red = 54
        green = 56
        blue = 61
    }

    let variation = (bx * 17 + by * 31 + bz * 13) % 9 - 4
    red = clamp(red + variation, 0, 255)
    green = clamp(green + variation, 0, 255)
    blue = clamp(blue + variation, 0, 255)

    var light = 0.82
    if face == 0 {
        light = 1.0
    } else if face == 1 {
        light = 0.82
    } else if face == 2 {
        light = 0.68
    } else {
        light = 0.48
    }
    let distance_light = clamp(1.0 - distance * 0.012, 0.58, 1.0)
    let factor = light * distance_light * (0.36 + day_light * 0.64)
    red = int(float(red) * factor)
    green = int(float(green) * factor)
    blue = int(float(blue) * factor)

    let fog = clamp((distance - 9.0) / 14.0, 0.0, 0.64)
    let night_fog = clamp((0.76 - day_light) / 0.55, 0.0, 1.0)
    let fog_red = 143.0 * (1.0 - night_fog) + 15.0 * night_fog
    let fog_green = 193.0 * (1.0 - night_fog) + 24.0 * night_fog
    let fog_blue = 229.0 * (1.0 - night_fog) + 58.0 * night_fog
    red = int(float(red) * (1.0 - fog) + fog_red * fog)
    green = int(float(green) * (1.0 - fog) + fog_green * fog)
    blue = int(float(blue) * (1.0 - fog) + fog_blue * fog)
    return pack_rgb(red, green, blue)
}

fn sky_color(ray_y: float) -> int {
    let t = clamp((ray_y + 0.15) / 0.95, 0.0, 1.0)
    let day_r = 114.0 + 43.0 * t
    let day_g = 181.0 + 48.0 * t
    let day_b = 225.0 + 27.0 * t
    let night_mix = clamp((0.76 - day_light) / 0.55, 0.0, 1.0)
    let night_r = 10.0 + 12.0 * t
    let night_g = 17.0 + 20.0 * t
    let night_b = 42.0 + 48.0 * t
    let red = int(day_r * (1.0 - night_mix) + night_r * night_mix)
    let green = int(day_g * (1.0 - night_mix) + night_g * night_mix)
    let blue = int(day_b * (1.0 - night_mix) + night_b * night_mix)
    return pack_rgb(red, green, blue)
}

fn block_ui_color(block: int) -> int {
    if block == 1 { return rgb(88, 169, 66) }
    if block == 2 { return rgb(132, 88, 52) }
    if block == 3 { return rgb(124, 128, 134) }
    if block == 4 { return rgb(137, 94, 53) }
    if block == 5 { return rgb(60, 137, 56) }
    if block == 6 { return rgb(222, 205, 128) }
    if block == 9 { return rgb(61, 64, 69) }
    if block == 10 { return rgb(204, 158, 43) }
    return rgb(54, 56, 61)
}

fn block_name(block: int) -> str {
    if block == 1 { return "Grass" }
    if block == 2 { return "Dirt" }
    if block == 3 { return "Stone" }
    if block == 4 { return "Wood" }
    if block == 5 { return "Leaves" }
    if block == 6 { return "Sand" }
    if block == 8 { return "Water" }
    if block == 9 { return "Coal Ore" }
    if block == 10 { return "Gold Ore" }
    return "Bedrock"
}

fn hotbar_block(slot: int) -> int {
    if slot == 6 { return 9 }
    if slot == 7 { return 10 }
    return slot + 1
}

fn map_color(block: int) -> int {
    if block == 1 { return rgb(70, 158, 57) }
    if block == 2 { return rgb(130, 88, 51) }
    if block == 3 { return rgb(116, 121, 130) }
    if block == 4 { return rgb(119, 78, 42) }
    if block == 5 { return rgb(46, 127, 47) }
    if block == 6 { return rgb(223, 203, 135) }
    if block == 8 { return rgb(52, 129, 201) }
    if block == 9 { return rgb(48, 50, 53) }
    if block == 10 { return rgb(208, 160, 40) }
    return rgb(59, 61, 66)
}

fn surface_block(x: int, z: int) -> int {
    for y in (WORLD_H - 1)..0 step -1 {
        let block = get_block(x, y, z)
        if block != 0 { return block }
    }
    return 0
}

fn save_world() {
    let buffer = str_builder()
    buffer.add("BW2\n")
    for block in world {
        buffer.add_byte(byte(block + 48))
    }
    if write_file("blockworld.save", buffer.finish()) {
        status_message = "World saved to blockworld.save"
    } else {
        status_message = "Save failed — check folder permissions"
    }
    status_timer = 4.0
}

fn load_world() {
    let saved = read_file("blockworld.save")
    if saved == nil {
        status_message = "No save found — press F5 to save"
        status_timer = 4.0
        return
    }
    let data = saved!
    if not data.starts_with("BW2\n") or data.len() != world.len() + 4 {
        status_message = "Save file is invalid or from an older version"
        status_timer = 4.0
        return
    }
    for i in 0..world.len() {
        world[i] = int(data.byte_at(i + 4)) - 48
    }
    player_x = float(WORLD_W / 2) + 0.5
    player_z = float(WORLD_D / 2) + 0.5
    player_y = float(terrain_height(WORLD_W / 2, WORLD_D / 2) + 1)
    velocity_y = 0.0
    grounded = false
    update_camera()
    status_message = "World loaded"
    status_timer = 4.0
}

fn overlaps_player(bx: int, by: int, bz: int) -> bool {
    let overlap_x = float(bx) < player_x + PLAYER_RADIUS and float(bx + 1) > player_x - PLAYER_RADIUS
    let overlap_z = float(bz) < player_z + PLAYER_RADIUS and float(bz + 1) > player_z - PLAYER_RADIUS
    let overlap_y = float(by) < player_y + PLAYER_HEIGHT and float(by + 1) > player_y + 0.02
    return overlap_x and overlap_y and overlap_z
}

fn handle_block_action(left_now: bool, right_now: bool) {
    if left_now and not previous_left and mouse_captured {
        let (block, bx, by, bz, _, _, _, _) = trace_ray(forward_x, forward_y, forward_z, 6.0)
        if block != 0 and block != 7 and bx >= 0 {
            set_block(bx, by, bz, 0)
            blocks_mined += 1
        }
    }

    if right_now and not previous_right and mouse_captured {
        let (block, bx, by, bz, ax, ay, az, _) = trace_ray(forward_x, forward_y, forward_z, 6.0)
        if block != 0 and bx >= 0 and ax >= 0 and get_block(ax, ay, az) == 0 and not overlaps_player(ax, ay, az) {
            set_block(ax, ay, az, selected_block)
            blocks_placed += 1
        }
    }

    previous_left = left_now
    previous_right = right_now
}

fn game_tick() {
    let escape_now = ui_key_down("escape")
    if escape_now and not previous_escape {
        mouse_captured = not mouse_captured
        ui_mouse_capture(mouse_captured)
    }
    previous_escape = escape_now

    let map_now = ui_key_down("m")
    if map_now and not previous_m { show_map = not show_map }
    previous_m = map_now
    let debug_now = ui_key_down("f3")
    if debug_now and not previous_f3 { show_debug = not show_debug }
    previous_f3 = debug_now
    let save_now = ui_key_down("f5")
    if save_now and not previous_f5 { save_world() }
    previous_f5 = save_now
    let load_now = ui_key_down("f9")
    if load_now and not previous_f9 { load_world() }
    previous_f9 = load_now

    let now = clock()
    if last_tick_time > 0.0 {
        let delta = now - last_tick_time
        if delta > 0.001 { fps_value = fps_value * 0.82 + (1.0 / delta) * 0.18 }
    }
    last_tick_time = now
    game_time += 0.03
    day_light = 0.60 + 0.40 * sin_atf(game_time * 0.0349 + PI_VALUE / 2.0)
    if status_timer > 0.0 { status_timer -= 0.03 }

    let left_now = ui_mouse_held(0)
    let right_now = ui_mouse_held(1)
    if not mouse_captured {
        if left_now or right_now {
            mouse_captured = true
            ui_mouse_capture(true)
            previous_left = left_now
            previous_right = right_now
        }
    }

    if mouse_captured {
        let (mouse_dx, mouse_dy) = ui_mouse_delta()
        yaw += float(mouse_dx) * 0.0028
        pitch -= float(mouse_dy) * 0.0025
        pitch = clamp(pitch, -1.35, 1.35)
        while yaw > PI_VALUE { yaw -= 2.0 * PI_VALUE }
        while yaw < -PI_VALUE { yaw += 2.0 * PI_VALUE }
    }

    if ui_key_down("1") { selected_block = 1 }
    if ui_key_down("2") { selected_block = 2 }
    if ui_key_down("3") { selected_block = 3 }
    if ui_key_down("4") { selected_block = 4 }
    if ui_key_down("5") { selected_block = 5 }
    if ui_key_down("6") { selected_block = 6 }
    if ui_key_down("7") { selected_block = 9 }
    if ui_key_down("8") { selected_block = 10 }

    if collides_body(player_x, player_y - 0.06, player_z) {
        grounded = true
        if velocity_y < 0.0 {
            velocity_y = 0.0
            player_y = float(floor(player_y - 0.06)) + 1.0
        }
    } else {
        grounded = false
    }

    if ui_key_down("space") and grounded {
        velocity_y = 7.4
        grounded = false
    }

    var move_x = 0.0
    var move_z = 0.0
    let flat_forward_x = sin_atf(yaw)
    let flat_forward_z = cos_atf(yaw)
    let flat_right_x = cos_atf(yaw)
    let flat_right_z = -sin_atf(yaw)

    if ui_key_down("w") { move_x += flat_forward_x; move_z += flat_forward_z }
    if ui_key_down("s") { move_x -= flat_forward_x; move_z -= flat_forward_z }
    if ui_key_down("d") { move_x += flat_right_x; move_z += flat_right_z }
    if ui_key_down("a") { move_x -= flat_right_x; move_z -= flat_right_z }

    let move_length = sqrt(move_x * move_x + move_z * move_z)
    if move_length > 0.001 {
        var speed = 4.2
        if ui_key_down("shift") { speed = 6.5 }
        move_x = move_x / move_length * speed * 0.03
        move_z = move_z / move_length * speed * 0.03
        move_horizontal(move_x, move_z)
    }

    if not grounded {
        velocity_y -= 18.0 * 0.03
        let next_y = player_y + velocity_y * 0.03
        if collides_body(player_x, next_y, player_z) {
            if velocity_y <= 0.0 {
                player_y = float(floor(next_y)) + 1.0
                grounded = true
            } else {
                player_y = float(floor(next_y + PLAYER_HEIGHT)) - PLAYER_HEIGHT
            }
            velocity_y = 0.0
        } else {
            player_y = next_y
        }
    } else {
        velocity_y = 0.0
    }

    update_camera()
    handle_block_action(left_now, right_now)
}

fn draw_hud(c: Canvas) {
    // Lightweight translucent HUD panels keep text readable over any terrain.
    c.rrect(12, 12, 302, 91, 8, rgba(12, 16, 22, 0.72))
    c.text(24, 20, "BLOCKWORLD ULTRA", rgb(255, 255, 255), 20, true)
    c.text(24, 47, "WASD move  |  Mouse look  |  SPACE jump", rgb(225, 236, 246), 12, false)
    c.text(24, 66, "SHIFT sprint  |  LMB mine  |  RMB place", rgb(225, 236, 246), 12, false)
    c.text(24, 83, "F5 save  |  F9 load  |  M map  |  F3 debug", rgb(225, 236, 246), 12, false)

    c.rrect(12, c.h - 35, 305, 23, 6, rgba(12, 16, 22, 0.68))
    c.text(22, c.h - 30, "XYZ {int(floor(player_x))}, {int(floor(player_y))}, {int(floor(player_z))}", rgb(245, 248, 252), 13, true)
    c.text(c.w - 180, 18, "FPS {int(fps_value)}", rgb(252, 252, 252), 14, true)

    let slot_size = 42
    let gap = 5
    let slot_count = 8
    let total_width = slot_count * slot_size + (slot_count - 1) * gap
    let start_x = (c.w - total_width) / 2
    let bar_y = c.h - 69
    c.rrect(start_x - 10, bar_y - 10, total_width + 20, slot_size + 20, 10, rgba(14, 17, 23, 0.84))
    c.outline(start_x - 10, bar_y - 10, total_width + 20, slot_size + 20, 9, 2, rgb(92, 105, 120))

    for i in 0..8 {
        let slot_block = hotbar_block(i)
        let x = start_x + i * (slot_size + gap)
        c.rrect(x, bar_y, slot_size, slot_size, 6, rgb(43, 49, 58))
        c.rect(x + 7, bar_y + 7, slot_size - 14, slot_size - 14, block_ui_color(slot_block))
        let border_color = if selected_block == slot_block { rgb(255, 222, 74) } else { rgb(115, 129, 146) }
        let border_width = if selected_block == slot_block { 3 } else { 1 }
        c.outline(x, bar_y, slot_size, slot_size, 6, border_width, border_color)
        c.text(x + 3, bar_y - 18, str(i + 1), rgb(255, 255, 255), 13, true)
    }

    c.rrect(c.w - 196, c.h - 36, 184, 24, 6, rgba(12, 16, 22, 0.72))
    c.text(c.w - 185, c.h - 31, "BLOCK: {block_name(selected_block)}", rgb(255, 245, 198), 13, true)

    let center_x = c.w / 2
    let center_y = c.h / 2
    let (target, _, _, _, _, _, _, _) = trace_ray(forward_x, forward_y, forward_z, 7.0)
    let cross_color = if target != 0 { rgb(255, 224, 104) } else { rgb(255, 255, 255) }
    c.line(center_x - 9, center_y, center_x - 3, center_y, 2, cross_color)
    c.line(center_x + 3, center_y, center_x + 9, center_y, 2, cross_color)
    c.line(center_x, center_y - 9, center_x, center_y - 3, 2, cross_color)
    c.line(center_x, center_y + 3, center_x, center_y + 9, 2, cross_color)

    if not mouse_captured {
        c.rrect(center_x - 154, center_y + 28, 308, 48, 10, rgba(13, 17, 24, 0.90))
        c.outline(center_x - 154, center_y + 28, 308, 48, 9, 2, rgb(255, 220, 79))
        c.text(center_x - 112, center_y + 41, "CLICK TO CAPTURE MOUSE", rgb(255, 226, 105), 17, true)
    }

    if status_timer > 0.0 {
        let message_width = min(c.text_width(status_message, 14, true) + 30, c.w - 40)
        c.rrect((c.w - message_width) / 2, 18, message_width, 31, 8, rgba(12, 16, 22, 0.78))
        c.text((c.w - message_width) / 2 + 15, 25, status_message, rgb(245, 249, 252), 14, true)
    }

    if show_debug {
        c.rrect(12, 116, 245, 80, 8, rgba(12, 16, 22, 0.78))
        c.text(24, 124, "DEBUG", rgb(255, 221, 100), 14, true)
        c.text(24, 145, "FPS: {int(fps_value)}   DAY LIGHT: {int(day_light * 100.0)}%", rgb(240, 245, 250), 12, false)
        c.text(24, 164, "MINED: {blocks_mined}   PLACED: {blocks_placed}", rgb(240, 245, 250), 12, false)
        c.text(24, 180, "WORLD: {WORLD_W} x {WORLD_H} x {WORLD_D}", rgb(240, 245, 250), 12, false)
    }

    if show_map {
        let map_size = 192
        let map_x = c.w - map_size - 18
        let map_y = 48
        let cell = 3
        c.rrect(map_x - 8, map_y - 8, map_size + 16, map_size + 16, 10, rgba(12, 16, 22, 0.88))
        for mx in 0..WORLD_W {
            for mz in 0..WORLD_D {
                let surface = surface_block(mx, mz)
                c.rect(map_x + mx * cell, map_y + mz * cell, cell, cell, map_color(surface))
            }
        }
        let player_map_x = map_x + int(player_x * float(cell))
        let player_map_y = map_y + int(player_z * float(cell))
        c.circle(player_map_x, player_map_y, 4, rgb(255, 70, 65))
        c.line(player_map_x, player_map_y, player_map_x + int(sin_atf(yaw) * 12.0), player_map_y + int(cos_atf(yaw) * 12.0), 2, rgb(255, 255, 255))
        c.text(map_x, map_y + map_size + 10, "WORLD MAP  •  M to close", rgb(255, 255, 255), 12, true)
    }
}

fn draw_game(c: Canvas) {
    let aspect_x = 1.09
    let aspect_y = 0.68

    for y in 0..RENDER_H {
        let screen_y = (1.0 - (float(y) + 0.5) * 2.0 / float(RENDER_H)) * aspect_y
        for x in 0..RENDER_W {
            let screen_x = ((float(x) + 0.5) * 2.0 / float(RENDER_W) - 1.0) * aspect_x
            let dx = forward_x + right_x * screen_x + up_x * screen_y
            let dy = forward_y + right_y * screen_x + up_y * screen_y
            let dz = forward_z + right_z * screen_x + up_z * screen_y
            let (block, bx, by, bz, px, py, pz, distance) = trace_ray(dx, dy, dz, VIEW_DISTANCE)
            var color = sky_color(dy)
            if block != 0 {
                let face = face_from_hit(bx, by, bz, px, py, pz, dx, dy, dz)
                let ray_length = sqrt(dx * dx + dy * dy + dz * dz)
                let sample_y = camera_y + (dy / ray_length) * distance
                color = color_for_block(block, face, bx, by, bz, sample_y, distance)
            } else {
                let ray_length = sqrt(dx * dx + dy * dy + dz * dz)
                let ndx = dx / ray_length
                let ndy = dy / ray_length
                let ndz = dz / ray_length
                let sun_dot = ndx * -0.30 + ndy * 0.48 + ndz * 0.82
                if sun_dot > 0.994 and day_light > 0.42 {
                    color = pack_rgb(255, 244, 205)
                } else if day_light < 0.34 and ndy > 0.08 {
                    let star_a = int(abs(ndx * 1283.0 + ndy * 817.0 + ndz * 523.0) * 1000.0)
                    let star_b = int(abs(ndx * 331.0 - ndy * 1291.0 + ndz * 719.0) * 1000.0)
                    if star_a % 173 == 7 or star_b % 211 == 13 {
                        color = rgb(224, 235, 255)
                    }
                }
            }
            if camera_underwater { color = mix(color, rgb(40, 116, 190), 0.34) }
            frame_pixels[y * RENDER_W + x] = color
        }
    }

    c.pixels_smooth(0, 0, c.w, c.h, frame_pixels, RENDER_W, RENDER_H)
    draw_hud(c)
}

fn view() -> Node {
    if not timer_started {
        timer_started = true
        mouse_captured = true
        ui_mouse_capture(true)
        ui_every(FRAME_TIME_MS, game_tick)
    }
    return canvas(|c| { draw_game(c) }).grow()
}

fn main() {
    create_world()
    ui_run("ATF Blockworld Ultra", 1200, 750, view)
}
