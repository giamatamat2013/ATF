fn sin_atf(value: float) -> float {
    var x = value
    while x > PI_VALUE { x -= 2.0 * PI_VALUE }
    while x < -PI_VALUE { x += 2.0 * PI_VALUE }
    if x > PI_VALUE / 2.0 {
        x = PI_VALUE - x
    } else if x < -PI_VALUE / 2.0 {
        x = -PI_VALUE - x
    }
    let x2 = x * x
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x4 * x4
    let x10 = x8 * x2
    return x * (1.0 - x2 / 6.0 + x4 / 120.0 - x6 / 5040.0 + x8 / 362880.0 - x10 / 39916800.0)
}

fn cos_atf(value: float) -> float => sin_atf(PI_VALUE / 2.0 - value)

fn pack_rgb(red: int, green: int, blue: int) -> int {
    let r = clamp(red, 0, 255)
    let g = clamp(green, 0, 255)
    let b = clamp(blue, 0, 255)
    return (r << 16) | (g << 8) | b
}

fn block_index(x: int, y: int, z: int) -> int => (y * WORLD_D + z) * WORLD_W + x

fn biome_at(x: int, z: int) -> int {
    // Stable climate fields from absolute coordinates: 0 plains, 1 forest, 2 desert,
    // 3 mountains, 4 snowy taiga, 5 swamp. No random state is needed when streaming.
    let temperature = sin_atf(float(x) * 0.018) + cos_atf(float(z) * 0.015) + sin_atf(float(x + z) * 0.009)
    let humidity = cos_atf(float(x) * 0.024) + sin_atf(float(z) * 0.020) + cos_atf(float(x - z) * 0.010)
    let ridge = abs(sin_atf(float(x) * 0.035) + cos_atf(float(z) * 0.031) + sin_atf(float(x - z) * 0.018))
    if ridge > 2.48 { return 3 }
    if temperature < -1.18 { return 4 }
    if temperature > 1.30 and humidity < 0.45 { return 2 }
    if humidity > 1.24 and temperature < 0.72 { return 5 }
    if humidity > 0.30 { return 1 }
    return 0
}

fn biome_name(biome: int) -> str {
    if biome == 1 { return "Forest" }
    if biome == 2 { return "Desert" }
    if biome == 3 { return "Mountains" }
    if biome == 4 { return "Snowy Taiga" }
    if biome == 5 { return "Swamp" }
    return "Plains"
}

fn terrain_height(x: int, z: int) -> int {
    // Layered low-frequency terrain noise; biome climate shapes height and surface.
    let biome = biome_at(x, z)
    let broad = sin_atf(float(x) * 0.105) * 2.4 + cos_atf(float(z) * 0.12) * 2.1
    let rolling = sin_atf(float(x + z) * 0.19) * 1.4 + cos_atf(float(x - z) * 0.16) * 1.0
    if biome == 2 { return clamp(6 + int(broad * 0.24 + rolling * 0.22), 5, 8) }
    if biome == 3 { return clamp(11 + int(abs(broad) * 1.25 + abs(rolling) * 0.82), 8, 19) }
    if biome == 5 { return clamp(5 + int(broad * 0.48 + rolling * 0.30), 4, 8) }
    if biome == 4 { return clamp(8 + int(broad * 0.70 + rolling * 0.65), 5, 14) }
    return clamp(7 + int(broad + rolling), 3, 13)
}

fn get_block(x: int, y: int, z: int) -> int {
    if y < 0 { return 7 }
    if x < 0 or x >= WORLD_W or z < 0 or z >= WORLD_D { return 3 }
    if y >= WORLD_H { return 0 }
    return world[block_index(x, y, z)]
}

fn set_block(x: int, y: int, z: int, block: int) {
    if x < 0 or x >= WORLD_W or z < 0 or z >= WORLD_D { return }
    if y < 0 or y >= WORLD_H { return }
    world[block_index(x, y, z)] = block
}

fn build_tree(x: int, z: int, height: int) {
    let biome = biome_at(world_origin_x + x, world_origin_z + z)
    let log_block = if biome == 4 or biome == 3 { 38 } else { 4 }
    let leaf_block = if biome == 4 or biome == 3 { 39 } else { 5 }
    let trunk_height = if log_block == 38 { 5 } else { 4 }
    for y in (height + 1)..=(height + trunk_height) {
        set_block(x, y, z, log_block)
    }
    let crown_top = height + trunk_height + (if log_block == 38 { 2 } else { 1 })
    for y in (height + trunk_height - 1)..=crown_top {
        for tx in (x - 2)..=(x + 2) {
            for tz in (z - 2)..=(z + 2) {
                let distance = abs(tx - x) + abs(tz - z)
                let limit = if log_block == 38 { (crown_top - y) + 2 } else if y == crown_top { 2 } else { 4 }
                if distance <= limit and get_block(tx, y, tz) == 0 {
                    set_block(tx, y, tz, leaf_block)
                }
            }
        }
    }
}

fn world_edit_key(gx: int, y: int, gz: int) -> str => "{gx},{y},{gz}"

fn set_player_block(x: int, y: int, z: int, block: int) {
    set_block(x, y, z, block)
    let gx = world_origin_x + x
    let gz = world_origin_z + z
    world_edits[world_edit_key(gx, y, gz)] = block
}

fn is_tree_site(gx: int, gz: int) -> bool {
    let h = terrain_height(gx, gz)
    let outside_spawn = abs(gx) >= 6 or abs(gz) >= 6
    let tree_roll = abs(gx * 23 + gz * 41 + gx * gz) % 67
    let biome = biome_at(gx, gz)
    return h >= 6 and outside_spawn and (biome == 1 or biome == 3 or biome == 4) and tree_roll == 9
}

fn generate_base_column(x: int, z: int) {
    // Coordinates are absolute even though blocks are stored in a moving local window.
    for y in 0..WORLD_H { set_block(x, y, z, 0) }
    let gx = world_origin_x + x
    let gz = world_origin_z + z
    let biome = biome_at(gx, gz)
    let h = terrain_height(gx, gz)
    for y in 0..WORLD_H {
        var block = 0
        if y == 0 {
            block = 7
        } else if y <= h {
            if y == h {
                if biome == 2 { block = 6 }
                else if biome == 4 or h >= 15 { block = 22 }
                else if biome == 5 { block = 41 }
                else if biome == 3 and h > 12 { block = 3 }
                else { block = 1 }
            } else if biome == 2 and y >= h - 2 {
                block = 6
            } else if biome == 2 and y >= h - 4 {
                block = 25
            } else if biome == 3 and y >= h - 3 {
                block = 3
            } else if biome == 5 and y >= h - 3 {
                block = 41
            } else if y >= h - 2 {
                block = 2
            } else {
                block = 3
                let ore_roll = abs(gx * 97 + y * 53 + gz * 31 + gx * gz * 7) % 113
                let diamond_roll = abs(gx * 71 + y * 43 + gz * 61 + gx * gz * 5) % 257
                let iron_roll = abs(gx * 43 + y * 37 + gz * 83 + gx * gz * 3) % 71
                let copper_roll = abs(gx * 67 + y * 29 + gz * 47 + gx * gz * 11) % 89
                let redstone_roll = abs(gx * 59 + y * 61 + gz * 73 + gx * gz * 13) % 97
                let gravel_roll = abs(gx * 89 + y * 23 + gz * 41 + gx * gz * 17) % 101
                if y < 5 and diamond_roll == 19 { block = 18 }
                else if y < 11 and redstone_roll == 7 { block = 36 }
                else if y < 16 and iron_roll < 3 { block = 32 }
                else if y < 13 and copper_roll < 3 { block = 34 }
                else if y < h - 4 and gravel_roll < 3 { block = 21 }
                else if ore_roll < 5 { block = 9 }
                else if ore_roll == 11 and y < 8 { block = 10 }
                if y > 2 and y < h - 3 {
                    let cave_noise = sin_atf(float(gx) * 0.27 + float(y) * 0.34) + cos_atf(float(gz) * 0.24 - float(y) * 0.31) + sin_atf(float(gx + gz) * 0.19)
                    let deep_cave = sin_atf(float(gx - gz) * 0.11 + float(y) * 0.47) + cos_atf(float(gx + gz) * 0.08 - float(y) * 0.39)
                    if cave_noise > 2.15 or (y < 8 and deep_cave > 1.72) { block = 0 }
                }
            }
        }
        set_block(x, y, z, block)
    }
    if h < 6 {
        for wy in (h + 1)..=6 {
            if biome == 4 and wy == 6 { set_block(x, wy, z, 23) }
            else { set_block(x, wy, z, 8) }
        }
    }
}
fn decorate_tree_band_x(start_x: int, end_x: int) {
    // Generate trees whose trunks or canopies can touch the refreshed band.
    for tx in (start_x - 2)..=(end_x + 1) {
        for tz in -2..=(WORLD_D + 1) {
            let gx = world_origin_x + tx
            let gz = world_origin_z + tz
            if is_tree_site(gx, gz) {
                build_tree(tx, tz, terrain_height(gx, gz))
            }
        }
    }
}

fn decorate_tree_band_z(start_z: int, end_z: int) {
    for tx in -2..=(WORLD_W + 1) {
        for tz in (start_z - 2)..=(end_z + 1) {
            let gx = world_origin_x + tx
            let gz = world_origin_z + tz
            if is_tree_site(gx, gz) {
                build_tree(tx, tz, terrain_height(gx, gz))
            }
        }
    }
}

fn apply_all_edits_to_window() {
    for key, block in world_edits {
        let coords = key.split(",")
        if coords.len() == 3 {
            let gx = coords[0].parse_int()
            let y = coords[1].parse_int()
            let gz = coords[2].parse_int()
            if gx != nil and y != nil and gz != nil {
                let x = gx! - world_origin_x
                let z = gz! - world_origin_z
                if x >= 0 and x < WORLD_W and z >= 0 and z < WORLD_D and y! >= 0 and y! < WORLD_H {
                    set_block(x, y!, z, block)
                }
            }
        }
    }
}

fn set_generated_block(gx: int, y: int, gz: int, block: int) {
    set_block(gx - world_origin_x, y, gz - world_origin_z, block)
}

fn decorate_biome_features() {
    // Deterministic decorative features are regenerated from coordinates, never from frame randomness.
    for x in 2..(WORLD_W - 2) {
        for z in 2..(WORLD_D - 2) {
            let gx = world_origin_x + x
            let gz = world_origin_z + z
            let biome = biome_at(gx, gz)
            let h = terrain_height(gx, gz)
            let roll = abs(gx * 37 + gz * 71 + gx * gz * 3) % 251
            if biome == 2 and roll < 3 and get_block(x, h, z) == 6 {
                let cactus_height = 2 + roll % 3
                for cy in 1..=cactus_height {
                    if get_block(x, h + cy, z) == 0 { set_block(x, h + cy, z, 24) }
                }
            } else if (biome == 0 or biome == 1) and roll == 7 and get_block(x, h, z) == 1 and get_block(x, h + 1, z) == 0 {
                set_block(x, h + 1, z, 28)
            } else if biome == 5 and roll == 23 and get_block(x, h, z) == 1 {
                set_block(x, h, z, 53)
            } else if (biome == 1 or biome == 5) and roll == 13 and get_block(x, h, z) != 6 and get_block(x, h + 1, z) == 0 {
                set_block(x, h + 1, z, 44)
            }
        }
    }
}

fn flatten_structure_site(gx0: int, gz0: int, radius: int, base: int) {
    for gx in (gx0 - radius)..=(gx0 + radius) {
        for gz in (gz0 - radius)..=(gz0 + radius) {
            let ground = terrain_height(gx, gz)
            if ground < base {
                for yy in (ground + 1)..=base { set_generated_block(gx, yy, gz, 2) }
            } else if ground > base {
                for yy in (base + 1)..=ground { set_generated_block(gx, yy, gz, 0) }
            }
            for yy in (base + 1)..=(base + 8) { set_generated_block(gx, yy, gz, 0) }
        }
    }
}

fn build_village_house(gx0: int, gz0: int) {
    let base = terrain_height(gx0, gz0)
    flatten_structure_site(gx0, gz0, 4, base)
    for ox in -3..=3 {
        for oz in -3..=3 {
            set_generated_block(gx0 + ox, base + 1, gz0 + oz, 11)
            for wy in (base + 2)..=(base + 4) {
                if abs(ox) == 3 or abs(oz) == 3 {
                    let doorway = oz == 3 and ox == 0 and wy <= base + 3
                    let window = wy == base + 3 and ((abs(ox) == 3 and oz == 0) or (abs(oz) == 3 and abs(ox) == 2))
                    if doorway { set_generated_block(gx0 + ox, wy, gz0 + oz, 0) }
                    else if window { set_generated_block(gx0 + ox, wy, gz0 + oz, 13) }
                    else { set_generated_block(gx0 + ox, wy, gz0 + oz, if wy == base + 2 { 4 } else { 11 }) }
                }
            }
        }
    }
    // Layered roof gives a stepped voxel roof without using external models.
    for layer in 0..3 {
        let radius = 4 - layer
        for ox in (-radius)..=radius {
            for oz in (-radius)..=radius {
                if abs(ox) == radius or abs(oz) == radius or layer == 2 {
                    set_generated_block(gx0 + ox, base + 5 + layer, gz0 + oz, 11)
                }
            }
        }
    }
    set_generated_block(gx0 - 2, base + 2, gz0 - 2, 31)
    set_generated_block(gx0 + 1, base + 2, gz0 + 1, 29)
    set_generated_block(gx0 + 2, base + 2, gz0 - 1, 14)
    set_generated_block(gx0 - 1, base + 2, gz0 + 2, 54)
}

fn build_desert_temple(gx0: int, gz0: int) {
    let base = terrain_height(gx0, gz0)
    flatten_structure_site(gx0, gz0, 5, base)
    for ox in -4..=4 {
        for oz in -4..=4 {
            set_generated_block(gx0 + ox, base + 1, gz0 + oz, 25)
        }
    }
    for layer in 0..4 {
        let radius = 4 - layer
        for ox in (-radius)..=radius {
            for oz in (-radius)..=radius {
                if abs(ox) == radius or abs(oz) == radius {
                    let door_gap = oz == 4 and ox == 0 and layer < 2
                    if not door_gap { set_generated_block(gx0 + ox, base + 2 + layer, gz0 + oz, 25) }
                }
            }
        }
    }
    set_generated_block(gx0, base + 2, gz0, 31)
    set_generated_block(gx0 - 2, base + 2, gz0 - 2, 30)
    set_generated_block(gx0, base + 5, gz0, 52)
}

fn build_ruined_watchtower(gx0: int, gz0: int) {
    let base = terrain_height(gx0, gz0)
    flatten_structure_site(gx0, gz0, 3, base)
    for ox in -2..=2 {
        for oz in -2..=2 {
            if abs(ox) == 2 or abs(oz) == 2 { set_generated_block(gx0 + ox, base + 1, gz0 + oz, 40) }
        }
    }
    for wy in 2..=6 {
        for ox in [-2, 2] {
            for oz in [-2, 2] {
                let missing = abs(gx0 * 17 + gz0 * 31 + ox * 7 + oz * 11 + wy * 13) % 9 == 0
                if not missing { set_generated_block(gx0 + ox, base + wy, gz0 + oz, 40) }
            }
        }
    }
    for ox in -2..=2 {
        for oz in -2..=2 {
            if abs(ox) <= 1 and abs(oz) <= 1 { set_generated_block(gx0 + ox, base + 6, gz0 + oz, 26) }
        }
    }
    set_generated_block(gx0, base + 2, gz0, 31)
    set_generated_block(gx0, base + 3, gz0, 29)
}

fn build_stone_well(gx0: int, gz0: int) {
    let base = terrain_height(gx0, gz0)
    flatten_structure_site(gx0, gz0, 2, base)
    for ox in -2..=2 {
        for oz in -2..=2 {
            if abs(ox) == 2 or abs(oz) == 2 {
                set_generated_block(gx0 + ox, base + 1, gz0 + oz, 26)
                if abs(ox) == 2 and abs(oz) == 2 { set_generated_block(gx0 + ox, base + 2, gz0 + oz, 4) }
            } else {
                set_generated_block(gx0 + ox, base + 1, gz0 + oz, 8)
            }
        }
    }
}

fn build_amethyst_geode(gx0: int, gz0: int) {
    // Rare hollow geodes are anchored to absolute coordinates, so they remain stable while streaming.
    let seed = abs(gx0 * 73 + gz0 * 97 + gx0 * gz0 * 11)
    let center_y = 4 + seed % 5
    for ox in -3..=3 {
        for oy in -3..=3 {
            for oz in -3..=3 {
                let d2 = ox * ox + oy * oy + oz * oz
                if d2 <= 10 {
                    let wall_roll = abs(gx0 * 13 + gz0 * 17 + ox * 7 + oy * 11 + oz * 19) % 7
                    if d2 >= 5 {
                        set_generated_block(gx0 + ox, center_y + oy, gz0 + oz, if wall_roll == 0 { 43 } else { 42 })
                    } else if d2 == 4 and wall_roll < 3 {
                        set_generated_block(gx0 + ox, center_y + oy, gz0 + oz, 43)
                    } else {
                        set_generated_block(gx0 + ox, center_y + oy, gz0 + oz, 0)
                    }
                }
            }
        }
    }
}

fn build_ruined_portal(gx0: int, gz0: int) {
    // Damaged obsidian frame, a little scorched ground, and a chest beside the portal.
    let base = terrain_height(gx0, gz0)
    flatten_structure_site(gx0, gz0, 4, base)
    for ox in -2..=2 {
        for oy in 0..=5 {
            let frame = ox == -2 or ox == 2 or oy == 0 or oy == 5
            let crack = abs(gx0 * 19 + gz0 * 23 + ox * 7 + oy * 13) % 11 == 0
            if frame and not crack {
                set_generated_block(gx0 + ox, base + 1 + oy, gz0, 42)
            } else if not frame {
                set_generated_block(gx0 + ox, base + 1 + oy, gz0, 0)
            }
        }
    }
    for ox in -3..=3 {
        if abs(ox) != 2 {
            set_generated_block(gx0 + ox, base + 1, gz0 + 1, if abs(ox) == 3 { 26 } else { 42 })
        }
    }
    set_generated_block(gx0 + 3, base + 1, gz0 + 1, 31)
    set_generated_block(gx0 - 1, base + 2, gz0 + 1, 52)
    set_generated_block(gx0 + 1, base + 2, gz0 + 1, 52)
}

fn decorate_structures_window() {
    let min_cx = int(floor(float(world_origin_x) / float(STRUCTURE_CELL))) - 1
    let max_cx = int(floor(float(world_origin_x + WORLD_W - 1) / float(STRUCTURE_CELL))) + 1
    let min_cz = int(floor(float(world_origin_z) / float(STRUCTURE_CELL))) - 1
    let max_cz = int(floor(float(world_origin_z + WORLD_D - 1) / float(STRUCTURE_CELL))) + 1
    for cx in min_cx..=max_cx {
        for cz in min_cz..=max_cz {
            let seed = abs(cx * 977 + cz * 619 + cx * cz * 137 + 83)
            let roll = seed % 13
            let gx0 = cx * STRUCTURE_CELL + 25 + seed % 11
            let gz0 = cz * STRUCTURE_CELL + 25 + (seed / 7) % 11
            let biome = biome_at(gx0, gz0)
            if roll <= 2 { build_village_house(gx0, gz0) }
            else if roll == 3 or roll == 4 { build_ruined_watchtower(gx0, gz0) }
            else if roll == 5 { build_stone_well(gx0, gz0) }
            else if roll == 6 and biome == 2 { build_desert_temple(gx0, gz0) }
            else if roll == 7 and biome != 5 { build_ruined_portal(gx0, gz0) }
            else if roll == 8 { build_amethyst_geode(gx0, gz0) }
        }
    }
}

fn create_world() {
    // Build the loaded square from absolute coordinates. New squares use the same seed,
    // so a coordinate always generates the same terrain no matter when it is discovered.
    for x in 0..WORLD_W {
        for z in 0..WORLD_D {
            generate_base_column(x, z)
        }
    }
    for tx in -2..=(WORLD_W + 1) {
        for tz in -2..=(WORLD_D + 1) {
            let gx = world_origin_x + tx
            let gz = world_origin_z + tz
            if is_tree_site(gx, gz) {
                build_tree(tx, tz, terrain_height(gx, gz))
            }
        }
    }
    decorate_biome_features()
    decorate_structures_window()
    apply_all_edits_to_window()
    player_x = float(WORLD_W / 2) + 0.5
    player_z = float(WORLD_D / 2) + 0.5
    player_y = float(terrain_height(world_origin_x + WORLD_W / 2, world_origin_z + WORLD_D / 2) + 1)
    velocity_y = 0.0
    grounded = true
    yaw = 0.0
    pitch = 0.0
    update_camera()
}

fn shift_world_x(amount: int) {
    let old_world = world.copy()
    for y in 0..WORLD_H {
        for z in 0..WORLD_D {
            for x in 0..WORLD_W {
                let source_x = x + amount
                let dest = block_index(x, y, z)
                if source_x >= 0 and source_x < WORLD_W {
                    world[dest] = old_world[block_index(source_x, y, z)]
                } else {
                    world[dest] = 0
                }
            }
        }
    }
    world_origin_x += amount
    player_x -= float(amount)
    for i in 0..dropped_item_xs.len() { dropped_item_xs[i] -= float(amount) }
    for i in 0..mob_xs.len() { mob_xs[i] -= float(amount) }

    let start_x = if amount > 0 { WORLD_W - amount } else { 0 }
    let end_x = if amount > 0 { WORLD_W } else { -amount }
    for x in start_x..end_x {
        for z in 0..WORLD_D { generate_base_column(x, z) }
    }
    decorate_tree_band_x(start_x, end_x)
    decorate_biome_features()
    decorate_structures_window()
    apply_all_edits_to_window()
}

fn shift_world_z(amount: int) {
    let old_world = world.copy()
    for y in 0..WORLD_H {
        for z in 0..WORLD_D {
            for x in 0..WORLD_W {
                let source_z = z + amount
                let dest = block_index(x, y, z)
                if source_z >= 0 and source_z < WORLD_D {
                    world[dest] = old_world[block_index(x, y, source_z)]
                } else {
                    world[dest] = 0
                }
            }
        }
    }
    world_origin_z += amount
    player_z -= float(amount)
    for i in 0..dropped_item_zs.len() { dropped_item_zs[i] -= float(amount) }
    for i in 0..mob_zs.len() { mob_zs[i] -= float(amount) }

    let start_z = if amount > 0 { WORLD_D - amount } else { 0 }
    let end_z = if amount > 0 { WORLD_D } else { -amount }
    for z in start_z..end_z {
        for x in 0..WORLD_W { generate_base_column(x, z) }
    }
    decorate_tree_band_z(start_z, end_z)
    decorate_biome_features()
    decorate_structures_window()
    apply_all_edits_to_window()
}

fn stream_world_if_needed() {
    let low = float(WORLD_W / 2 - STREAM_CHUNK / 2)
    let high_x = float(WORLD_W / 2 + STREAM_CHUNK / 2)
    let high_z = float(WORLD_D / 2 + STREAM_CHUNK / 2)
    if player_x >= high_x { shift_world_x(STREAM_CHUNK) }
    else if player_x < low { shift_world_x(-STREAM_CHUNK) }
    if player_z >= high_z { shift_world_z(STREAM_CHUNK) }
    else if player_z < low { shift_world_z(-STREAM_CHUNK) }
}

fn update_camera() {
    let sy = sin_atf(yaw)
    let cy = cos_atf(yaw)
    let sp = sin_atf(pitch)
    let cp = cos_atf(pitch)

    forward_x = sy * cp
    forward_y = sp
    forward_z = cy * cp

    right_x = cy
    right_y = 0.0
    right_z = -sy

    up_x = -sy * sp
    up_y = cp
    up_z = -cy * sp

    camera_x = player_x
    camera_y = player_y + (if crouching { 1.20 } else { 1.58 })
    camera_z = player_z
    camera_underwater = get_block(int(floor(camera_x)), int(floor(camera_y)), int(floor(camera_z))) == 8
}

fn collides_body(x: float, feet_y: float, z: float) -> bool {
    let min_x = int(floor(x - PLAYER_RADIUS))
    let max_x = int(floor(x + PLAYER_RADIUS))
    let min_y = int(floor(feet_y + 0.01))
    let max_y = int(floor(feet_y + PLAYER_HEIGHT - 0.02))
    let min_z = int(floor(z - PLAYER_RADIUS))
    let max_z = int(floor(z + PLAYER_RADIUS))

    for bx in min_x..=max_x {
        for by in min_y..=max_y {
            for bz in min_z..=max_z {
                let block = get_block(bx, by, bz)
                if block != 0 and block != 8 and block != 24 and block != 28 and block != 29 and block != 44 { return true }
            }
        }
    }
    return false
}

fn move_horizontal(dx: float, dz: float) {
    let next_x = player_x + dx
    if not collides_body(next_x, player_y, player_z) {
        player_x = next_x
    } else if grounded and not collides_body(next_x, player_y + 1.0, player_z) {
        player_x = next_x
        player_y += 1.0
    }

    let next_z = player_z + dz
    if not collides_body(player_x, player_y, next_z) {
        player_z = next_z
    } else if grounded and not collides_body(player_x, player_y + 1.0, next_z) {
        player_z = next_z
        player_y += 1.0
    }
}

fn trace_ray(dx0: float, dy0: float, dz0: float, max_distance: float) -> (int, int, int, int, int, int, int, float) {
    // Amanatides-Woo voxel traversal: no tiny fixed steps, so detailed rendering
    // costs far fewer block lookups while remaining precise.
    let length = sqrt(dx0 * dx0 + dy0 * dy0 + dz0 * dz0)
    let dx = dx0 / length
    let dy = dy0 / length
    let dz = dz0 / length

    var bx = int(floor(camera_x))
    var by = int(floor(camera_y))
    var bz = int(floor(camera_z))
    var previous_x = bx
    var previous_y = by
    var previous_z = bz

    let step_x = if dx < 0.0 { -1 } else { 1 }
    let step_y = if dy < 0.0 { -1 } else { 1 }
    let step_z = if dz < 0.0 { -1 } else { 1 }

    let delta_x = if abs(dx) < 0.000001 { 1e30 } else { abs(1.0 / dx) }
    let delta_y = if abs(dy) < 0.000001 { 1e30 } else { abs(1.0 / dy) }
    let delta_z = if abs(dz) < 0.000001 { 1e30 } else { abs(1.0 / dz) }

    var max_x = if abs(dx) < 0.000001 { 1e30 } else if dx < 0.0 { (camera_x - float(bx)) * delta_x } else { (float(bx + 1) - camera_x) * delta_x }
    var max_y = if abs(dy) < 0.000001 { 1e30 } else if dy < 0.0 { (camera_y - float(by)) * delta_y } else { (float(by + 1) - camera_y) * delta_y }
    var max_z = if abs(dz) < 0.000001 { 1e30 } else if dz < 0.0 { (camera_z - float(bz)) * delta_z } else { (float(bz + 1) - camera_z) * delta_z }
    var distance = 0.0

    while distance <= max_distance {
        let block = get_block(bx, by, bz)
        if block != 0 and not (camera_underwater and block == 8) {
            return (block, bx, by, bz, previous_x, previous_y, previous_z, distance)
        }
        previous_x = bx
        previous_y = by
        previous_z = bz

        if max_x <= max_y and max_x <= max_z {
            bx += step_x
            distance = max_x
            max_x += delta_x
        } else if max_y <= max_z {
            by += step_y
            distance = max_y
            max_y += delta_y
        } else {
            bz += step_z
            distance = max_z
            max_z += delta_z
        }
    }
    return (0, -1, -1, -1, -1, -1, -1, max_distance)
}

fn face_from_hit(bx: int, by: int, bz: int, px: int, py: int, pz: int, dx: float, dy: float, dz: float) -> int {
    if by != py {
        if dy < 0.0 { return 0 }
        return 3
    }
    if bx != px {
        if dx > 0.0 { return 1 }
        return 2
    }
    if dz > 0.0 { return 4 }
    return 5
}

fn fract_atf(value: float) -> float => value - floor(value)

fn color_for_block(block: int, face: int, bx: int, by: int, bz: int, sample_y: float, distance: float, hit_x: float, hit_y: float, hit_z: float) -> int {
    // Face-local UV coordinates make each cube face have its own repeatable texture.
    var u = fract_atf(hit_x)
    var v = fract_atf(hit_z)
    if face == 1 or face == 2 {
        u = fract_atf(hit_z)
        v = fract_atf(hit_y)
    } else if face == 4 or face == 5 {
        u = fract_atf(hit_x)
        v = fract_atf(hit_y)
    }
    let cell_u = int(floor(u * 16.0))
    let cell_v = int(floor(v * 16.0))
    let texture_hash = abs(((world_origin_x + bx) * 73 + by * 31 + (world_origin_z + bz) * 47 + cell_u * 19 + cell_v * 23 + block * 17) % 67)
    let grain = texture_hash % 11 - 5

    var red = 110
    var green = 110
    var blue = 110

    if block == 1 {
        if face == 0 {
            red = 83 + grain
            green = 165 + grain * 2
            blue = 60 + grain
            if texture_hash % 7 == 0 { red -= 13; green -= 18; blue -= 7 }
            if texture_hash % 11 == 3 { red += 9; green += 10; blue += 4 }
        } else if sample_y - float(by) > 0.82 {
            red = 82 + grain
            green = 151 + grain * 2
            blue = 57 + grain
        } else {
            red = 124 + grain * 2
            green = 83 + grain
            blue = 48 + grain
            if cell_v == 7 { red = 89; green = 157; blue = 59 }
            if texture_hash % 6 == 0 { red -= 13; green -= 12; blue -= 8 }
        }
    } else if block == 2 {
        red = 132 + grain * 2
        green = 86 + grain
        blue = 50 + grain
        if texture_hash % 5 == 0 { red -= 17; green -= 11; blue -= 7 }
    } else if block == 3 {
        red = 126 + grain * 2
        green = 131 + grain * 2
        blue = 139 + grain * 2
        if (cell_u * 7 + cell_v * 11 + world_origin_x + bx + world_origin_z + bz) % 19 == 0 { red -= 30; green -= 30; blue -= 29 }
        if cell_u == 0 and texture_hash % 3 == 0 { red -= 9; green -= 9; blue -= 8 }
    } else if block == 4 {
        if face == 0 or face == 3 {
            red = 174 + grain * 2
            green = 128 + grain
            blue = 73 + grain
            let ring = int(floor((abs(u - 0.5) + abs(v - 0.5)) * 12.0))
            if ring % 3 == 0 { red -= 22; green -= 16; blue -= 9 }
        } else {
            red = 146 + grain * 2
            green = 99 + grain
            blue = 57 + grain
            if cell_u % 3 == 0 { red -= 25; green -= 17; blue -= 9 }
            if cell_v == 0 { red -= 8; green -= 6; blue -= 4 }
        }
    } else if block == 5 {
        red = 54 + grain
        green = 135 + grain * 2
        blue = 48 + grain
        if texture_hash % 5 == 0 { red -= 23; green -= 30; blue -= 17 }
        if texture_hash % 9 == 1 { red += 18; green += 13; blue += 9 }
    } else if block == 6 {
        red = 224 + grain
        green = 205 + grain
        blue = 129 + grain
        if texture_hash % 6 == 0 { red -= 18; green -= 16; blue -= 10 }
        if texture_hash % 13 == 2 { red += 8; green += 6; blue += 3 }
    } else if block == 8 {
        red = 43 + grain
        green = 126 + grain * 2
        blue = 201 + grain * 2
        let wave = int(floor((hit_x + hit_z + game_time * 0.7) * 5.0)) % 5
        if face == 0 or wave == 0 { red += 15; green += 26; blue += 28 }
    } else if block == 9 or block == 10 or block == 18 {
        // Ores inherit stone, with clustered mineral flecks instead of flat dots.
        red = 119 + grain * 2
        green = 123 + grain * 2
        blue = 132 + grain * 2
        if (cell_u * 5 + cell_v * 7 + world_origin_x + bx + world_origin_z + bz) % 9 < 3 {
            if block == 9 {
                red = 39 + grain
                green = 42 + grain
                blue = 46 + grain
            } else if block == 10 {
                red = 221 + grain
                green = 166 + grain * 2
                blue = 43 + grain
            } else {
                red = 45 + grain
                green = 198 + grain * 2
                blue = 220 + grain * 2
            }
        }
    } else if block == 11 {
        // Plank boards have repeating edges and visible grain.
        red = 174 + grain * 2
        green = 123 + grain * 2
        blue = 71 + grain
        let board_edge = fract_atf(v * 4.0)
        if (face != 0 and face != 3 and (board_edge < 0.07 or board_edge > 0.93)) or (face == 0 and cell_u == 0) {
            red -= 42; green -= 30; blue -= 17
        }
        if cell_u % 4 == 0 { red -= 10; green -= 7; blue -= 4 }
    } else if block == 12 {
        // Staggered brick courses with contrasting mortar joints.
        red = 157 + grain * 2
        green = 75 + grain
        blue = 57 + grain
        let brick_row = int(floor(v * 4.0))
        let brick_u = fract_atf(u * 4.0 + (if brick_row % 2 == 0 { 0.0 } else { 0.5 }))
        if fract_atf(v * 4.0) < 0.07 or brick_u < 0.055 { red = 190; green = 177; blue = 155 }
    } else if block == 13 {
        // Glass uses bright edge highlights and a cool tinted pane effect.
        red = 140 + grain
        green = 209 + grain
        blue = 226 + grain
        if u < 0.075 or u > 0.925 or v < 0.075 or v > 0.925 { red = 224; green = 246; blue = 255 }
        if cell_u == cell_v and texture_hash % 4 == 0 { red += 8; green += 5; blue += 2 }
    } else if block == 14 {
        // Crafting bench: warm timber sides, gridded work surface on top.
        if face == 0 {
            red = 162 + grain * 2; green = 111 + grain; blue = 58 + grain
            if cell_u == 0 or cell_v == 0 or cell_u == 4 or cell_v == 4 { red -= 34; green -= 23; blue -= 12 }
        } else {
            red = 139 + grain * 2; green = 87 + grain; blue = 45 + grain
            if cell_v == 0 or cell_v == 7 { red -= 25; green -= 17; blue -= 8 }
        }
    } else if block == 20 or block == 29 {
        // Lantern and torch have a warm emissive core with a darker metal/wood frame.
        red = 255
        green = 174 + texture_hash % 42
        blue = 43 + texture_hash % 24
        if u < 0.15 or u > 0.85 or v < 0.12 or v > 0.88 { red = 95; green = 70; blue = 48 }
        if day_light < 0.35 { red = 255; green = 225; blue = 120 }
    } else if block == 21 {
        red = 132 + grain * 2; green = 128 + grain * 2; blue = 119 + grain * 2
        if texture_hash % 4 == 0 { red -= 26; green -= 24; blue -= 21 }
        if texture_hash % 7 == 1 { red += 17; green += 15; blue += 12 }
    } else if block == 22 {
        red = 235 + grain; green = 243 + grain; blue = 250
        if texture_hash % 8 == 0 { red = 205; green = 224; blue = 241 }
        if face != 0 { red -= 13; green -= 10; blue -= 5 }
    } else if block == 23 {
        red = 145 + grain; green = 208 + grain; blue = 235 + grain
        if (cell_u + cell_v * 3 + texture_hash) % 13 == 0 { red = 210; green = 239; blue = 250 }
        if cell_u == cell_v or cell_u + cell_v == 15 { red -= 15; green -= 9; blue -= 5 }
    } else if block == 24 {
        red = 49 + grain; green = 139 + grain * 2; blue = 55 + grain
        if cell_u == 3 or cell_u == 12 { red -= 22; green -= 25; blue -= 14 }
        if (cell_u * 5 + cell_v * 7 + texture_hash) % 17 == 0 { red = 208; green = 221; blue = 166 }
    } else if block == 25 {
        red = 211 + grain; green = 192 + grain; blue = 135 + grain
        if cell_v % 4 == 0 or (cell_u + cell_v * 3) % 13 == 0 { red -= 27; green -= 24; blue -= 18 }
    } else if block == 26 or block == 27 or block == 40 {
        red = 118 + grain * 2; green = 121 + grain * 2; blue = 126 + grain * 2
        let mortar = (cell_u % 5 == 0 and cell_v % 4 == 0) or texture_hash % 11 == 0
        if mortar { red = 76 + grain; green = 79 + grain; blue = 84 + grain }
        if block == 27 or block == 40 {
            if (cell_u * 7 + cell_v * 11 + texture_hash) % 9 < 3 { red = 70 + grain; green = 105 + grain * 2; blue = 65 + grain }
        }
    } else if block == 28 or block == 44 {
        if block == 28 {
            red = 58 + grain; green = 132 + grain * 2; blue = 48 + grain
            if cell_u % 5 == 0 or cell_v % 6 == 0 { red = 211; green = 55 + texture_hash % 35; blue = 112 + texture_hash % 60 }
            if (cell_u + cell_v) % 7 == 0 { red = 247; green = 217; blue = 70 }
        } else {
            red = 182 + grain; green = 46 + grain; blue = 42 + grain
            if texture_hash % 5 == 0 { red = 235; green = 223; blue = 193 }
            if face != 0 { red = 197 + grain; green = 173 + grain; blue = 139 + grain }
        }
    } else if block == 30 {
        red = 103 + grain; green = 106 + grain; blue = 111 + grain
        if face == 1 or face == 2 { if u > 0.2 and u < 0.8 and v > 0.2 and v < 0.72 { red = 48; green = 42; blue = 40 } }
        if face == 0 { red = 83 + grain; green = 87 + grain; blue = 92 + grain }
        if face == 3 { red = 39; green = 35; blue = 34 }
    } else if block == 31 {
        red = 151 + grain * 2; green = 91 + grain; blue = 43 + grain
        if cell_v == 3 or cell_v == 12 { red -= 37; green -= 25; blue -= 13 }
        if u > 0.42 and u < 0.58 and v > 0.35 and v < 0.58 { red = 227; green = 179; blue = 55 }
    } else if block == 32 or block == 34 or block == 36 {
        red = 121 + grain * 2; green = 124 + grain * 2; blue = 132 + grain * 2
        let fleck = (cell_u * 5 + cell_v * 7 + texture_hash + world_origin_x + bx + world_origin_z + bz) % 11 < 4
        if fleck {
            if block == 32 { red = 170 + grain; green = 113 + grain; blue = 80 + grain }
            else if block == 34 { red = 190 + grain; green = 119 + grain; blue = 68 + grain }
            else { red = 164 + grain; green = 35 + grain; blue = 43 + grain }
        }
    } else if block == 33 {
        red = 198 + grain; green = 202 + grain; blue = 209 + grain
        if cell_v < 2 or cell_v > 13 { red -= 34; green -= 34; blue -= 31 }
    } else if block == 35 {
        red = 190 + grain; green = 119 + grain; blue = 66 + grain
        if cell_v < 2 or cell_v > 13 { red -= 29; green -= 19; blue -= 12 }
    } else if block == 37 {
        red = 160 + grain; green = 29 + grain; blue = 35 + grain
        if cell_u % 4 == 0 and cell_v % 4 == 0 { red = 220; green = 43; blue = 49 }
    } else if block == 38 {
        if face == 0 or face == 3 {
            red = 130 + grain; green = 108 + grain; blue = 75 + grain
            if int(floor((abs(u - 0.5) + abs(v - 0.5)) * 17.0)) % 3 == 0 { red -= 22; green -= 18; blue -= 12 }
        } else {
            red = 91 + grain; green = 66 + grain; blue = 43 + grain
            if cell_u % 3 == 0 { red -= 19; green -= 13; blue -= 8 }
        }
    } else if block == 39 {
        red = 38 + grain; green = 91 + grain * 2; blue = 45 + grain
        if texture_hash % 5 == 0 { red -= 16; green -= 21; blue -= 9 }
        if texture_hash % 13 == 0 { red += 18; green += 21; blue += 8 }
    } else if block == 41 {
        red = 126 + grain * 2; green = 132 + grain * 2; blue = 128 + grain * 2
        if texture_hash % 7 == 0 { red -= 21; green -= 19; blue -= 18 }
        if cell_v == 0 { red += 12; green += 10; blue += 7 }
    } else if block == 42 {
        red = 33 + grain; green = 21 + grain; blue = 57 + grain * 2
        if (cell_u + cell_v * 3) % 11 == 0 { red = 67; green = 45; blue = 99 }
        if texture_hash % 17 == 0 { red = 81; green = 62; blue = 117 }
    } else if block == 43 {
        red = 120 + grain * 2; green = 61 + grain; blue = 172 + grain * 2
        if (cell_u * 3 + cell_v * 5 + texture_hash) % 7 < 3 { red += 26; green += 15; blue += 39 }
        if texture_hash % 13 == 0 { red = 207; green = 153; blue = 255 }
    } else if block == 45 {
        red = 153 + grain; green = 109 + grain; blue = 65 + grain
        if cell_v % 3 == 0 { red -= 38; green -= 27; blue -= 15 }
    } else if block == 52 {
        // Glowstone: warm luminous mottling with distinct mineral clusters.
        red = 226 + grain * 2; green = 181 + grain * 2; blue = 93 + grain
        if texture_hash % 4 == 0 { red = 255; green = 224; blue = 137 }
        if texture_hash % 9 == 0 { red = 183; green = 119; blue = 48 }
    } else if block == 53 {
        // Moss block: green flecks over damp earth.
        red = 87 + grain * 2; green = 121 + grain * 2; blue = 63 + grain
        if texture_hash % 4 == 0 { red = 56 + grain; green = 92 + grain * 2; blue = 43 + grain }
        if texture_hash % 13 == 0 { red = 124; green = 148; blue = 72 }
    } else if block == 54 {
        // Bookshelf: alternating coloured spines and a strong wooden shelf grid.
        red = 132 + grain; green = 84 + grain; blue = 44 + grain
        if cell_v % 6 == 0 or cell_v % 6 == 5 { red = 173; green = 123; blue = 71 }
        else if cell_u % 5 == 0 { red = 94; green = 61; blue = 35 }
        else if cell_u % 7 == 1 { red = 126; green = 48; blue = 39 }
        else if cell_u % 7 == 3 { red = 57; green = 91; blue = 139 }
        else if cell_u % 7 == 5 { red = 201; green = 174; blue = 73 }
    } else {
        red = 54 + grain
        green = 56 + grain
        blue = 61 + grain
    }

    var light = 0.82
    if face == 0 { light = 1.0 }
    else if face == 1 or face == 4 { light = 0.82 }
    else if face == 2 or face == 5 { light = 0.68 }
    else { light = 0.48 }

    if block == 20 or block == 29 or block == 43 or block == 37 or block == 52 {
        light = max(light, 1.08)
    }
    let distance_light = clamp(1.0 - distance * 0.012, 0.58, 1.0)
    let factor = light * distance_light * (0.36 + day_light * 0.64)
    red = clamp(int(float(red) * factor), 0, 255)
    green = clamp(int(float(green) * factor), 0, 255)
    blue = clamp(int(float(blue) * factor), 0, 255)

    let fog = clamp((distance - 9.0) / 14.0, 0.0, 0.64)
    let night_fog = clamp((0.76 - day_light) / 0.55, 0.0, 1.0)
    let fog_red = 143.0 * (1.0 - night_fog) + 15.0 * night_fog
    let fog_green = 193.0 * (1.0 - night_fog) + 24.0 * night_fog
    let fog_blue = 229.0 * (1.0 - night_fog) + 58.0 * night_fog
    red = int(float(red) * (1.0 - fog) + fog_red * fog)
    green = int(float(green) * (1.0 - fog) + fog_green * fog)
    blue = int(float(blue) * (1.0 - fog) + fog_blue * fog)
    return pack_rgb(red, green, blue)
}

fn sky_color(ray_y: float) -> int {
    let t = clamp((ray_y + 0.15) / 0.95, 0.0, 1.0)
    let day_r = 114.0 + 43.0 * t
    let day_g = 181.0 + 48.0 * t
    let day_b = 225.0 + 27.0 * t
    let night_mix = clamp((0.76 - day_light) / 0.55, 0.0, 1.0)
    let night_r = 10.0 + 12.0 * t
    let night_g = 17.0 + 20.0 * t
    let night_b = 42.0 + 48.0 * t
    let red = int(day_r * (1.0 - night_mix) + night_r * night_mix)
    let green = int(day_g * (1.0 - night_mix) + night_g * night_mix)
    let blue = int(day_b * (1.0 - night_mix) + night_b * night_mix)
    return pack_rgb(red, green, blue)
}

