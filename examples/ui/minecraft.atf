// ATF 1.2.0 — BLOCKWORLD DELUXE SURVIVAL
// Infinite seeded voxel terrain with biomes, structures, detailed procedural textures,
// expanded blocks/resources, durable pickaxes, chests, furnace smelting, crafting and survival.
// Controls: WASD, mouse, Space, Shift, Ctrl, LMB mine, RMB place/open chest, E inventory,
// 1-9 hotbar, P equip best pickaxe, H smelt at furnace, Q drop item, F eat apple, Esc pause,
// M map, F3 debug, F6 save, F7 load.
// At night zombies appear: hit them with LMB. Clouds drift overhead, and the render
// resolution drops by itself when frames get slow.

import "std/ui"

const WORLD_W = 128
const WORLD_H = 30
const WORLD_D = 128
const STREAM_CHUNK = 32
const STRUCTURE_CELL = 64
var render_w = 560
var render_h = 315
const FRAME_TIME_MS = 30
const PLAYER_RADIUS = 0.27
const PLAYER_HEIGHT = 1.70
const VIEW_DISTANCE = 28.0
const PI_VALUE = 3.141592653589793

var world: [int] = array_make::<int>(WORLD_W * WORLD_H * WORLD_D)
// Permanent edits are keyed by absolute world coordinates and survive chunk unloading.
var world_edits: {str: int} = {}
var world_origin_x = -64
var world_origin_z = -64
var frame_pixels: [int] = array_make::<int>(render_w * render_h)
