fn surface_block(x: int, z: int) -> int {
    for y in (WORLD_H - 1)..0 step -1 {
        let block = get_block(x, y, z)
        if block != 0 { return block }
    }
    return 0
}

fn player_in_water() -> bool {
    let px = int(floor(player_x))
    let py = int(floor(player_y + 0.15))
    let pz = int(floor(player_z))
    return get_block(px, py, pz) == 8 or get_block(px, int(floor(player_y + 0.85)), pz) == 8
}

fn has_workbench_nearby() -> bool {
    let px = int(floor(player_x))
    let py = int(floor(player_y))
    let pz = int(floor(player_z))
    for bx in (px - 2)..=(px + 2) {
        for by in (py - 1)..=(py + 2) {
            for bz in (pz - 2)..=(pz + 2) {
                if get_block(bx, by, bz) == 14 and abs(bx - px) + abs(by - py) + abs(bz - pz) <= 4 {
                    return true
                }
            }
        }
    }
    return false
}

fn has_furnace_nearby() -> bool {
    let px = int(floor(player_x))
    let py = int(floor(player_y))
    let pz = int(floor(player_z))
    for bx in (px - 3)..=(px + 3) {
        for by in (py - 2)..=(py + 3) {
            for bz in (pz - 3)..=(pz + 3) {
                if get_block(bx, by, bz) == 30 and abs(bx - px) + abs(by - py) + abs(bz - pz) <= 5 { return true }
            }
        }
    }
    return false
}

fn pickaxe_level() -> int {
    if equipped_tool_mode != 0 { return 0 }
    if equipped_pickaxe == 49 { return 4 }
    if equipped_pickaxe == 48 { return 3 }
    if equipped_pickaxe == 47 { return 2 }
    if equipped_pickaxe == 46 { return 1 }
    return 0
}

fn equip_best_pickaxe() {
    equipped_tool_mode = 0
    if inventory[49] > 0 { equipped_pickaxe = 49 }
    else if inventory[48] > 0 { equipped_pickaxe = 48 }
    else if inventory[47] > 0 { equipped_pickaxe = 47 }
    else if inventory[46] > 0 { equipped_pickaxe = 46 }
    else { equipped_pickaxe = 0 }
    if equipped_pickaxe == 0 { status_message = "No pickaxe — craft one in E inventory" }
    else { status_message = "Equipped {block_name(equipped_pickaxe)}" }
    status_timer = 2.0
}

fn use_tool_durability() {
    let level = pickaxe_level()
    if level <= 0 { return }
    let index = level - 1
    tool_durability[index] -= 1
    if tool_durability[index] <= 0 {
        inventory[equipped_pickaxe] = max(0, inventory[equipped_pickaxe] - 1)
        status_message = "{block_name(equipped_pickaxe)} broke!"
        status_timer = 2.5
        tool_durability[index] = if level == 1 { 59 } else if level == 2 { 131 } else if level == 3 { 250 } else { 1561 }
        equipped_pickaxe = 0
        equip_best_pickaxe()
    }
}

fn use_axe_durability() {
    tool_durability[4] -= 1
    if tool_durability[4] <= 0 {
        inventory[50] = max(0, inventory[50] - 1)
        tool_durability[4] = 59
        equipped_tool_mode = 0
        status_message = "Wooden axe broke"
        status_timer = 2.0
    }
}

fn use_shovel_durability() {
    tool_durability[5] -= 1
    if tool_durability[5] <= 0 {
        inventory[51] = max(0, inventory[51] - 1)
        tool_durability[5] = 59
        equipped_tool_mode = 0
        status_message = "Wooden shovel broke"
        status_timer = 2.0
    }
}

fn smelt_ore() {
    if not has_furnace_nearby() {
        status_message = "Place a furnace nearby first"
    } else if inventory[15] <= 0 {
        status_message = "Need coal as furnace fuel"
    } else if inventory[32] > 0 {
        inventory[32] -= 1
        inventory[15] -= 1
        inventory[33] += 1
        status_message = "Smelted raw iron into an iron ingot"
    } else if inventory[34] > 0 {
        inventory[34] -= 1
        inventory[15] -= 1
        inventory[35] += 1
        status_message = "Smelted copper ore into a copper ingot"
    } else {
        status_message = "Need raw iron or copper ore to smelt"
    }
    status_timer = 2.5
}

fn is_placeable_item(item: int) -> bool {
    return item == 1 or item == 2 or item == 3 or item == 4 or item == 5 or item == 6 or item == 11 or item == 12 or item == 13 or item == 14 or item == 20 or item == 21 or item == 22 or item == 23 or item == 24 or item == 25 or item == 26 or item == 27 or item == 28 or item == 29 or item == 30 or item == 31 or item == 38 or item == 39 or item == 40 or item == 41 or item == 42 or item == 43 or item == 44 or item == 52 or item == 53 or item == 54
}

fn cycle_placeable_block() {
    for offset in 1..inventory.len() {
        let candidate = (selected_block + offset) % inventory.len()
        if is_placeable_item(candidate) and inventory[candidate] > 0 {
            select_item(candidate)
            return
        }
    }
    status_message = "No placeable blocks in inventory"
    status_timer = 1.5
}

fn craft_recipe(recipe: int) {
    if recipe == 1 {
        if inventory[4] >= 1 {
            inventory[4] -= 1
            inventory[11] += 4
            blocks_crafted += 4
            status_message = "Crafted 4 oak planks"
        } else if inventory[38] >= 1 {
            inventory[38] -= 1
            inventory[11] += 4
            blocks_crafted += 4
            status_message = "Crafted 4 spruce planks"
        } else {
            status_message = "Need 1 wood log to craft planks"
        }
    } else if recipe == 2 {
        if not has_workbench_nearby() {
            status_message = "Place a workbench nearby first"
        } else if inventory[26] >= 4 and inventory[15] >= 1 {
            inventory[26] -= 4
            inventory[15] -= 1
            inventory[12] += 4
            blocks_crafted += 4
            status_message = "Crafted 4 decorative bricks"
        } else {
            status_message = "Need 4 cobblestone and 1 coal"
        }
    } else if recipe == 3 {
        if not has_workbench_nearby() {
            status_message = "Place a workbench nearby first"
        } else if inventory[6] >= 2 and inventory[15] >= 1 {
            inventory[6] -= 2
            inventory[15] -= 1
            inventory[13] += 2
            blocks_crafted += 2
            status_message = "Crafted 2 glass blocks"
        } else {
            status_message = "Need 2 sand and 1 coal"
        }
    } else if recipe == 4 {
        if inventory[26] >= 2 and inventory[4] >= 4 {
            inventory[4] -= 4
            inventory[26] -= 2
            inventory[14] += 1
            blocks_crafted += 1
            status_message = "Crafted a workbench"
        } else if inventory[26] >= 2 and inventory[38] >= 4 {
            inventory[38] -= 4
            inventory[26] -= 2
            inventory[14] += 1
            blocks_crafted += 1
            status_message = "Crafted a workbench from spruce wood"
        } else {
            status_message = "Need 4 wood logs and 2 cobblestone"
        }
    } else if recipe == 5 {
        if not has_workbench_nearby() {
            status_message = "Place a workbench nearby first"
        } else if inventory[15] >= 2 and inventory[16] >= 1 {
            inventory[15] -= 2
            inventory[16] -= 1
            inventory[20] += 1
            blocks_crafted += 1
            status_message = "Crafted a lantern"
        } else {
            status_message = "Need 2 coal and 1 gold"
        }
    } else if recipe == 6 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[11] >= 3 and inventory[45] >= 2 {
            inventory[11] -= 3; inventory[45] -= 2
            if inventory[46] == 0 { tool_durability[0] = 59 }
            inventory[46] += 1; blocks_crafted += 1
            status_message = "Crafted a wooden pickaxe"
        } else { status_message = "Need 3 planks and 2 sticks" }
    } else if recipe == 7 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[26] >= 3 and inventory[45] >= 2 {
            inventory[26] -= 3; inventory[45] -= 2
            if inventory[47] == 0 { tool_durability[1] = 131 }
            inventory[47] += 1; blocks_crafted += 1
            status_message = "Crafted a stone pickaxe"
        } else { status_message = "Need 3 cobblestone and 2 sticks" }
    } else if recipe == 8 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[26] >= 8 {
            inventory[26] -= 8; inventory[30] += 1; blocks_crafted += 1
            status_message = "Crafted a furnace"
        } else { status_message = "Need 8 cobblestone" }
    } else if recipe == 9 {
        if inventory[15] >= 1 and inventory[45] >= 1 {
            inventory[15] -= 1; inventory[45] -= 1; inventory[29] += 4; blocks_crafted += 4
            status_message = "Crafted 4 torches"
        } else { status_message = "Need 1 coal and 1 stick" }
    } else if recipe == 10 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[33] >= 3 and inventory[45] >= 2 {
            inventory[33] -= 3; inventory[45] -= 2
            if inventory[48] == 0 { tool_durability[2] = 250 }
            inventory[48] += 1; blocks_crafted += 1
            status_message = "Crafted an iron pickaxe"
        } else { status_message = "Need 3 iron ingots and 2 sticks" }
    } else if recipe == 11 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[19] >= 3 and inventory[45] >= 2 {
            inventory[19] -= 3; inventory[45] -= 2
            if inventory[49] == 0 { tool_durability[3] = 1561 }
            inventory[49] += 1; blocks_crafted += 1
            status_message = "Crafted a diamond pickaxe"
        } else { status_message = "Need 3 diamonds and 2 sticks" }
    } else if recipe == 12 {
        if inventory[4] >= 2 {
            inventory[4] -= 2; inventory[45] += 4; blocks_crafted += 4
            status_message = "Crafted 4 sticks"
        } else if inventory[38] >= 2 {
            inventory[38] -= 2; inventory[45] += 4; blocks_crafted += 4
            status_message = "Crafted 4 sticks from spruce wood"
        } else { status_message = "Need 2 wood logs" }
    } else if recipe == 13 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[50] > 0 { status_message = "You already have a wooden axe" }
        else if inventory[11] >= 3 and inventory[45] >= 2 {
            inventory[11] -= 3; inventory[45] -= 2; inventory[50] = 1
            tool_durability[4] = 59; blocks_crafted += 1
            status_message = "Crafted a wooden axe — press O to equip"
        } else { status_message = "Need 3 planks and 2 sticks" }
    } else if recipe == 14 {
        if not has_workbench_nearby() { status_message = "Place a workbench nearby first" }
        else if inventory[51] > 0 { status_message = "You already have a wooden shovel" }
        else if inventory[11] >= 1 and inventory[45] >= 2 {
            inventory[11] -= 1; inventory[45] -= 2; inventory[51] = 1
            tool_durability[5] = 59; blocks_crafted += 1
            status_message = "Crafted a wooden shovel — press L to equip"
        } else { status_message = "Need 1 plank and 2 sticks" }
    }
    status_timer = 3.0
}

fn respawn_player() {
    world_origin_x = -WORLD_W / 2
    world_origin_z = -WORLD_D / 2
    create_world()
    dropped_item_ids.clear()
    dropped_item_xs.clear()
    dropped_item_ys.clear()
    dropped_item_zs.clear()
    dropped_item_ages.clear()
    player_x = float(WORLD_W / 2) + 0.5
    player_z = float(WORLD_D / 2) + 0.5
    player_y = float(terrain_height(0, 0) + 1)
    velocity_y = 0.0
    grounded = true
    health = 20.0
    hunger = 12.0
    update_camera()
    status_message = "You respawned. Inventory kept."
    status_timer = 4.0
}

fn save_world() {
    let buffer = str_builder()
    buffer.add("BW6\n")
    for block in world {
        buffer.add_byte(byte(block + 48))
    }
    buffer.add("\n")
    for i in 0..inventory.len() {
        if i > 0 { buffer.add(",") }
        buffer.add(str(inventory[i]))
    }
    buffer.add("\n")
    buffer.add("{player_x},{player_y},{player_z},{yaw},{pitch},{health},{hunger},{game_time},{world_origin_x},{world_origin_z},{equipped_pickaxe},{equipped_tool_mode}\n")
    buffer.add("{tool_durability[0]},{tool_durability[1]},{tool_durability[2]},{tool_durability[3]},{tool_durability[4]},{tool_durability[5]}\n")
    if world_edits.len() == 0 {
        buffer.add("-")
    } else {
        var first = true
        for key, block in world_edits {
            if not first { buffer.add(";") }
            buffer.add(key)
            buffer.add(":")
            buffer.add(str(block))
            first = false
        }
    }
    if write_file("blockworld.save", buffer.finish()) {
        status_message = "Infinite world, edits, inventory and stats saved"
    } else {
        status_message = "Save failed — check folder permissions"
    }
    status_timer = 4.0
}

fn load_world() {
    let saved = read_file("blockworld.save")
    if saved == nil {
        status_message = "No save found — press F6 to save"
        status_timer = 4.0
        return
    }
    let data = saved!
    let lines = data.lines()
    if lines.len() != 6 or lines[0] != "BW6" or lines[1].len() != world.len() {
        status_message = "Save file invalid or from an older version — start a new save"
        status_timer = 4.0
        return
    }
    for i in 0..world.len() {
        world[i] = int(lines[1].byte_at(i)) - 48
    }
    let inv_parts = lines[2].split(",")
    if inv_parts.len() != inventory.len() {
        status_message = "Save inventory data is invalid"
        status_timer = 4.0
        return
    }
    for i in 0..inventory.len() {
        let count = inv_parts[i].parse_int()
        if count == nil {
            status_message = "Save inventory data is invalid"
            status_timer = 4.0
            return
        }
        inventory[i] = max(0, count!)
    }
    let stats = lines[3].split(",")
    if stats.len() != 12 {
        status_message = "Save player data is invalid"
        status_timer = 4.0
        return
    }
    player_x = float(stats[0])
    player_y = float(stats[1])
    player_z = float(stats[2])
    yaw = float(stats[3])
    pitch = float(stats[4])
    health = clamp(float(stats[5]), 0.0, 20.0)
    hunger = clamp(float(stats[6]), 0.0, 20.0)
    game_time = float(stats[7])
    world_origin_x = int(stats[8])
    world_origin_z = int(stats[9])
    equipped_pickaxe = clamp(int(stats[10]), 0, 49)
    equipped_tool_mode = clamp(int(stats[11]), 0, 2)
    let durability_parts = lines[4].split(",")
    if durability_parts.len() == 6 {
        for i in 0..6 {
            let parsed = durability_parts[i].parse_int()
            if parsed != nil { tool_durability[i] = max(1, parsed!) }
        }
    }

    world_edits.clear()
    if lines[5] != "-" and not lines[5].is_empty() {
        for entry in lines[5].split(";") {
            let edit_parts = entry.split(":")
            if edit_parts.len() == 2 {
                let block = edit_parts[1].parse_int()
                if block != nil {
                    world_edits[edit_parts[0]] = clamp(block!, 0, 54)
                }
            }
        }
    }
    // Reconstruct procedural scenery for the loaded coordinates, then restore player edits.
    for x in 0..WORLD_W { for z in 0..WORLD_D { generate_base_column(x, z) } }
    for tx in -2..=(WORLD_W + 1) {
        for tz in -2..=(WORLD_D + 1) {
            let gx = world_origin_x + tx
            let gz = world_origin_z + tz
            if is_tree_site(gx, gz) { build_tree(tx, tz, terrain_height(gx, gz)) }
        }
    }
    decorate_biome_features()
    decorate_structures_window()
    apply_all_edits_to_window()
    velocity_y = 0.0
    grounded = false
    update_camera()
    status_message = "Infinite world, edits and player stats loaded"
    status_timer = 4.0
}

fn overlaps_player(bx: int, by: int, bz: int) -> bool {
    let overlap_x = float(bx) < player_x + PLAYER_RADIUS and float(bx + 1) > player_x - PLAYER_RADIUS
    let overlap_z = float(bz) < player_z + PLAYER_RADIUS and float(bz + 1) > player_z - PLAYER_RADIUS
    let overlap_y = float(by) < player_y + PLAYER_HEIGHT and float(by + 1) > player_y + 0.02
    return overlap_x and overlap_y and overlap_z
}

fn handle_block_action(left_now: bool, right_now: bool) {
    if left_now and not previous_left and mouse_captured {
        let (block, bx, by, bz, _, _, _, _) = trace_ray(forward_x, forward_y, forward_z, 6.0)
        if block != 0 and block != 7 and block != 8 and bx >= 0 {
            set_player_block(bx, by, bz, 0)
            blocks_mined += 1
            let level = pickaxe_level()
            if block == 9 {
                inventory[15] += 1
                status_message = "Mined coal ore"
            } else if block == 10 {
                if level >= 2 { inventory[16] += 1; status_message = "Mined gold ore" }
                else { status_message = "Gold ore needs a stone pickaxe or better" }
            } else if block == 18 {
                if level >= 3 { inventory[19] += 1; status_message = "Diamond found!" }
                else { status_message = "Diamond ore needs an iron pickaxe or better" }
            } else if block == 32 {
                if level >= 2 { inventory[32] += 1; status_message = "Collected raw iron — smelt it at a furnace" }
                else { status_message = "Iron ore needs a stone pickaxe or better" }
            } else if block == 34 {
                if level >= 1 { inventory[34] += 1; status_message = "Collected copper ore — smelt it at a furnace" }
                else { status_message = "Copper ore needs a pickaxe" }
            } else if block == 36 {
                if level >= 2 { inventory[37] += 4; status_message = "Collected 4 redstone dust" }
                else { status_message = "Redstone ore needs a stone pickaxe or better" }
            } else if block == 3 {
                inventory[26] += 1
                status_message = "Collected cobblestone"
            } else if block == 4 {
                inventory[4] += if equipped_tool_mode == 1 { 2 } else { 1 }
                status_message = if equipped_tool_mode == 1 { "Axe chopped oak logs quickly" } else { "Collected oak log" }
            } else if block == 38 {
                inventory[38] += if equipped_tool_mode == 1 { 2 } else { 1 }
                status_message = if equipped_tool_mode == 1 { "Axe chopped spruce logs quickly" } else { "Collected spruce log" }
            } else if block == 5 or block == 39 {
                let leaves_item = if block == 5 { 5 } else { 39 }
                inventory[leaves_item] += 1
                if abs(bx * 19 + by * 11 + bz * 7) % 7 == 0 { inventory[17] += 1; status_message = "Leaves dropped an apple!" }
                else if abs(bx * 7 + bz * 13) % 3 == 0 { inventory[45] += 1; status_message = "Leaves dropped a stick" }
                else { status_message = "Collected {block_name(block)}" }
            } else if block == 27 or block == 40 {
                inventory[block] += 1
                status_message = "Collected {block_name(block)}"
            } else if block == 30 {
                inventory[30] += 1
                status_message = "Collected furnace"
            } else if block == 31 {
                // Treasure chests from generated structures can also be mined and carried.
                inventory[31] += 1
                status_message = "Collected chest"
            } else if is_placeable_item(block) {
                inventory[block] += 1
                if equipped_tool_mode == 2 and (block == 6 or block == 21 or block == 41) {
                    inventory[block] += 1
                    status_message = "Shovel collected 2 {block_name(block)}"
                } else { status_message = "Collected {block_name(block)}" }
                if block == 5 and abs(bx * 19 + by * 11 + bz * 7) % 5 == 0 { inventory[17] += 1 }
            } else {
                status_message = "Mined {block_name(block)}"
            }
            if equipped_tool_mode == 0 {
                if level > 0 { use_tool_durability() }
            } else if equipped_tool_mode == 1 {
                use_axe_durability()
            } else if equipped_tool_mode == 2 {
                use_shovel_durability()
            }
            status_timer = 2.0
        }
    }

    if right_now and not previous_right and mouse_captured {
        let (block, bx, by, bz, ax, ay, az, _) = trace_ray(forward_x, forward_y, forward_z, 6.0)
        if block == 31 and bx >= 0 {
            // Deterministic loot: each chest can only be opened once because it is removed.
            set_player_block(bx, by, bz, 0)
            inventory[33] += 1 + abs((world_origin_x + bx) * 3 + (world_origin_z + bz) * 7) % 3
            inventory[15] += 2
            if abs((world_origin_x + bx) * 13 + (world_origin_z + bz) * 17) % 4 == 0 { inventory[19] += 1 }
            if abs(bx * 7 + bz * 11) % 2 == 0 { inventory[17] += 1 }
            status_message = "Chest looted: ingots, coal and supplies!"
            status_timer = 3.0
        } else {
            let target_in_bounds = ax >= 0 and ax < WORLD_W and ay >= 0 and ay < WORLD_H and az >= 0 and az < WORLD_D
            if block != 0 and bx >= 0 and target_in_bounds and is_placeable_item(selected_block) and get_block(ax, ay, az) == 0 and not overlaps_player(ax, ay, az) {
                if inventory[selected_block] > 0 {
                    set_player_block(ax, ay, az, selected_block)
                    inventory[selected_block] -= 1
                    blocks_placed += 1
                    status_message = "Placed {block_name(selected_block)}"
                    status_timer = 1.2
                } else {
                    status_message = "No {block_name(selected_block)} left — mine or craft more"
                    status_timer = 2.0
                }
            }
        }
    }

    previous_left = left_now
    previous_right = right_now
}

fn drop_selected_item() {
    if selected_block < 1 or selected_block >= inventory.len() {
        status_message = "No item selected"
        status_timer = 1.4
        return
    }
    if inventory[selected_block] <= 0 {
        status_message = "Nothing to drop"
        status_timer = 1.4
        return
    }
    if dropped_item_ids.len() >= 40 {
        status_message = "Too many dropped items nearby"
        status_timer = 1.8
        return
    }
    inventory[selected_block] -= 1
    dropped_item_ids.push(selected_block)
    dropped_item_xs.push(player_x + sin_atf(yaw) * 1.35)
    dropped_item_ys.push(player_y + 0.65)
    dropped_item_zs.push(player_z + cos_atf(yaw) * 1.35)
    dropped_item_ages.push(0.0)
    status_message = "Dropped {block_name(selected_block)}"
    status_timer = 1.4
}

fn update_dropped_items() {
    var i = dropped_item_ids.len() - 1
    while i >= 0 {
        dropped_item_ages[i] += 0.03
        let nx = int(floor(dropped_item_xs[i]))
        let nz = int(floor(dropped_item_zs[i]))
        let next_y = dropped_item_ys[i] - 0.025
        let ny = int(floor(next_y))
        if get_block(nx, ny, nz) != 0 {
            dropped_item_ys[i] = float(ny + 1) + 0.08
        } else {
            dropped_item_ys[i] = next_y
        }
        // Slowly bob like the floating item sprites in Minecraft.
        dropped_item_ys[i] += sin_atf(game_time * 3.0 + float(i)) * 0.0015
        let dx = player_x - dropped_item_xs[i]
        let dy = (player_y + 0.6) - dropped_item_ys[i]
        let dz = player_z - dropped_item_zs[i]
        if sqrt(dx * dx + dy * dy + dz * dz) < 1.25 {
            let item = dropped_item_ids[i]
            inventory[item] += 1
            status_message = "Picked up {block_name(item)}"
            status_timer = 1.1
            dropped_item_ids.remove(i)
            dropped_item_xs.remove(i)
            dropped_item_ys.remove(i)
            dropped_item_zs.remove(i)
            dropped_item_ages.remove(i)
        } else if dropped_item_ages[i] > 180.0 {
            dropped_item_ids.remove(i)
            dropped_item_xs.remove(i)
            dropped_item_ys.remove(i)
            dropped_item_zs.remove(i)
            dropped_item_ages.remove(i)
        }
        i -= 1
    }
}

fn apply_render_level() {
    let widths = [560, 400, 280]
    let heights = [315, 225, 158]
    render_w = widths[render_level]
    render_h = heights[render_level]
    frame_pixels = array_make::<int>(render_w * render_h)
    column_screen_x = []
    // Pretend the rate is fine so the new size gets time to prove itself.
    fps_value = 25.0
    status_message = "Render quality lowered to {render_w}x{render_h}"
    status_timer = 2.0
}

fn remove_mob(i: int) {
    mob_xs.remove(i)
    mob_ys.remove(i)
    mob_zs.remove(i)
    mob_hps.remove(i)
    mob_cooldowns.remove(i)
}

fn spawn_mob() {
    let angle = float(rand_int(0, 627)) / 100.0
    let dist = 14.0 + float(rand_int(0, 600)) / 100.0
    let ix = int(floor(player_x + sin_atf(angle) * dist))
    let iz = int(floor(player_z + cos_atf(angle) * dist))
    if ix < 2 or iz < 2 or ix >= WORLD_W - 2 or iz >= WORLD_D - 2 { return }
    var gy = WORLD_H - 3
    while gy > 1 and get_block(ix, gy, iz) == 0 { gy -= 1 }
    let ground = get_block(ix, gy, iz)
    if ground != 8 and ground != 23 and get_block(ix, gy + 1, iz) == 0 and get_block(ix, gy + 2, iz) == 0 {
        mob_xs.push(float(ix) + 0.5)
        mob_ys.push(float(gy + 1))
        mob_zs.push(float(iz) + 0.5)
        mob_hps.push(8)
        mob_cooldowns.push(0.6)
    }
}

fn update_mobs() {
    mob_spawn_timer += 0.03
    if day_light < 0.55 and mob_xs.len() < 4 and mob_spawn_timer > 4.0 {
        mob_spawn_timer = 0.0
        spawn_mob()
    }
    var i = mob_xs.len() - 1
    while i >= 0 {
        let dx = player_x - mob_xs[i]
        let dz = player_z - mob_zs[i]
        let dist = sqrt(dx * dx + dz * dz)
        if (day_light > 0.72 and dist > 3.0) or dist > 45.0 {
            remove_mob(i)
        } else {
            if dist > 0.9 {
                let nx = mob_xs[i] + dx / dist * 0.045
                if not collides_body(nx, mob_ys[i], mob_zs[i]) {
                    mob_xs[i] = nx
                } else if not collides_body(nx, mob_ys[i] + 1.0, mob_zs[i]) {
                    mob_xs[i] = nx
                    mob_ys[i] += 1.0
                }
                let nz = mob_zs[i] + dz / dist * 0.045
                if not collides_body(mob_xs[i], mob_ys[i], nz) {
                    mob_zs[i] = nz
                } else if not collides_body(mob_xs[i], mob_ys[i] + 1.0, nz) {
                    mob_zs[i] = nz
                    mob_ys[i] += 1.0
                }
            }
            if not collides_body(mob_xs[i], mob_ys[i] - 0.1, mob_zs[i]) { mob_ys[i] -= 0.15 }
            if mob_ys[i] < -2.0 {
                remove_mob(i)
            } else if dist < 1.3 and abs(mob_ys[i] - player_y) < 1.6 {
                mob_cooldowns[i] -= 0.03
                if mob_cooldowns[i] <= 0.0 {
                    mob_cooldowns[i] = 1.0
                    health = max(0.0, health - 2.0)
                    status_message = "A zombie hits you! HP {int(health)}"
                    status_timer = 1.2
                }
            }
        }
        i -= 1
    }
}

fn attack_mobs() {
    for i in 0..mob_xs.len() {
        let tx = mob_xs[i] - camera_x
        let ty = (mob_ys[i] + 0.9) - camera_y
        let tz = mob_zs[i] - camera_z
        let d = sqrt(tx * tx + ty * ty + tz * tz)
        if d < 3.6 and d > 0.01 and (tx * forward_x + ty * forward_y + tz * forward_z) / d > 0.9 {
            mob_hps[i] -= 4
            let kx = mob_xs[i] + tx / d * 0.6
            let kz = mob_zs[i] + tz / d * 0.6
            if not collides_body(kx, mob_ys[i], kz) {
                mob_xs[i] = kx
                mob_zs[i] = kz
            }
            if mob_hps[i] <= 0 {
                remove_mob(i)
                status_message = "Zombie defeated!"
            } else {
                status_message = "Hit! Zombie HP {mob_hps[i]}"
            }
            status_timer = 1.0
            return
        }
    }
}

fn game_tick() {
    let escape_now = ui_key_down("escape")
    if escape_now and not previous_escape {
        if show_crafting {
            close_inventory()
            show_crafting = false
            show_pause = false
            mouse_captured = true
            ui_mouse_capture(true)
        } else if show_pause {
            show_pause = false
            mouse_captured = true
            ui_mouse_capture(true)
        } else {
            show_pause = true
            mouse_captured = false
            ui_mouse_capture(false)
        }
    }
    previous_escape = escape_now
    crouching = ui_key_down("shift")

    // Save/load use F6/F7 so F5 remains free for a familiar Minecraft binding.
    let save_now = ui_key_down("f6")
    if save_now and not previous_f6 { save_world() }
    previous_f6 = save_now
    let load_now = ui_key_down("f7")
    if load_now and not previous_f7 { load_world() }
    previous_f7 = load_now

    if show_pause {
        let pause_click = ui_mouse_held(0)
        if pause_click {
            show_pause = false
            mouse_captured = true
            ui_mouse_capture(true)
        }
        previous_left = pause_click
        previous_right = ui_mouse_held(1)
        return
    }

    let inventory_now = ui_key_down("e")
    if inventory_now and not previous_e {
        show_crafting = not show_crafting
        if show_crafting {
            inv_big = has_workbench_nearby()
            inv_held = -1
            mouse_captured = false
            ui_mouse_capture(false)
        } else {
            close_inventory()
            mouse_captured = true
            ui_mouse_capture(true)
        }
    }
    previous_e = inventory_now

    let drop_now = ui_key_down("q")
    if drop_now and not previous_q and not show_crafting {
        drop_selected_item()
    }
    previous_q = drop_now

    let lantern_now = ui_key_down("v")
    if lantern_now and not previous_v and not show_crafting and inventory[20] > 0 {
        select_item(20)
    }
    previous_v = lantern_now

    let equip_now = ui_key_down("p")
    if equip_now and not previous_p { equip_best_pickaxe() }
    previous_p = equip_now
    let axe_now = ui_key_down("o")
    if axe_now and not previous_o {
        if inventory[50] > 0 { equipped_tool_mode = 1; status_message = "Equipped wooden axe" }
        else { status_message = "Craft a wooden axe in E inventory first" }
        status_timer = 2.0
    }
    previous_o = axe_now
    let shovel_now = ui_key_down("l")
    if shovel_now and not previous_l {
        if inventory[51] > 0 { equipped_tool_mode = 2; status_message = "Equipped wooden shovel" }
        else { status_message = "Craft a wooden shovel in E inventory first" }
        status_timer = 2.0
    }
    previous_l = shovel_now
    let smelt_now = ui_key_down("h")
    if smelt_now and not previous_h and not show_crafting { smelt_ore() }
    previous_h = smelt_now

    let block_cycle_now = ui_key_down("b")
    if block_cycle_now and not previous_b and not show_crafting { cycle_placeable_block() }
    previous_b = block_cycle_now

    let map_now = ui_key_down("m")
    if map_now and not previous_m { show_map = not show_map }
    previous_m = map_now
    let debug_now = ui_key_down("f3")
    if debug_now and not previous_f3 { show_debug = not show_debug }
    previous_f3 = debug_now
    let eat_now = ui_key_down("f")
    if eat_now and not previous_f and inventory[17] > 0 and (hunger < 20.0 or health < 20.0) {
        inventory[17] -= 1
        hunger = min(20.0, hunger + 6.0)
        health = min(20.0, health + 1.0)
        status_message = "Ate an apple (+food and health)"
        status_timer = 2.2
    }
    previous_f = eat_now

    let key1 = ui_key_down("1")
    let key2 = ui_key_down("2")
    let key3 = ui_key_down("3")
    let key4 = ui_key_down("4")
    let key5 = ui_key_down("5")
    let key6 = ui_key_down("6")
    let key7 = ui_key_down("7")
    let key8 = ui_key_down("8")
    let key9 = ui_key_down("9")
    if not show_crafting {
        if key1 { selected_slot = 0 }
        if key2 { selected_slot = 1 }
        if key3 { selected_slot = 2 }
        if key4 { selected_slot = 3 }
        if key5 { selected_slot = 4 }
        if key6 { selected_slot = 5 }
        if key7 { selected_slot = 6 }
        if key8 { selected_slot = 7 }
        if key9 { selected_slot = 8 }
    }
    previous_1 = key1
    previous_2 = key2
    previous_3 = key3
    previous_4 = key4
    previous_5 = key5
    previous_6 = key6
    previous_7 = key7
    previous_8 = key8
    previous_9 = key9

    let now = clock()
    if last_tick_time > 0.0 {
        let delta = now - last_tick_time
        if delta > 0.001 { fps_value = fps_value * 0.82 + (1.0 / delta) * 0.18 }
    }
    last_tick_time = now
    game_time += 0.03
    day_light = 0.60 + 0.40 * sin_atf(game_time * 0.0349 + PI_VALUE / 2.0)
    if status_timer > 0.0 { status_timer -= 0.03 }

    hunger_timer += 0.03
    if hunger_timer >= 24.0 {
        hunger_timer -= 24.0
        if hunger > 0.0 { hunger = max(0.0, hunger - 1.0) }
    }
    if hunger >= 18.0 and health < 20.0 {
        regen_timer += 0.03
        if regen_timer >= 8.0 {
            regen_timer = 0.0
            health = min(20.0, health + 1.0)
            hunger = max(0.0, hunger - 1.0)
        }
    } else if hunger <= 0.0 {
        starvation_timer += 0.03
        if starvation_timer >= 5.0 {
            starvation_timer = 0.0
            health = max(1.0, health - 1.0)
        }
    } else {
        regen_timer = 0.0
        starvation_timer = 0.0
    }

    let left_now = ui_mouse_held(0)
    let right_now = ui_mouse_held(1)
    if not mouse_captured and not show_crafting {
        if left_now or right_now {
            mouse_captured = true
            ui_mouse_capture(true)
            previous_left = left_now
            previous_right = right_now
        }
    }

    if mouse_captured {
        let (mouse_dx, mouse_dy) = ui_mouse_delta()
        yaw += float(mouse_dx) * 0.0028
        pitch -= float(mouse_dy) * 0.0025
        pitch = clamp(pitch, -1.35, 1.35)
        while yaw > PI_VALUE { yaw -= 2.0 * PI_VALUE }
        while yaw < -PI_VALUE { yaw += 2.0 * PI_VALUE }
    }

    let in_water = player_in_water()

    if collides_body(player_x, player_y - 0.06, player_z) {
        grounded = true
        if velocity_y < 0.0 {
            if not in_water and velocity_y < -10.0 {
                health = max(0.0, health - ((-velocity_y - 8.0) * 1.2))
                status_message = "Fall damage! HP {int(health)}"
                status_timer = 2.0
            }
            velocity_y = 0.0
            player_y = float(floor(player_y - 0.06)) + 1.0
        }
    } else {
        grounded = false
    }

    let space_now = ui_key_down("space")
    if space_now and grounded and not show_crafting {
        velocity_y = if in_water { 3.8 } else { 7.4 }
        grounded = false
    } else if in_water and space_now and not previous_space and not show_crafting {
        velocity_y = 3.3
        grounded = false
    }
    previous_space = space_now

    var move_x = 0.0
    var move_z = 0.0
    let flat_forward_x = sin_atf(yaw)
    let flat_forward_z = cos_atf(yaw)
    let flat_right_x = cos_atf(yaw)
    let flat_right_z = -sin_atf(yaw)

    if ui_key_down("w") { move_x += flat_forward_x; move_z += flat_forward_z }
    if ui_key_down("s") { move_x -= flat_forward_x; move_z -= flat_forward_z }
    if ui_key_down("d") { move_x += flat_right_x; move_z += flat_right_z }
    if ui_key_down("a") { move_x -= flat_right_x; move_z -= flat_right_z }

    let move_length = sqrt(move_x * move_x + move_z * move_z)
    if move_length > 0.001 and not show_crafting {
        var speed = if in_water { 2.5 } else { 4.2 }
        if ui_key_down("shift") { speed = if in_water { 1.25 } else { 2.0 } }
        if ui_key_down("ctrl") and not ui_key_down("shift") { speed = if in_water { 3.4 } else { 6.5 } }
        if ui_key_down("ctrl") and not ui_key_down("shift") { hunger_timer += 0.012 }
        move_x = move_x / move_length * speed * 0.03
        move_z = move_z / move_length * speed * 0.03
        move_horizontal(move_x, move_z)
    }

    if not grounded {
        if in_water {
            velocity_y -= 5.0 * 0.03
            velocity_y = max(-3.0, velocity_y)
        } else {
            velocity_y -= 18.0 * 0.03
        }
        let next_y = player_y + velocity_y * 0.03
        if collides_body(player_x, next_y, player_z) {
            if velocity_y <= 0.0 {
                if not in_water and velocity_y < -10.0 {
                    health = max(0.0, health - ((-velocity_y - 8.0) * 1.2))
                    status_message = "Fall damage! HP {int(health)}"
                    status_timer = 2.0
                }
                player_y = float(floor(next_y)) + 1.0
                grounded = true
            } else {
                player_y = float(floor(next_y + PLAYER_HEIGHT)) - PLAYER_HEIGHT
            }
            velocity_y = 0.0
        } else {
            player_y = next_y
        }
    } else {
        velocity_y = 0.0
    }

    // Cactus contact chips health once per second; plants remain non-solid enough to walk through only where intended.
    let feet_block = get_block(int(floor(player_x)), int(floor(player_y + 0.2)), int(floor(player_z)))
    let body_block = get_block(int(floor(player_x)), int(floor(player_y + 0.9)), int(floor(player_z)))
    if feet_block == 24 or body_block == 24 {
        cactus_timer += 0.03
        if cactus_timer >= 1.0 {
            cactus_timer = 0.0
            health = max(0.0, health - 1.0)
            status_message = "Cactus damage!"
            status_timer = 1.0
        }
    } else { cactus_timer = 0.0 }
    if player_y < -3.0 { health = 0.0 }
    if health <= 0.0 { respawn_player() }

    stream_world_if_needed()
    update_camera()
    if inv_click_pending {
        inv_click_pending = false
        if show_crafting { handle_inventory_click(inv_click_x, inv_click_y) }
    }
    sync_slots()
    selected_block = slot_items[selected_slot]
    if selected_block != last_selected_block {
        last_selected_block = selected_block
        item_name_timer = 2.0
    }
    if item_name_timer > 0.0 { item_name_timer -= 0.03 }
    let attack_now = left_now and not previous_attack
    previous_attack = left_now
    if attack_now and mouse_captured and not show_crafting { attack_mobs() }
    handle_block_action(left_now, right_now)
    update_dropped_items()
    update_mobs()

    quality_timer += 0.03
    if quality_timer > 2.0 {
        quality_timer = 0.0
        if fps_value > 0.0 and fps_value < 16.0 and render_level < 2 {
            render_level += 1
            apply_render_level()
        }
    }
}

fn draw_slot(c: Canvas, x: int, y: int, size: int, selected: bool) {
    c.rect(x, y, size, size, rgb(24, 24, 24))
    c.rect(x + 1, y + 1, size - 2, size - 2, rgb(190, 190, 190))
    c.rect(x + 2, y + 2, size - 4, size - 4, rgb(80, 80, 80))
    c.line(x + 2, y + 2, x + size - 3, y + 2, 1, rgb(224, 224, 224))
    c.line(x + 2, y + 2, x + 2, y + size - 3, 1, rgb(224, 224, 224))
    c.line(x + 2, y + size - 3, x + size - 3, y + size - 3, 1, rgb(42, 42, 42))
    c.line(x + size - 3, y + 2, x + size - 3, y + size - 3, 1, rgb(42, 42, 42))
    if selected {
        c.outline(x - 2, y - 2, size + 4, size + 4, 0, 2, rgb(255, 255, 255))
    }
}

fn draw_block_icon(c: Canvas, x: int, y: int, size: int, block: int) {
    let inner = size - 4
    let px = x + 2
    let py = y + 2
    let base = block_ui_color(block)
    c.rect(px, py, inner, inner, base)
    if block == 1 {
        c.rect(px, py, inner, max(4, inner / 3), rgb(82, 172, 61))
        c.rect(px + 3, py + 2, 3, 2, rgb(112, 198, 72))
        c.rect(px + inner - 7, py + 3, 3, 2, rgb(60, 143, 50))
        c.rect(px, py + max(4, inner / 3), inner, inner - max(4, inner / 3), rgb(132, 88, 52))
        c.rect(px + 4, py + inner - 5, 3, 2, rgb(105, 66, 42))
    } else if block == 2 {
        c.rect(px + 4, py + 5, 3, 2, rgb(108, 68, 42))
        c.rect(px + inner - 7, py + 10, 3, 2, rgb(165, 112, 67))
        c.rect(px + 8, py + inner - 6, 2, 2, rgb(115, 73, 43))
    } else if block == 3 or block == 9 or block == 10 or block == 18 {
        c.rect(px + 4, py + 4, 3, 2, rgb(157, 161, 166))
        c.rect(px + inner - 8, py + 6, 4, 2, rgb(89, 92, 98))
        c.rect(px + 7, py + inner - 6, 3, 2, rgb(89, 92, 98))
        c.line(px + 5, py + 8, px + 10, py + 12, 1, rgb(75, 78, 84))
        if block == 9 { c.rect(px + inner / 2, py + inner / 2, 5, 4, rgb(35, 35, 35)) }
        if block == 10 { c.rect(px + inner / 2, py + inner / 2, 5, 4, rgb(245, 194, 50)) }
        if block == 18 { c.rect(px + inner / 2, py + inner / 2, 5, 4, rgb(60, 230, 244)) }
    } else if block == 4 {
        c.rect(px + 4, py, 3, inner, rgb(104, 66, 37))
        c.rect(px + inner - 7, py, 2, inner, rgb(168, 116, 63))
    } else if block == 5 {
        for yy in 0..4 {
            for xx in 0..4 {
                if (xx * 7 + yy * 11 + block) % 3 != 0 {
                    c.rect(px + 3 + xx * max(1, inner / 5), py + 3 + yy * max(1, inner / 5), 2, 2, rgb(46, 123, 42))
                }
            }
        }
    } else if block == 6 {
        c.rect(px + 4, py + 5, 2, 2, rgb(242, 223, 160))
        c.rect(px + inner - 7, py + 10, 2, 2, rgb(195, 177, 113))
        c.rect(px + 9, py + inner - 6, 2, 2, rgb(243, 225, 171))
    } else if block == 11 {
        c.line(px, py + inner / 3, px + inner - 1, py + inner / 3, 1, rgb(111, 72, 42))
        c.line(px, py + (inner * 2) / 3, px + inner - 1, py + (inner * 2) / 3, 1, rgb(111, 72, 42))
        c.rect(px + 5, py + 4, 2, 2, rgb(205, 157, 98))
    } else if block == 12 {
        c.line(px, py + inner / 3, px + inner - 1, py + inner / 3, 1, rgb(226, 160, 139))
        c.line(px, py + (inner * 2) / 3, px + inner - 1, py + (inner * 2) / 3, 1, rgb(226, 160, 139))
        c.line(px + inner / 2, py + 1, px + inner / 2, py + inner / 3, 1, rgb(226, 160, 139))
        c.line(px + inner / 3, py + inner / 3, px + inner / 3, py + (inner * 2) / 3, 1, rgb(226, 160, 139))
    } else if block == 13 {
        c.rect(px + 2, py + 2, inner - 4, inner - 4, rgb(153, 215, 231))
        c.rect(px + 4, py + 3, 3, inner - 6, rgb(224, 249, 255))
        c.line(px + 2, py + inner - 4, px + inner - 3, py + inner - 4, 1, rgb(107, 180, 204))
    } else if block == 14 {
        c.rect(px + 2, py + 2, inner - 4, inner - 4, rgb(177, 125, 66))
        c.line(px + 2, py + inner / 2, px + inner - 3, py + inner / 2, 2, rgb(100, 62, 36))
        c.line(px + inner / 2, py + 2, px + inner / 2, py + inner - 3, 2, rgb(100, 62, 36))
    } else if block == 20 {
        c.rect(px + inner / 3, py + 3, inner / 3, inner - 6, rgb(255, 181, 52))
        c.rect(px + inner / 3 + 2, py + 5, max(2, inner / 3 - 4), inner - 10, rgb(255, 231, 128))
        c.line(px + 3, py + 3, px + inner - 4, py + 3, 2, rgb(82, 82, 82))
    } else if block == 15 {
        c.rect(px + 4, py + 4, 4, 4, rgb(35, 35, 35))
        c.rect(px + inner - 8, py + 9, 4, 3, rgb(35, 35, 35))
    } else if block == 16 {
        c.rect(px + 4, py + 4, 4, 4, rgb(247, 191, 39))
        c.rect(px + inner - 8, py + 9, 4, 3, rgb(247, 191, 39))
    } else if block == 17 {
        c.circle(px + inner / 2, py + inner / 2, max(3, inner / 3), rgb(207, 42, 35))
        c.rect(px + inner / 2, py + 2, 3, 5, rgb(57, 121, 43))
    } else if block == 19 {
        c.rect(px + inner / 2 - 2, py + inner / 2 - 2, 5, 5, rgb(71, 238, 247))
        c.rect(px + inner / 2, py + inner / 2, 3, 3, rgb(218, 255, 255))
    } else if block == 21 {
        for n in 0..7 { c.rect(px + (n * 7 + 3) % max(1, inner), py + (n * 11 + 2) % max(1, inner), 3, 2, rgb(183, 179, 169)) }
    } else if block == 22 or block == 23 {
        c.rect(px + 3, py + 3, inner - 6, inner - 6, if block == 22 { rgb(244, 249, 255) } else { rgb(170, 226, 245) })
        c.line(px + 5, py + inner / 2, px + inner - 6, py + inner / 2 + 3, 1, rgb(201, 234, 247))
    } else if block == 24 {
        c.rect(px + inner / 3, py, max(3, inner / 3), inner, rgb(45, 139, 50))
        c.line(px + inner / 3, py + 5, px + inner * 2 / 3, py + 5, 1, rgb(206, 222, 170))
        c.line(px + inner / 3, py + inner - 7, px + inner * 2 / 3, py + inner - 7, 1, rgb(206, 222, 170))
    } else if block == 25 {
        c.line(px + 2, py + inner / 3, px + inner - 3, py + inner / 3, 1, rgb(166, 145, 101))
        c.line(px + 2, py + (inner * 2) / 3, px + inner - 3, py + (inner * 2) / 3, 1, rgb(166, 145, 101))
    } else if block == 26 or block == 27 or block == 40 {
        for n in 0..5 { c.rect(px + (n * 7 + 2) % max(1, inner), py + (n * 9 + 3) % max(1, inner), 5, 4, if block == 27 or block == 40 { rgb(81, 126, 76) } else { rgb(155, 159, 164) }) }
    } else if block == 28 or block == 44 {
        c.rect(px + inner / 2 - 2, py + inner / 2, 4, inner / 2 - 2, rgb(55, 126, 46))
        c.circle(px + inner / 2, py + inner / 3, max(3, inner / 4), if block == 28 { rgb(221, 65, 148) } else { rgb(194, 49, 43) })
        c.circle(px + inner / 2 - 2, py + inner / 3 - 2, 2, rgb(250, 242, 208))
    } else if block == 29 {
        c.rect(px + inner / 3, py + 2, max(3, inner / 3), inner - 4, rgb(130, 83, 43))
        c.rect(px + inner / 3, py + 3, max(3, inner / 3), max(5, inner / 3), rgb(255, 174, 48))
    } else if block == 30 {
        c.rect(px + 3, py + 3, inner - 6, inner - 6, rgb(100, 104, 110))
        c.rect(px + inner / 3, py + inner / 3, inner / 3, inner / 3, rgb(41, 37, 36))
        c.line(px + 4, py + inner - 5, px + inner - 5, py + inner - 5, 1, rgb(180, 180, 180))
    } else if block == 31 {
        c.rect(px + 3, py + 4, inner - 6, inner - 8, rgb(151, 91, 43))
        c.line(px + 3, py + inner / 2, px + inner - 3, py + inner / 2, 2, rgb(83, 52, 28))
        c.rect(px + inner / 2 - 2, py + inner / 2 - 2, 5, 7, rgb(230, 183, 66))
    } else if block == 32 or block == 34 or block == 36 {
        c.rect(px + 4, py + 4, 4, 4, if block == 32 { rgb(167, 112, 78) } else if block == 34 { rgb(199, 125, 68) } else { rgb(190, 40, 46) })
        c.rect(px + inner - 9, py + 8, 5, 4, if block == 32 { rgb(167, 112, 78) } else if block == 34 { rgb(199, 125, 68) } else { rgb(190, 40, 46) })
    } else if block == 33 or block == 35 {
        c.rect(px + 4, py + inner / 3, inner - 8, inner / 3, if block == 33 { rgb(207, 211, 216) } else { rgb(190, 123, 70) })
        c.line(px + 5, py + inner / 3, px + inner - 5, py + inner / 3, 1, rgb(245, 245, 245))
    } else if block == 37 {
        c.line(px + 3, py + 3, px + inner - 3, py + inner - 3, 3, rgb(196, 31, 39))
        c.line(px + 4, py + inner - 4, px + inner - 4, py + 4, 2, rgb(220, 48, 55))
    } else if block == 38 or block == 39 or block == 41 or block == 42 or block == 43 or block == 45 {
        c.line(px + 4, py + 5, px + inner - 5, py + inner - 6, 2, block_ui_color(block))
        c.line(px + 4, py + inner - 5, px + inner - 5, py + 5, 1, rgb(224, 224, 224))
    } else if block == 52 {
        for yy in 0..4 { for xx in 0..4 { if (xx * 5 + yy * 3) % 3 == 0 { c.rect(px + 3 + xx * max(1, inner / 5), py + 3 + yy * max(1, inner / 5), 4, 4, rgb(255, 224, 130)) } } }
    } else if block == 53 {
        for yy in 0..4 { for xx in 0..4 { if (xx * 7 + yy * 11) % 3 != 0 { c.rect(px + 3 + xx * max(1, inner / 5), py + 3 + yy * max(1, inner / 5), 4, 3, rgb(52, 93, 39)) } } }
    } else if block == 54 {
        c.line(px + 2, py + inner / 3, px + inner - 2, py + inner / 3, 2, rgb(91, 56, 31))
        c.line(px + 2, py + (inner * 2) / 3, px + inner - 2, py + (inner * 2) / 3, 2, rgb(91, 56, 31))
        c.rect(px + 5, py + 4, 4, 8, rgb(126, 48, 39))
        c.rect(px + 12, py + 4, 4, 8, rgb(60, 92, 142))
        c.rect(px + 20, py + 4, 4, 8, rgb(202, 177, 74))
    } else if block >= 46 and block <= 51 {
        c.line(px + 4, py + inner - 4, px + inner - 5, py + 4, 4, rgb(134, 93, 54))
        let tool_color = if block == 46 or block == 50 or block == 51 { rgb(179, 135, 72) } else if block == 47 { rgb(156, 161, 166) } else if block == 48 { rgb(217, 220, 223) } else { rgb(64, 225, 237) }
        c.line(px + inner / 2, py + 5, px + inner - 3, py + 5, 4, tool_color)
        c.line(px + inner / 2 + 2, py + 5, px + inner / 2 + 2, py + 11, 3, tool_color)
    }
}

fn draw_heart(c: Canvas, x: int, y: int, amount: int) {
    for row in 0..8 {
        for col in 0..8 {
            var pixel = false
            if row == 0 and (col == 1 or col == 2 or col == 5 or col == 6) { pixel = true }
            if row == 1 and col >= 0 and col <= 7 { pixel = true }
            if row >= 2 and row <= 4 and col >= 0 and col <= 7 { pixel = true }
            if row == 5 and col >= 1 and col <= 6 { pixel = true }
            if row == 6 and col >= 2 and col <= 5 { pixel = true }
            if row == 7 and (col == 3 or col == 4) { pixel = true }
            if pixel {
                var color = rgb(73, 20, 27)
                if amount == 2 { color = rgb(214, 45, 56) }
                if amount == 1 and col < 4 { color = rgb(214, 45, 56) }
                c.rect(x + col * 2, y + row * 2, 2, 2, color)
            }
        }
    }
}

fn draw_food(c: Canvas, x: int, y: int, amount: int) {
    for row in 0..8 {
        for col in 0..8 {
            var pixel = false
            if row == 0 and col == 5 { pixel = true }
            if row == 1 and col >= 4 and col <= 6 { pixel = true }
            if row == 2 and col >= 3 and col <= 6 { pixel = true }
            if row == 3 and col >= 2 and col <= 5 { pixel = true }
            if row == 4 and col >= 1 and col <= 4 { pixel = true }
            if row == 5 and col >= 0 and col <= 3 { pixel = true }
            if row == 6 and col >= 0 and col <= 2 { pixel = true }
            if pixel {
                var color = rgb(78, 42, 28)
                if amount == 2 { color = rgb(177, 78, 34) }
                if amount == 1 and row <= 3 { color = rgb(177, 78, 34) }
                if col <= 1 and row >= 5 and amount > 0 { color = rgb(226, 211, 174) }
                c.rect(x + col * 2, y + row * 2, 2, 2, color)
            }
        }
    }
}

// A recessed slot: dark top and left edges, light bottom and right edges, like the original.
fn mc_slot(c: Canvas, x: int, y: int, s: int) {
    let fx = x - s
    let fy = y - s
    let size = 18 * s
    c.rect(fx, fy, size, size, rgb(139, 139, 139))
    c.rect(fx, fy, size, s, rgb(55, 55, 55))
    c.rect(fx, fy, s, size, rgb(55, 55, 55))
    c.rect(fx, fy + size - s, size, s, rgb(255, 255, 255))
    c.rect(fx + size - s, fy, s, size, rgb(255, 255, 255))
}

fn draw_stack(c: Canvas, x: int, y: int, s: int, item: int, amount: int) {
    if item <= 0 { return }
    draw_block_icon(c, x, y, 16 * s, item)
    if amount > 1 {
        let label = "{amount}"
        let fs = 3 * s + 3
        let lx = x + 17 * s - c.text_width(label, fs, true)
        let ly = y + 16 * s - fs - s / 2
        c.text(lx + s / 2 + 1, ly + s / 2 + 1, label, rgb(63, 63, 63), fs, true)
        c.text(lx, ly, label, rgb(255, 255, 255), fs, true)
    }
}

fn draw_player_preview(c: Canvas, px: int, py: int, s: int) {
    let bx = px + 26 * s
    let by = py + 8 * s
    c.rect(bx, by, 49 * s, 70 * s, rgb(16, 16, 16))
    c.rect(bx + s, by + s, 47 * s, 68 * s, rgb(52, 52, 52))
    let ox = px + 50 * s - 8 * s
    let oy = py + 14 * s
    c.rect(ox, oy, 16 * s, 16 * s, rgb(196, 148, 108))
    c.rect(ox, oy, 16 * s, 5 * s, rgb(74, 52, 30))
    c.rect(ox + 3 * s, oy + 8 * s, 3 * s, 2 * s, rgb(255, 255, 255))
    c.rect(ox + 10 * s, oy + 8 * s, 3 * s, 2 * s, rgb(255, 255, 255))
    c.rect(ox + 4 * s, oy + 8 * s, 2 * s, 2 * s, rgb(70, 60, 140))
    c.rect(ox + 10 * s, oy + 8 * s, 2 * s, 2 * s, rgb(70, 60, 140))
    c.rect(ox, oy + 16 * s, 16 * s, 24 * s, rgb(0, 170, 170))
    c.rect(ox - 8 * s, oy + 16 * s, 8 * s, 24 * s, rgb(196, 148, 108))
    c.rect(ox + 16 * s, oy + 16 * s, 8 * s, 24 * s, rgb(196, 148, 108))
    c.rect(ox, oy + 40 * s, 8 * s, 24 * s, rgb(60, 60, 170))
    c.rect(ox + 8 * s, oy + 40 * s, 8 * s, 24 * s, rgb(52, 52, 140))
}

fn draw_inventory_overlay(c: Canvas) {
    c.rect(0, 0, c.w, c.h, rgba(0, 0, 0, 0.55))
    let s = max(1, min(c.w / 190, (c.h - 70) / 172))
    let px = (c.w - 176 * s) / 2
    let py = (c.h - 166 * s) / 2 - s * 2
    inv_px = px
    inv_py = py
    inv_s = s
    let big = inv_big
    let label = rgb(64, 64, 64)
    let fs = 4 * s

    c.rect(px, py, 176 * s, 166 * s, rgb(198, 198, 198))
    c.rect(px, py, 176 * s, s, rgb(255, 255, 255))
    c.rect(px, py, s, 166 * s, rgb(255, 255, 255))
    c.rect(px, py + 165 * s, 176 * s, s, rgb(85, 85, 85))
    c.rect(px + 175 * s, py, s, 166 * s, rgb(85, 85, 85))
    c.outline(px - s, py - s, 178 * s, 168 * s, 0, s, rgb(0, 0, 0))

    if big {
        c.text(px + 30 * s, py + 6 * s, "Crafting", label, fs, false)
    } else {
        c.text(px + 98 * s, py + 7 * s, "Crafting", label, fs, false)
        for i in 0..4 { mc_slot(c, px + 8 * s, py + (8 + 18 * i) * s, s) }
        mc_slot(c, px + 77 * s, py + 62 * s, s)
        draw_player_preview(c, px, py, s)
    }
    c.text(px + 8 * s, py + 72 * s, "Inventory", label, fs, false)

    for t in 0..36 {
        let (ux, uy) = inv_target_pos(t, big)
        let sx = px + ux * s
        let sy = py + uy * s
        mc_slot(c, sx, sy, s)
        draw_stack(c, sx, sy, s, slot_items[t], slot_count(t))
        if t == inv_held { c.rect(sx, sy, 16 * s, 16 * s, rgba(255, 255, 255, 0.5)) }
    }
    for g in 0..9 {
        if grid_cell_active(g) {
            let (ux, uy) = inv_target_pos(100 + g, big)
            mc_slot(c, px + ux * s, py + uy * s, s)
            draw_stack(c, px + ux * s, py + uy * s, s, inv_grid[g], 1)
        }
    }

    let (rx, ry) = inv_target_pos(200, big)
    let (result_item, result_count) = inv_result()
    let ax = if big { 92 } else { 134 }
    let ay = if big { 43 } else { 36 }
    c.line(px + ax * s, py + ay * s, px + (ax + 20) * s, py + ay * s, 2 * s, rgb(110, 110, 110))
    c.line(px + (ax + 14) * s, py + (ay - 6) * s, px + (ax + 22) * s, py + ay * s, 2 * s, rgb(110, 110, 110))
    c.line(px + (ax + 14) * s, py + (ay + 6) * s, px + (ax + 22) * s, py + ay * s, 2 * s, rgb(110, 110, 110))
    mc_slot(c, px + rx * s, py + ry * s, s)
    draw_stack(c, px + rx * s, py + ry * s, s, result_item, result_count)

    var caption = "Click an item, then click where it should go"
    if inv_held >= 0 and slot_items[inv_held] > 0 {
        caption = block_name(slot_items[inv_held])
    } else if result_item > 0 {
        caption = "Click the result to craft {block_name(result_item)}"
    } else if not big {
        caption = "2x2 crafting. Stand next to a workbench for the 3x3 grid"
    }
    c.text(px, py + 169 * s, caption, rgb(255, 255, 255), 3 * s + 4, true)
}

fn draw_pause_menu(c: Canvas) {
    c.rect(0, 0, c.w, c.h, rgba(0, 0, 0, 0.60))
    let panel_x = c.w / 2 - 190
    let panel_y = c.h / 2 - 145
    c.rect(panel_x, panel_y, 380, 290, rgb(198, 198, 198))
    c.outline(panel_x, panel_y, 380, 290, 0, 3, rgb(32, 32, 32))
    c.line(panel_x + 3, panel_y + 3, panel_x + 376, panel_y + 3, 2, rgb(245, 245, 245))
    c.text(panel_x + 105, panel_y + 22, "Game Menu", rgb(45, 45, 45), 25, true)
    c.rect(panel_x + 38, panel_y + 74, 304, 42, rgb(115, 115, 115))
    c.rect(panel_x + 40, panel_y + 76, 300, 38, rgb(95, 151, 191))
    c.outline(panel_x + 38, panel_y + 74, 304, 42, 0, 2, rgb(245, 245, 245))
    c.text(panel_x + 92, panel_y + 86, "Back to Game", rgb(255, 255, 255), 17, true)
    c.rect(panel_x + 38, panel_y + 128, 304, 37, rgb(130, 130, 130))
    c.outline(panel_x + 38, panel_y + 128, 304, 37, 0, 2, rgb(225, 225, 225))
    c.text(panel_x + 76, panel_y + 138, "Save World (F6)", rgb(255, 255, 255), 15, true)
    c.rect(panel_x + 38, panel_y + 172, 304, 37, rgb(130, 130, 130))
    c.outline(panel_x + 38, panel_y + 172, 304, 37, 0, 2, rgb(225, 225, 225))
    c.text(panel_x + 76, panel_y + 182, "Load World (F7)", rgb(255, 255, 255), 15, true)
    c.text(panel_x + 56, panel_y + 232, "Esc or click: Back to Game", rgb(55, 55, 55), 13, false)
    c.text(panel_x + 74, panel_y + 255, "Infinite biomes and structures", rgb(65, 65, 65), 12, false)
}

fn draw_hud(c: Canvas) {
    if show_pause {
        draw_pause_menu(c)
        return
    }
    if show_crafting {
        draw_inventory_overlay(c)
        return
    }

    let center_x = c.w / 2
    let center_y = c.h / 2
    let bar_y = c.h - 56
    let slot_size = 44
    let gap = 2
    let total_width = 9 * slot_size + 8 * gap
    let start_x = (c.w - total_width) / 2

    // Classic Minecraft-style hotbar: square bevelled slots and a bright selected slot.
    c.rect(start_x - 5, bar_y - 5, total_width + 10, slot_size + 10, rgb(24, 24, 24))
    c.rect(start_x - 3, bar_y - 3, total_width + 6, slot_size + 6, rgb(115, 115, 115))
    for i in 0..9 {
        let slot_block = hotbar_block(i)
        let x = start_x + i * (slot_size + gap)
        draw_slot(c, x, bar_y, slot_size, i == selected_slot)
        if slot_block > 0 {
            draw_block_icon(c, x + 7, bar_y + 7, slot_size - 14, slot_block)
            let amount = slot_count(i)
            if amount > 1 {
                let label = "{amount}"
                let lx = x + slot_size - 4 - c.text_width(label, 13, true)
                c.text(lx + 1, bar_y + 29, label, rgb(63, 63, 63), 13, true)
                c.text(lx, bar_y + 28, label, rgb(255, 255, 255), 13, true)
            }
        }
    }
    if item_name_timer > 0.0 and selected_block > 0 {
        let name = block_name(selected_block)
        c.text((c.w - c.text_width(name, 15, true)) / 2, c.h - 124, name, rgb(255, 255, 255), 15, true)
    }

    // Ten pixel-art hearts and drumsticks, positioned above the hotbar.
    let stats_y = c.h - 101
    for i in 0..10 {
        let hp = if health >= float((i + 1) * 2) { 2 } else if health > float(i * 2) { 1 } else { 0 }
        draw_heart(c, center_x - 206 + i * 18, stats_y, hp)
        let food = if hunger >= float((i + 1) * 2) { 2 } else if hunger > float(i * 2) { 1 } else { 0 }
        draw_food(c, center_x + 28 + i * 18, stats_y, food)
    }

    if equipped_tool_mode == 0 and equipped_pickaxe > 0 {
        let wear_index = equipped_pickaxe - 46
        let durability_value = tool_durability[wear_index]
        c.rect(center_x - 125, bar_y - 25, 250, 18, rgba(0, 0, 0, 0.52))
        c.text(center_x - 118, bar_y - 22, "Tool: {block_name(equipped_pickaxe)}  Durability: {durability_value}", rgb(245, 245, 245), 11, true)
    } else if equipped_tool_mode == 1 {
        c.rect(center_x - 95, bar_y - 25, 190, 18, rgba(0, 0, 0, 0.52))
        c.text(center_x - 88, bar_y - 22, "Wooden axe  Durability: {tool_durability[4]}", rgb(245, 245, 245), 11, true)
    } else if equipped_tool_mode == 2 {
        c.rect(center_x - 100, bar_y - 25, 200, 18, rgba(0, 0, 0, 0.52))
        c.text(center_x - 93, bar_y - 22, "Wooden shovel  Durability: {tool_durability[5]}", rgb(245, 245, 245), 11, true)
    }

    // Compact crosshair with a dark outline, closer to the vanilla HUD.
    c.line(center_x - 7, center_y, center_x + 7, center_y, 3, rgb(20, 20, 20))
    c.line(center_x, center_y - 7, center_x, center_y + 7, 3, rgb(20, 20, 20))
    c.line(center_x - 6, center_y, center_x + 6, center_y, 1, rgb(245, 245, 245))
    c.line(center_x, center_y - 6, center_x, center_y + 6, 1, rgb(245, 245, 245))

    if show_debug {
        c.rect(8, 8, 315, 98, rgba(0, 0, 0, 0.72))
        c.text(16, 15, "BLOCKWORLD DELUXE | Infinite world", rgb(255, 255, 255), 13, true)
        c.text(16, 34, "XYZ {world_origin_x + int(floor(player_x))}, {int(floor(player_y))}, {world_origin_z + int(floor(player_z))}", rgb(255, 255, 255), 12, false)
        c.text(16, 52, "FPS {int(fps_value)}  LIGHT {int(day_light * 100.0)}%", rgb(255, 255, 255), 12, false)
        c.text(16, 70, "MINED {blocks_mined}  PLACED {blocks_placed}  CRAFTED {blocks_crafted}  PICK {pickaxe_level()}", rgb(255, 255, 255), 12, false)
        c.text(16, 88, "DROPS {dropped_item_ids.len()}  DIAMONDS {inventory[19]}  BIOME {biome_name(biome_at(world_origin_x + int(player_x), world_origin_z + int(player_z)))}", rgb(255, 255, 255), 12, false)
    }

    if show_map {
        let map_size = WORLD_W
        let map_x = c.w - map_size - 18
        let map_y = 24
        let cell = 1
        c.rect(map_x - 6, map_y - 6, map_size + 12, map_size + 12, rgb(32, 32, 32))
        c.rect(map_x - 3, map_y - 3, map_size + 6, map_size + 6, rgb(190, 190, 190))
        for mx in 0..WORLD_W {
            for mz in 0..WORLD_D {
                let surface = surface_block(mx, mz)
                c.rect(map_x + mx * cell, map_y + mz * cell, cell, cell, map_color(surface))
            }
        }
        let player_map_x = map_x + int(player_x * float(cell))
        let player_map_y = map_y + int(player_z * float(cell))
        c.rect(player_map_x - 2, player_map_y - 2, 5, 5, rgb(255, 65, 65))
        c.line(player_map_x, player_map_y, player_map_x + int(sin_atf(yaw) * 12.0), player_map_y + int(cos_atf(yaw) * 12.0), 2, rgb(255, 255, 255))
    }

    if status_timer > 0.0 {
        let message_width = min(c.text_width(status_message, 14, true) + 26, c.w - 40)
        let message_x = (c.w - message_width) / 2
        c.rect(message_x, 16, message_width, 30, rgba(0, 0, 0, 0.66))
        c.outline(message_x, 16, message_width, 30, 0, 1, rgb(35, 35, 35))
        c.text(message_x + 13, 23, status_message, rgb(255, 255, 255), 14, true)
    }

    if not mouse_captured {
        c.rect(center_x - 150, center_y + 27, 300, 40, rgba(0, 0, 0, 0.82))
        c.outline(center_x - 150, center_y + 27, 300, 40, 0, 2, rgb(210, 210, 210))
        c.text(center_x - 112, center_y + 39, "CLICK TO RETURN TO GAME", rgb(255, 255, 255), 15, true)
    }
}

fn draw_dropped_items(c: Canvas) {
    for i in 0..dropped_item_ids.len() {
        let dx = dropped_item_xs[i] - camera_x
        let dy = dropped_item_ys[i] - camera_y
        let dz = dropped_item_zs[i] - camera_z
        let depth = dx * forward_x + dy * forward_y + dz * forward_z
        let distance = sqrt(dx * dx + dy * dy + dz * dz)
        if depth > 0.2 and depth < VIEW_DISTANCE and distance > 0.01 {
            let (block, _, _, _, _, _, _, hit_distance) = trace_ray(dx, dy, dz, distance)
            if block == 0 or hit_distance >= distance - 0.32 {
                let side = dx * right_x + dy * right_y + dz * right_z
                let up = dx * up_x + dy * up_y + dz * up_z
                let screen_x = int((side / depth / 1.09 + 1.0) * 0.5 * float(c.w))
                let screen_y = int((1.0 - (up / depth / 0.68 + 1.0) * 0.5) * float(c.h))
                if screen_x >= 0 and screen_x < c.w and screen_y >= 0 and screen_y < c.h {
                    let icon_size = clamp(int(95.0 / depth), 14, 22)
                    draw_block_icon(c, screen_x - icon_size / 2, screen_y - icon_size / 2, icon_size, dropped_item_ids[i])
                }
            }
        }
    }
}

fn draw_mobs(c: Canvas) {
    for i in 0..mob_xs.len() {
        let dx = mob_xs[i] - camera_x
        let dy = (mob_ys[i] + 0.9) - camera_y
        let dz = mob_zs[i] - camera_z
        let depth = dx * forward_x + dy * forward_y + dz * forward_z
        let distance = sqrt(dx * dx + dy * dy + dz * dz)
        if depth > 0.3 and depth < VIEW_DISTANCE and distance > 0.01 {
            let (block, _, _, _, _, _, _, hit_distance) = trace_ray(dx, dy, dz, distance)
            if block == 0 or hit_distance >= distance - 0.6 {
                let side = dx * right_x + dy * right_y + dz * right_z
                let up = dy * up_y + dx * up_x + dz * up_z
                let cx = (side / depth / 1.09 + 1.0) * 0.5 * float(c.w)
                let cy = (1.0 - (up / depth / 0.68 + 1.0) * 0.5) * float(c.h)
                // Unit height in pixels at this depth.
                let unit = 0.5 * float(c.h) / depth / 0.68
                let h = int(unit * 1.8)
                let w = int(unit * 0.6)
                let x0 = int(cx) - w / 2
                let y0 = int(cy) - h / 2
                let shade = clamp(1.0 - distance * 0.015, 0.5, 1.0) * (0.45 + day_light * 0.55)
                let head = h / 4
                c.rect(x0, y0, w, head, rgb(int(96.0 * shade), int(160.0 * shade), int(84.0 * shade)))
                c.rect(x0, y0 + head, w, h * 3 / 8, rgb(int(46.0 * shade), int(120.0 * shade), int(150.0 * shade)))
                c.rect(x0, y0 + head + h * 3 / 8, w, h - head - h * 3 / 8, rgb(int(60.0 * shade), int(55.0 * shade), int(140.0 * shade)))
                let eye = max(1, w / 6)
                c.rect(x0 + w / 5, y0 + head / 3, eye, eye, rgb(20, 20, 20))
                c.rect(x0 + w - w / 5 - eye, y0 + head / 3, eye, eye, rgb(20, 20, 20))
            }
        }
    }
}

fn cloud_amount(ndx: float, ndy: float, ndz: float) -> float {
    // Flat cloud layer above the world; slides with game time. 0.0 means clear sky.
    if ndy < 0.03 { return 0.0 }
    let t = (42.0 - camera_y) / ndy
    if t > 260.0 { return 0.0 }
    let cx = int(floor((camera_x + ndx * t + game_time * 1.2) / 7.0))
    let cz = int(floor((camera_z + ndz * t) / 7.0))
    let h = abs(cx * 73 + cz * 151 + cx * cz * 29) % 100
    if h >= 34 { return 0.0 }
    return clamp(1.0 - t / 260.0, 0.0, 1.0) * 0.8
}

fn draw_game(c: Canvas) {
    let aspect_x = 1.09
    let aspect_y = 0.68

    if column_screen_x.len() != render_w {
        column_screen_x = array_make::<float>(render_w)
        for x in 0..render_w {
            column_screen_x[x] = ((float(x) + 0.5) * 2.0 / float(render_w) - 1.0) * aspect_x
        }
    }

    for y in 0..render_h {
        let screen_y = (1.0 - (float(y) + 0.5) * 2.0 / float(render_h)) * aspect_y
        // Per-row part of the ray direction; only the right vector changes along the row.
        let row_x = forward_x + up_x * screen_y
        let row_y = forward_y + up_y * screen_y
        let row_z = forward_z + up_z * screen_y
        let row_base = y * render_w
        for x in 0..render_w {
            let screen_x = column_screen_x[x]
            let dx = row_x + right_x * screen_x
            let dy = row_y + right_y * screen_x
            let dz = row_z + right_z * screen_x
            let ray_length = sqrt(dx * dx + dy * dy + dz * dz)
            let ndx = dx / ray_length
            let ndy = dy / ray_length
            let ndz = dz / ray_length
            let (block, bx, by, bz, px, py, pz, distance) = trace_ray(ndx, ndy, ndz, VIEW_DISTANCE)
            var color = 0
            if block != 0 {
                let face = face_from_hit(bx, by, bz, px, py, pz, ndx, ndy, ndz)
                let hit_x = camera_x + ndx * distance
                let hit_y = camera_y + ndy * distance
                let hit_z = camera_z + ndz * distance
                color = color_for_block(block, face, bx, by, bz, hit_y, distance, hit_x, hit_y, hit_z)
            } else {
                color = sky_color(ndy)
                let cloud = cloud_amount(ndx, ndy, ndz)
                if cloud > 0.0 {
                    let tone = int(150.0 + 105.0 * day_light)
                    color = mix(color, rgb(tone, tone, min(255, tone + 6)), cloud)
                }
                let sun_dot = ndx * -0.30 + ndy * 0.48 + ndz * 0.82
                if sun_dot > 0.994 and day_light > 0.42 {
                    color = pack_rgb(255, 244, 205)
                } else if day_light < 0.34 and ndy > 0.08 {
                    let star_a = int(abs(ndx * 1283.0 + ndy * 817.0 + ndz * 523.0) * 1000.0)
                    let star_b = int(abs(ndx * 331.0 - ndy * 1291.0 + ndz * 719.0) * 1000.0)
                    if star_a % 173 == 7 or star_b % 211 == 13 {
                        color = rgb(224, 235, 255)
                    }
                }
            }
            if camera_underwater { color = mix(color, rgb(40, 116, 190), 0.34) }
            frame_pixels[row_base + x] = color
        }
    }

    c.pixels_smooth(0, 0, c.w, c.h, frame_pixels, render_w, render_h)
    draw_dropped_items(c)
    draw_mobs(c)
    draw_hud(c)
}

fn view() -> Node {
    if not timer_started {
        timer_started = true
        mouse_captured = true
        ui_mouse_capture(true)
        ui_every(FRAME_TIME_MS, game_tick)
    }
    return canvas(|c| { draw_game(c) }).grow().on_pointer(|x, y| {
        inv_click_x = x
        inv_click_y = y
        inv_click_pending = true
    })
}

fn main() {
    create_world()
    ui_run("BLOCKWORLD DELUXE — Infinite Survival World", 1200, 750, view)
}
