// the character of a named icon ("" when the name is unknown)
fn mdi(name: str) -> str {
    zi_init()
    let cp = zi_map.get(name, 0)
    if cp == 0 { return "" }
    return ui_utf8(cp)
}

// the icon name for a data emoji (accessories, tasks, abilities...), "" when there is none
fn glyph_name(emoji: str) -> str {
    zi_init()
    return zi_glyphs.get(emoji.replace("\u{FE0F}", ""), "")
}
