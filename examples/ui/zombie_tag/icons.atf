// icons.atf - Material Design Icons (the icon font of the original game), generated from its glyph map.
// mdi("cog") is the text to draw with the family "Material Design Icons".

import "std/ui"

var zi_map: {str: int} = {}
var zi_glyphs: {str: str} = {}

