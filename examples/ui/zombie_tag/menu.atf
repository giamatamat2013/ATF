// menu.atf - the menu screens, drawn on one canvas like the original AppShell and HomeScreen:
// the sidebar on the left (logo, player, tabs, settings) and the Home page beside it.

import "std/ui"
import "engine"
import "theme"
import "icons"
import "app"
import "profile"
import "gameview"

// ---------------------------------------------------------------- text helpers

// the letters of s (a letter may take several UTF-8 bytes, like "·")
fn zt_chars(s: str) -> [str] {
    var out: [str] = []
    var i = 0
    while i < s.len() {
        let b = int(s.byte_at(i))
        let n = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 }
        out.push(s[i..min(i + n, s.len())])
        i += n
    }
    return out
}

// the width of text drawn with ls extra pixels after every letter (CSS letter-spacing)
fn zt_tw_ls(c: Canvas, s: str, size: int, weight: int, ls: float) -> float {
    return float(zt_tw(c, s, size, weight)) + ls * float(zt_chars(s).len())
}

// text with letter spacing: every letter keeps the place it has in the whole line, plus the spacing
fn zt_text_ls(c: Canvas, x: float, y: float, s: str, col: int, size: int, weight: int, ls: float) {
    if ls == 0.0 {
        zt_text(c, x, y, s, col, size, weight)
        return
    }
    var pre = ""
    var i = 0
    for ch in zt_chars(s) {
        zt_text(c, x + float(zt_tw(c, pre, size, weight)) + ls * float(i), y, ch, col, size, weight)
        pre = pre + ch
        i += 1
    }
}

// Letter-spaced text turned by angle degrees around (cx, cy), the middle of the line.
fn zt_text_ls_rot(c: Canvas, cx: float, cy: float, s: str, col: int, size: int, weight: int, ls: float, angle: float) {
    let total = zt_tw_ls(c, s, size, weight, ls)
    let co = cos(angle * PI / 180.0)
    let si = sin(angle * PI / 180.0)
    var pre = ""
    var i = 0
    for ch in zt_chars(s) {
        // where the middle of this letter is along the line, from the middle of the line
        let along = float(zt_tw(c, pre, size, weight)) + ls * float(i) + float(zt_tw(c, ch, size, weight)) / 2.0 - total / 2.0
        c.text_rotated(cx + along * co, cy + along * si, ch, col, size, angle, family: zt_family(weight), weight: zt_weight(weight))
        pre = pre + ch
        i += 1
    }
}

// Split text into lines no wider than w. A word that is too long is broken between letters
// (CSS word-break: break-word), like "Tournaments" in a narrow box.
fn zt_wrap(c: Canvas, s: str, size: int, weight: int, w: float) -> [str] {
    var lines: [str] = []
    var cur = ""
    for word in s.split(" ") {
        let tryit = if cur == "" { word } else { cur + " " + word }
        if float(zt_tw(c, tryit, size, weight)) <= w {
            cur = tryit
            continue
        }
        if cur != "" { lines.push(cur) }
        cur = ""
        // the word alone does not fit: put as many letters on a line as fit
        for ch in zt_chars(word) {
            if cur != "" and float(zt_tw(c, cur + ch, size, weight)) > w {
                lines.push(cur)
                cur = ""
            }
            cur = cur + ch
        }
    }
    if cur != "" { lines.push(cur) }
    return lines
}

// cut text to width w, ending in "…" when it is too long (numberOfLines={1})
fn zt_ellipsis_f(c: Canvas, s: str, size: int, weight: int, w: float) -> str {
    if float(zt_tw(c, s, size, weight)) <= w { return s }
    let ch = zt_chars(s)
    var n = ch.len()
    while n > 0 {
        let t = "".join(ch[0..n]) + "…"
        if float(zt_tw(c, t, size, weight)) <= w { return t }
        n -= 1
    }
    return "…"
}

// ---------------------------------------------------------------- shapes

// a rounded rectangle with float corners and radius
fn zt_rr(c: Canvas, x: float, y: float, w: float, h: float, r: float, col: int) {
    c.rrect_rotated(x + w / 2.0, y + h / 2.0, w, h, r, 0.0, col)
}

// A card with the "ink" border of the original: 2 pixels of white at 12% over the fill on three sides
// and a thicker bottom edge.
fn zt_card(c: Canvas, x: float, y: float, w: float, h: float, r: float, bottom: float, fill: int) {
    zt_rr(c, x, y, w, h, r, zt_mix(fill, WHITE, 0.12))
    zt_rr(c, x + 2.0, y + 2.0, w - 4.0, h - 2.0 - bottom, max(0.0, r - 2.0), fill)
}

// a rounded rectangle with a bw border of colour edge around the fill
fn zt_bordered(c: Canvas, x: float, y: float, w: float, h: float, r: float, bw: float, fill: int, edge: int) {
    zt_rr(c, x, y, w, h, r, edge)
    zt_rr(c, x + bw, y + bw, w - bw * 2.0, h - bw * 2.0, max(0.0, r - bw), fill)
}

// A dashed border (CSS border-style: dashed): dashes of on pixels with gaps of off pixels, walking
// clockwise round the rectangle from the start of the top edge.
fn zt_dashed(c: Canvas, x: float, y: float, w: float, h: float, r: float, bw: float, on: float, off: float, col: int) {
    // the middle line of the border, and the lengths of its pieces
    let hb = bw / 2.0
    let x0 = x + hb
    let y0 = y + hb
    let x1 = x + w - hb
    let y1 = y + h - hb
    let rr = max(0.0, r - hb)
    let top = x1 - x0 - rr * 2.0
    let side = y1 - y0 - rr * 2.0
    let q = PI * rr / 2.0
    for yy in floor_int(y)..ceil_int(y + h) {
        for xx in floor_int(x)..ceil_int(x + w) {
            let px = float(xx) + 0.5
            let py = float(yy) + 0.5
            // only the pixels of the border
            let d = ui_rr_dist(px, py, x, y, w, h, r, r, r, r)
            let cov = clamp(0.5 - d, 0.0, 1.0) - clamp(0.5 - d - bw, 0.0, 1.0)
            if cov <= 0.0 { continue }
            var pos = 0.0
            if px < x0 + rr and py < y0 + rr {
                pos = top * 2.0 + side * 2.0 + q * 3.0 + rr * atan2(y0 + rr - py, x0 + rr - px)
            } else if px > x1 - rr and py < y0 + rr {
                pos = top + rr * atan2(px - (x1 - rr), y0 + rr - py)
            } else if px > x1 - rr and py > y1 - rr {
                pos = top + q + side + rr * atan2(py - (y1 - rr), px - (x1 - rr))
            } else if px < x0 + rr and py > y1 - rr {
                pos = top * 2.0 + q * 2.0 + side + rr * atan2(x0 + rr - px, py - (y1 - rr))
            } else if px >= x0 + rr and px <= x1 - rr {
                pos = if py < (y0 + y1) / 2.0 { px - (x0 + rr) } else { top + q * 2.0 + side + (x1 - rr - px) }
            } else if px > (x0 + x1) / 2.0 {
                pos = top + q + (py - (y0 + rr))
            } else {
                pos = top * 2.0 + q * 3.0 + side + (y1 - rr - py)
            }
            let m = pos - floor(pos / (on + off)) * (on + off)
            if m < on { c.rect(xx, yy, 1, 1, zt_fade(col, cov)) }
        }
    }
}

// Yellow and black hazard tape across (x0..x1, y0..y0+h), cut to a rounded top with corner radius r.
fn zt_hazard(c: Canvas, x0: float, x1: float, y0: float, h: float, r: float, gold: int) {
    let stripe = h * 1.4
    for yy in floor_int(y0)..ceil_int(y0 + h) {
        let py = float(yy) + 0.5
        // how far the rounded corners cut into this row
        let dy = y0 + r - py
        let cut = if dy > 0.0 { r - sqrt(max(0.0, r * r - dy * dy)) } else { 0.0 }
        let left = x0 + cut
        let right = x1 - cut
        zt_span(c, left, right, yy, zc_ink())
        // the stripes lean right: CSS skewX(-45deg) around the middle of each stripe
        let shift = py - (y0 + h / 2.0)
        var k = 0
        loop {
            let a = x0 + stripe * 2.0 * float(k) - shift
            if a > right { break }
            zt_span(c, max(a, left), min(a + stripe, right), yy, gold)
            k += 1
        }
    }
}

// ---------------------------------------------------------------- the bob animation

// 0 -> 1 -> 0 every 2.2 seconds with a sine ease (Animated.timing with Easing.inOut(Easing.sin))
fn zt_bob(a: App) -> float {
    if (getenv("ATF_UI_SCREENSHOT") ?? "") != "" { return 0.0 }
    let ms = (clock() - a.start_t) * 1000.0
    let p = (ms - floor(ms / 2200.0) * 2200.0) / 1100.0
    let t = if p <= 1.0 { p } else { 2.0 - p }
    return -(cos(PI * t) - 1.0) / 2.0
}

// ---------------------------------------------------------------- the sidebar (AppShell)

const ZT_SIDE_W = 248.0

fn zt_over(a: App, x: float, y: float, w: float, h: float) -> bool {
    let mx = float(a.mx)
    let my = float(a.my)
    return mx >= x and my >= y and mx < x + w and my < y + h
}

fn zt_side_item(c: Canvas, a: App, y: float, key: str, label: str, icon: str) {
    let on = a.tab == key
    if on { zt_rr(c, 18.0, y, 210.0, 48.0, 20.0, zc_toxic()) }
    let col = if on { zc_ink() } else { zc_text_dim() }
    zt_icon(c, 32.0, y + 13.0, icon, 22, col)
    zt_text(c, 66.0, y + (48.0 - zt_lh(15)) / 2.0, label, col, 15, 800)
    zt_hit(a, 18.0, y, 210.0, 48.0, "nav:" + key)
}

fn zt_draw_sidebar(c: Canvas, a: App) {
    let p = a.prof
    c.rect(0, 0, 246, VIEW_H, zc_bg_alt())
    c.rect(246, 0, 2, VIEW_H, zc_border())
    c.text(18, 18, "ZOMBIE TAG", zc_toxic(), 28, family: "Lilita One")
    // the player
    zt_rr(c, 18.0, 68.0, 210.0, 58.0, 20.0, zc_panel())
    zt_disc(c, 47.0, 97.0, 19.0, zc_blood())
    let lv = zt_level_info(p.xp)
    zt_text_c(c, 28.0, 97.0 - zt_lh(15) / 2.0, 38.0, "{lv.level}", WHITE, 15, 900)
    zt_text(c, 76.0, 81.0, zt_ellipsis_f(c, p.name, 15, 800, 142.0), WHITE, 15, 800)
    zt_text(c, 76.0, 81.0 + zt_lh(15), "{p.coins} coins · {p.medals} medals", zc_text_dim(), 12, 400)
    zt_hit(a, 18.0, 68.0, 210.0, 58.0, "nav:profile")
    let items = [("home", "Home", "home-variant-outline"), ("shop", "Shop", "shopping-outline"),
        ("missions", "Missions", "clipboard-check-outline"), ("skins", "Skins", "tshirt-crew-outline"),
        ("profile", "Profile", "account-outline")]
    for i, (key, label, icon) in items {
        zt_side_item(c, a, 144.0 + float(i) * 54.0, key, label, icon)
    }
    zt_side_item(c, a, float(VIEW_H) - 66.0, "settings", "Settings", "cog-outline")
}

// ---------------------------------------------------------------- Home

fn zt_skin_of(id: str) -> Skin {
    for s in SKINS {
        if s.id == id { return s }
    }
    return SKINS[0]
}

// a pill with a coin or medal in front of the number
fn zt_stat_pill(c: Canvas, x: float, y: float, w: float, text: str, col: int, coin: bool) {
    zt_bordered(c, x, y, w, 26.6, 10.0, 2.0, zc_bg_alt(), zt_mix(zc_bg_alt(), WHITE, 0.12))
    let cy = y + 13.3
    if coin {
        zt_disc(c, x + 18.0, cy, 7.0, hex("#b8860b"))
        zt_disc(c, x + 18.0, cy, 5.0, zc_gold())
        zt_text(c, x + 31.0, cy - zt_lh(14) / 2.0, text, col, 14, 700)
    } else {
        zt_icon(c, x + 11.0, cy - 7.5, "medal-outline", 15, col)
        zt_text(c, x + 32.0, cy - zt_lh(14) / 2.0, text, col, 14, 700)
    }
}

fn zt_draw_player_card(c: Canvas, a: App, x: float, y: float, w: float) {
    let p = a.prof
    let lv = zt_level_info(p.xp)
    let h = 91.0
    zt_card(c, x, y, w, h, 26.0, 5.0, zc_panel())
    zt_hit(a, x, y, w, h, "nav:profile")
    let mid = y + 2.0 + (h - 7.0) / 2.0
    // the avatar with the character bobbing up and down
    let ax = x + 14.0
    let ay = mid - 28.0
    zt_bordered(c, ax, ay, 56.0, 56.0, 14.0, 2.0, zc_panel_light(), zt_mix(zc_panel_light(), WHITE, 0.12))
    // a 40-pixel character, centred in the box above its thicker bottom edge
    draw_character(c, ax + 8.0, ay + 7.0 - 3.0 * zt_bob(a), 40.0, zt_skin_of(p.skin), false, 0.0, 1.0, look: 0.0)
    let lt = "{lv.level}"
    let bw = max(26.0, float(zt_tw(c, lt, 13, 900)) + 12.0)
    zt_bordered(c, ax - 6.0, ay + 36.0, bw, 26.0, 8.0, 2.0, zc_toxic(), zt_mix(zc_toxic(), WHITE, 0.12))
    zt_text_c(c, ax - 6.0, ay + 49.0 - zt_lh(13) / 2.0, bw, lt, zc_ink(), 13, 900)
    // coins and medals on the right, both pills as wide as the wider one
    let coins = "{p.coins}"
    let medals = "{p.medals}"
    let pw = max(42.0 + float(zt_tw(c, coins, 14, 700)), 43.0 + float(zt_tw(c, medals, 14, 700)))
    let px = x + w - 14.0 - pw
    zt_stat_pill(c, px, mid - 29.6, pw, coins, zc_gold(), true)
    zt_stat_pill(c, px, mid + 3.0, pw, medals, hex("#ff8a2b"), false)
    // name, level bar and XP
    let tx = ax + 68.0
    let top = mid - 27.6
    zt_text(c, tx, top, zt_ellipsis_f(c, p.name, 16, 700, px - 12.0 - tx), WHITE, 16, 700)
    let bar_w = px - 12.0 - tx
    zt_rr(c, tx, top + 25.0, bar_w, 10.0, 5.0, zt_mix(zc_panel(), BLACK, 0.35))
    if lv.progress > 0.0 { zt_rr(c, tx, top + 25.0, bar_w * min(1.0, lv.progress), 10.0, 5.0, zc_toxic()) }
    zt_text(c, tx, top + 41.0, "{lv.into} / {lv.needed} XP", zc_text_dim(), 12, 400)
}

// the cartoon zombie of the Home card, its box (120 x 130) at (x, y)
fn zt_zombie_art(c: Canvas, x: float, y: float) {
    let ink = zc_ink()
    for (ax, ay, ang) in [(0.0, 58.0, -10.0), (6.0, 86.0, 7.0)] {
        c.rrect_rotated(x + ax + 27.0, y + ay + 10.0, 54.0, 20.0, 10.0, ang, ink)
        c.rrect_rotated(x + ax + 27.0, y + ay + 10.0, 49.0, 15.0, 7.5, ang, zc_toxic_dark())
    }
    // the head: a half circle on top, rounder corners at the bottom
    zt_head(c, x + 20.0, y + 10.0, 100.0, 116.0, 50.0, 42.0, ink)
    zt_head(c, x + 23.0, y + 13.0, 94.0, 110.0, 47.0, 39.0, zc_toxic())
    c.rrect_rotated(x + 71.0, y + 29.5, 30.0, 3.0, 0.0, -14.0, ink)
    for (ex, ey, r, pr) in [(56.0, 54.0, 14.0, 5.0), (90.5, 57.5, 9.5, 3.0)] {
        zt_disc(c, x + ex, y + ey, r, ink)
        zt_disc(c, x + ex, y + ey, r - 2.5, WHITE)
        zt_disc(c, x + ex, y + ey, pr, ink)
    }
    zt_rr(c, x + 46.0, y + 88.0, 50.0, 15.0, 7.5, ink)
    for tx in [53.25, 67.5, 81.75] {
        c.frect(x + tx, y + 88.0, 7.0, 6.0, WHITE)
    }
}

// a box with round top corners of radius rt (half the width) and bottom corners of radius rb
fn zt_head(c: Canvas, x: float, y: float, w: float, h: float, rt: float, rb: float, col: int) {
    zt_disc_rect(c, x + w / 2.0, y + rt, rt, x, y, x + w, y + rt, col)
    c.frect(x, y + rt, w, h - rt - rb, col)
    zt_disc_rect(c, x + rb, y + h - rb, rb, x, y + h - rb, x + rb, y + h, col)
    zt_disc_rect(c, x + w - rb, y + h - rb, rb, x + w - rb, y + h - rb, x + w, y + h, col)
    c.frect(x + rb, y + h - rb, w - rb * 2.0, rb, col)
}

fn zt_draw_hero(c: Canvas, a: App, x: float, y: float, w: float, h: float) {
    zt_card(c, x, y, w, h, 26.0, 6.0, zc_panel())
    zt_hazard(c, x + 2.0, x + w - 2.0, y + 2.0, 12.0, 24.0, zc_gold())
    c.frect(x + 2.0, y + 14.0, w - 4.0, 2.0, zt_mix(zc_ink(), WHITE, 0.12))
    // the body: tag, title, text and button, centred in the space under the stripe
    let bx = x + 20.0
    let body_top = y + 16.0
    let body_h = h - 16.0 - 6.0
    // (the browser puts the block one pixel higher than the plain sum of the heights gives)
    var ty = body_top + 18.0 + (body_h - 36.0 - 225.0) / 2.0 - 1.0
    let tag = "MAIN MODE · 10 MINUTES"
    let tw = zt_tw_ls(c, tag, 11, 900, 0.8) + 20.0
    c.rrect_rotated(bx + tw / 2.0, ty + 9.5, tw, 19.0, 9.5, -3.0, zc_toxic())
    zt_text_ls_rot(c, bx + tw / 2.0, ty + 9.5, tag, zc_ink(), 11, 900, 0.8, -3.0)
    ty += 19.0 + 8.0 + 4.0
    zt_text_ls(c, bx, ty + (50.0 - zt_lh(46)) / 2.0, "Classic", WHITE, 46, 900, -1.0)
    ty += 50.0 + 8.0
    for line in zt_wrap(c, "Survivors vs zombies. Get caught and you join the infection.", 14, 400, 196.0) {
        zt_text(c, bx, ty + (20.0 - zt_lh(14)) / 2.0, line, zc_text_dim(), 14, 400)
        ty += 20.0
    }
    ty += 8.0 + 8.0
    let label = "Play now"
    let btn_w = 30.0 + float(zt_tw(c, label, 17, 800)) + 8.0 + 18.0 + 30.0
    let down = 0.0
    zt_rr(c, bx, ty, btn_w, 60.0, 18.0, zc_ink())
    zt_bordered(c, bx, ty + down, btn_w, 56.0, 18.0, 2.0, zc_toxic(), zt_mix(zc_toxic(), WHITE, 0.12))
    zt_text(c, bx + 30.0, ty + down + 28.0 - zt_lh(17) / 2.0, label, zc_ink(), 17, 800)
    zt_icon(c, bx + btn_w - 30.0 - 18.0, ty + down + 19.0, "play", 18, zc_ink())
    zt_hit(a, bx, ty, btn_w, 60.0, "play")
    zt_zombie_art(c, x + w - 2.0 - 12.0 - 120.0, y + h - 6.0 - 14.0 - 130.0 - 5.0 * zt_bob(a))
}

fn zt_draw_mode_row(c: Canvas, a: App, x: float, y: float, w: float, h: float, mode: str, title: str, sub: str, icon: str, tint: int, live: bool) {
    zt_card(c, x, y, w, h, 20.0, 5.0, zc_panel())
    zt_hit(a, x, y, w, h, "mode:" + mode)
    let mid = y + 2.0 + (h - 7.0) / 2.0
    let ix = x + 16.0
    zt_bordered(c, ix, mid - 22.0, 44.0, 44.0, 12.0, 2.0, tint, zt_mix(tint, WHITE, 0.12))
    zt_icon(c, ix + 11.0, mid - 11.0, icon, 22, zc_ink())
    let chev = x + w - 16.0 - 22.0
    zt_icon(c, chev, mid - 11.0, "chevron-right", 22, zc_text_muted())
    // the layout leaves 17 pixels for the chevron, as the original does (its icon box is narrower than the glyph)
    var right = x + w - 16.0 - 17.13 - 14.0
    if live {
        let lt = "LIVE NOW"
        let pw = 18.0 + 6.0 + 5.0 + zt_tw_ls(c, lt, 11, 900, 0.5)
        let ph = 10.0 + zt_lh(11)
        let px = right - pw
        zt_bordered(c, px, mid - ph / 2.0, pw, ph, 6.0, 2.0, zc_blood(), zt_mix(zc_blood(), WHITE, 0.12))
        zt_disc(c, px + 12.0, mid, 3.0, zc_ink())
        zt_text_ls(c, px + 20.0, mid - zt_lh(11) / 2.0, lt, zc_ink(), 11, 900, 0.5)
        right = px - 14.0
    }
    let tx = ix + 44.0 + 14.0
    let lines = zt_wrap(c, title, 17, 700, right - tx)
    let block = float(lines.len()) * zt_lh(17) + 2.0 + zt_lh(13)
    var ty = mid - block / 2.0
    for line in lines {
        zt_text(c, tx, ty, line, WHITE, 17, 700)
        ty += zt_lh(17)
    }
    zt_text(c, tx, ty + 2.0, zt_ellipsis_f(c, sub, 13, 400, right - tx), zc_text_dim(), 13, 400)
}

fn zt_draw_quick(c: Canvas, a: App, x: float, y: float, w: float, icon: str, label: str, id: str) {
    zt_dashed(c, x, y, w, 48.0, 12.0, 2.0, 6.0, 4.0, zc_border())
    let tw = 18.0 + 8.0 + float(zt_tw(c, label, 14, 500))
    let lx = x + (w - tw) / 2.0
    zt_icon(c, lx, y + 15.0, icon, 18, zc_text_dim())
    zt_text(c, lx + 26.0, y + 24.0 - zt_lh(14) / 2.0, label, zc_text_dim(), 14, 500)
    zt_hit(a, x, y, w, 48.0, id)
}

// a tournament is running right now (the original shows "LIVE NOW" then)
fn zt_tournament_live() -> bool { return true }

fn zt_draw_home(c: Canvas, a: App) {
    let x = ZT_SIDE_W + 28.0
    let w = float(VIEW_W) - x - 28.0
    zt_draw_player_card(c, a, x, 42.0, w)
    let top = 42.0 + 91.0 + 14.0
    let bottom = float(VIEW_H) - 28.0 - 48.0 - 14.0
    // the hero takes 1.4 parts of the row and the mode list 1 part, with 20 pixels between them
    // (measured in the original: the browser gives the hero 2 pixels more than the plain 1.4 : 1 split)
    let hw = (w - 20.0) * 1.4 / 2.4 + 2.0
    zt_draw_hero(c, a, x, top, hw, bottom - top)
    let rx = x + hw + 20.0
    let rw = w - hw - 20.0
    let rh = (bottom - top - 24.0) / 3.0
    let modes = [("tournament", "Tournaments", "Scheduled competitions with prizes", "trophy-outline", zc_gold()),
        ("obstacle", "Obstacle Course", "Race the clock, collect medals", "flag-outline", zc_blue()),
        ("training", "Training", "Practice against bots, no pressure", "target", zc_purple())]
    for i, (mode, title, sub, icon, tint) in modes {
        zt_draw_mode_row(c, a, rx, top + float(i) * (rh + 12.0), rw, rh, mode, title, sub, icon, tint, mode == "tournament" and zt_tournament_live())
    }
    let qw = (w - 10.0) / 2.0
    zt_draw_quick(c, a, x, bottom + 14.0, qw, "pencil-outline", "Skin designer", "skin_designer")
    zt_draw_quick(c, a, x + qw + 10.0, bottom + 14.0, qw, "map-outline", "Map creator", "map_creator")
}

// ---------------------------------------------------------------- the menu canvas

fn zt_draw_menu(c: Canvas, a: App) {
    a.hits = []
    a.mx = c.mouse_x()
    a.my = c.mouse_y()
    c.clear(zc_bg())
    zt_draw_sidebar(c, a)
    if a.tab == "home" { zt_draw_home(c, a) }
}

fn zt_menu_click(a: App) {
    var id = ""
    for h in a.hits {
        if zt_over(a, h.x, h.y, h.w, h.h) { id = h.id }
    }
    if id == "" { return }
    zt_snd(a, "click")
    if id.starts_with("nav:") { a.tab = id[4..] }
    if id == "play" { zt_start(a) }
    if id.starts_with("mode:") {
        let m = id[5..]
        if m == "obstacle" {
            for i, mp in a.maps {
                if mp.obstacle {
                    a.map_i = i
                    break
                }
            }
        }
        zt_start(a)
    }
}

fn zt_menu_view(a: App) -> Node {
    return canvas(|c| { zt_draw_menu(c, a) }).grow(1.0).on_click(|| { zt_menu_click(a) })
}
