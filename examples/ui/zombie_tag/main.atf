// Zombie Tag - a survivors-versus-zombies game written entirely in ATF.
// Shows: a multi-file ATF program, std/ui canvas rendering with a camera and fog of war,
//        a game loop with ui_every, held keys, mouse aiming, tile maps, A* bots, std/sound.
// Run:   atf run examples/ui/zombie_tag/main.atf
//
// Controls: WASD / arrows move, 1 2 3 = abilities, E = start a task, Q = throw a stone at the mouse,
//           Esc = back to the menu.
// Survivors finish tasks (each one shortens the clock) and must outlast the zombies; infected survivors
// freeze for 10 seconds and doctors (+ marker) heal them. In the obstacle courses race to the finish.

import "std/ui"
import "std/sound"
import "bots"
import "tasks"
import "theme"
import "app"
import "gameview"
import "menu"
import "profile"

const VIEW_W = 960
const VIEW_H = 644

fn zt_make_sounds(a: App) {
    a.sounds["task"] = include_str("sounds/task.wav")
    a.sounds["infect"] = include_str("sounds/infected.wav")
    a.sounds["ability"] = include_str("sounds/ability.wav")
    a.sounds["stone"] = include_str("sounds/throw.wav")
    a.sounds["win"] = include_str("sounds/win.wav")
    a.sounds["lose"] = include_str("sounds/lose.wav")
    a.sounds["cure"] = include_str("sounds/heal.wav")
    a.sounds["bite"] = include_str("sounds/bite.wav")
    a.sounds["click"] = include_str("sounds/click.wav")
    a.sounds["shield"] = include_str("sounds/shield.wav")
    a.sounds["released"] = include_str("sounds/released.wav")
    a.sounds["hurt"] = include_str("sounds/hurt.wav")
    a.sounds["checkpoint"] = include_str("sounds/checkpoint.wav")
    a.sounds["tick"] = include_str("sounds/tick.wav")
    a.sounds["step1"] = include_str("sounds/step1.wav")
    a.sounds["step2"] = include_str("sounds/step2.wav")
    a.sounds["zstep"] = include_str("sounds/zstep.wav")
    a.sounds["heartbeat"] = include_str("sounds/heartbeat.wav")
    a.sounds["groan"] = include_str("sounds/groan.wav")
    a.sounds["beacon"] = include_str("sounds/beacon.wav")
    a.sounds["heal"] = a.sounds["cure"]
    a.sounds["stoneHit"] = include_str("sounds/stoneHit.wav")
}

fn zt_edge(a: App, k: str) -> bool {
    let d = ui_key_down(k)
    let was = a.prev_keys.get(k, false)
    a.prev_keys[k] = d
    return d and not was
}

fn zt_start(a: App) {
    let m = a.maps[a.map_i]
    let mode = if m.obstacle { M_OBSTACLE } else { M_CLASSIC }
    a.g = new_game(m, mode, a.skin_i, a.bots, a.level, 0, 2, 5.0, false)
    a.has_game = true
    a.task_open = false
    a.last = clock()
    a.screen = SCR_REVEAL
    a.reveal_left = 2.5
    a.end_wait = 0.0
    a.feed = []
    a.flash_until = 0.0
    a.stone_hit_at = 0.0
}

// the feed line an ability shows when the local player uses it ("" for none)
fn zt_ability_line(ab: int) -> str {
    return match ab {
        AB_SCAN => "Scan: all zombies revealed!"
        AB_ZVIS => "Zombie vision: seeing through walls"
        AB_SNIFF => "Sniff: you smell every survivor"
        AB_MEDIC => "Medic shield on"
        AB_BUBBLE => "Bubble shield on"
        AB_FLASH => "Flashbang! Nearby zombies blinded"
        AB_ROAR => "Roar! Nearby survivors slowed"
        AB_HOWL => "Howl! Survivors far and wide slowed"
        _ => ""
    }
}

// turn the engine's events into sounds, feed lines and screen flashes, like the original GameScreen
fn zt_events(a: App) {
    let g = a.g
    let me = local_player(g)
    for e in g.events {
        if e.kind == "infected" {
            if e.a == me.id {
                zt_snd(a, "infect")
                zt_flash(a, zc_blood(), 0.45)
                zt_feed(a, "You were bitten! Frozen for 10 seconds \u{2013} only a doctor can cure you", zc_zombie())
                a.task_open = false
            } else if e.b == me.id {
                zt_snd(a, "bite")
                zt_feed(a, "You infected {g.players[e.a].name}!", zc_zombie())
            } else {
                zt_feed(a, "{g.players[e.a].name} turned into a zombie", zc_blood())
            }
        }
        if e.kind == "cured" {
            if e.a == me.id {
                zt_snd(a, "heal")
                zt_feed(a, "Doctor {g.players[e.b].name} cured you!", zc_blue())
            } else if e.b == me.id {
                zt_snd(a, "heal")
                zt_feed(a, "You cured {g.players[e.a].name}!", zc_blue())
            } else {
                zt_feed(a, "{g.players[e.b].name} cured {g.players[e.a].name}", zc_blue())
            }
        }
        if e.kind == "blocked" and e.a == me.id {
            zt_snd(a, "shield")
            zt_feed(a, "Tank armor blocked the infection!", zc_gold())
        }
        if e.kind == "task" and e.a == me.id {
            zt_snd(a, "task")
            let title = ZT_TASK_TITLES[g.stations[e.b].kind % 5]
            zt_feed(a, "{title} done \u{B7} timer cut by 15s", zc_toxic())
        }
        if e.kind == "checkpoint" and e.a == me.id {
            zt_snd(a, "checkpoint")
            zt_feed(a, "Checkpoint!", zc_toxic())
        }
        if e.kind == "hazard" and e.a == me.id {
            zt_snd(a, "hurt")
            zt_flash(a, hex("#ff6b00"), 0.3)
            zt_feed(a, "Ouch! Back to the checkpoint", zc_blood())
        }
        if e.kind == "stone" {
            if e.a == me.id {
                zt_snd(a, "stone")
                a.stone_hit_at = clock() + 0.35
                zt_feed(a, "You threw a stone! Zombies will hear a noise there", zc_gold())
            } else if me.role == ZOMB {
                let t = g.players[e.a]
                if dist(t.noise_x, t.noise_y, me.x, me.y) <= NOISE_HEAR { zt_feed(a, "You heard a noise!", zc_gold()) }
            }
        }
        if e.kind == "ability" and e.a == me.id {
            zt_snd(a, "ability")
            let line = zt_ability_line(e.b)
            if line != "" { zt_feed(a, line, if me.role == ZOMB { zc_zombie() } else { zc_blue() }) }
        }
        if e.kind == "released" {
            zt_snd(a, "released")
            zt_feed(a, "The zombies are loose!", zc_blood())
        }
    }
    g.events = []
    if a.stone_hit_at > 0.0 and clock() >= a.stone_hit_at {
        a.stone_hit_at = 0.0
        zt_snd(a, "stoneHit")
    }
}

// footsteps, heartbeat, groans and the release countdown tick
fn zt_ambient(a: App, ox: float, oy: float) {
    let g = a.g
    let me = local_player(g)
    a.step_d += dist(ox, oy, me.x, me.y)
    let stride = if me.role == ZOMB { 58.0 } else { 44.0 }
    if a.step_d >= stride {
        a.step_d = 0.0
        a.step_alt = not a.step_alt
        zt_snd(a, if me.role == ZOMB { "zstep" } else if a.step_alt { "step1" } else { "step2" })
    }
    if me.role == SURV {
        var near = 1.0e18
        for p in g.players {
            if p.role == ZOMB and zombies_released(g) and not is_frozen(g, p) { near = min(near, dist(p.x, p.y, me.x, me.y)) }
        }
        if near < 320.0 and g.now >= a.next_heart {
            a.next_heart = g.now + 1.0
            zt_snd(a, "heartbeat")
        } else if near < 520.0 and g.now >= a.next_groan {
            a.next_groan = g.now + 4.0
            zt_snd(a, "groan")
        }
    }
    if not zombies_released(g) {
        let left = int(g.release_at - g.now)
        if left != a.last_tick and left <= 5 {
            a.last_tick = left
            zt_snd(a, "tick")
        }
    }
}

fn zt_human_won(g: Game) -> bool {
    let me = local_player(g)
    if g.winner == 2 { return true }
    if g.winner == 0 { return me.role == SURV }
    return me.role == ZOMB
}

fn zt_tick(a: App) {
    if a.screen == SCR_REVEAL {
        let t = clock()
        a.reveal_left -= t - a.last
        a.last = t
        if a.reveal_left <= 0.0 { a.screen = SCR_GAME }
        return
    }
    if a.screen != SCR_GAME { return }
    let now = clock()
    let dt = min(now - a.last, 0.05)
    a.last = now
    let g = a.g
    let me = local_player(g)
    if zt_edge(a, "escape") {
        a.confirm_exit = not a.confirm_exit
    }
    // keys
    var ix = 0.0
    var iy = 0.0
    if ui_key_down("a") or ui_key_down("left") { ix -= 1.0 }
    if ui_key_down("d") or ui_key_down("right") { ix += 1.0 }
    if ui_key_down("w") or ui_key_down("up") { iy -= 1.0 }
    if ui_key_down("s") or ui_key_down("down") { iy += 1.0 }
    me.ix = ix
    me.iy = iy
    let lo = loadout(me)
    for i in 0..lo.len() {
        if zt_edge(a, str(i + 1)) { activate(g, me, lo[i]) }
    }
    if zt_edge(a, "q") { throw_stone(g, me, me.facing) }
    if zt_edge(a, "e") { zt_open_task(a) }
    if a.task_open {
        task_tick(a.task, dt)
        if a.task.done {
            complete_task(g, me, a.task_station)
            a.task_open = false
        } else if me.role != SURV {
            a.task_open = false
        }
    }
    if a.confirm_exit { return }
    let ox = me.x
    let oy = me.y
    game_step(g, dt, bot_think)
    zt_events(a)
    zt_ambient(a, ox, oy)
    if g.winner >= 0 {
        if a.end_wait == 0.0 {
            a.end_wait = now
            zt_snd(a, if zt_human_won(g) { "win" } else { "lose" })
        }
        if now - a.end_wait > 1.5 { a.screen = SCR_END }
    }
}
// ---------------------------------------------------------------- menu and end screens

fn zt_role_reveal(a: App) -> Node {
    let me = local_player(a.g)
    let zombie = me.role == ZOMB
    let title = if zombie { "You are a ZOMBIE" } else { "You are a SURVIVOR" }
    let sub = if zombie { "Infect every survivor before the clock runs out" } else { "Finish tasks and avoid the zombies" }
    return column([
        character_node(SKINS[me.skin], 110, zombie),
        text(title).bold().font_size(34).color(if zombie { zc_toxic() } else { zc_blue() }),
        text(sub).color(zc_text_dim()).font_size(16),
        text("{int(a.reveal_left) + 1}").bold().font_size(48).color(zc_gold()),
    ]).gap(10).align(Align.Center).justify(Justify.Center).bg(zc_bg()).grow(1.0)
}

fn zt_end_view(a: App) -> Node {
    let g = a.g
    let me = local_player(g)
    let won = zt_human_won(g)
    var lines: [Node] = []
    var title = ""
    if g.mode == M_OBSTACLE {
        var medal = "No medal"
        let t = int(me.finished_at)
        if g.map.medals.len() >= 3 and me.finished_at >= 0.0 {
            if t <= g.map.medals[0] { medal = "Gold medal" } else if t <= g.map.medals[1] { medal = "Silver medal" } else if t <= g.map.medals[2] { medal = "Bronze medal" }
        }
        title = if me.finished_at >= 0.0 { "You finished!" } else { "Time is up" }
        lines.push(text("Time {me.finished_at:.2f}s  -  {medal}").font_size(18).color(zc_gold()))
        lines.push(text("Deaths {me.deaths}").color(zc_text_dim()))
    } else {
        title = if g.winner == 0 { "Survivors win!" } else { "Zombies took over!" }
        lines.push(text(if won { "Victory" } else { "Defeat" }).bold().font_size(20).color(if won { zc_toxic() } else { zc_blood() }))
        lines.push(text("Tasks {me.tasks.len()}   Infections {me.infections}   Cures {me.cures}   Abilities {me.abilities_used}").color(zc_text_dim()))
    }
    var board: [Node] = []
    var sorted = copy(g.players)
    sorted.sort_by(|x, y| (y.infections * 15 + y.tasks.len() * 10) - (x.infections * 15 + x.tasks.len() * 10))
    for i in 0..min(sorted.len(), 8) {
        let p = sorted[i]
        let nm = if p.id == 0 { "{p.name} (you)" } else { p.name }
        board.push(row([
            character_node(SKINS[p.skin], 30, p.role == ZOMB),
            text(nm).width(130).color(if p.id == 0 { zc_toxic() } else { WHITE }).bold(),
            text(if p.role == ZOMB { "Zombie" } else { "Survivor" }).width(80).color(if p.role == ZOMB { zc_zombie() } else { zc_blue() }),
            text("{p.infections} inf  {p.tasks.len()} tasks").color(zc_text_dim()),
            ]).gap(10).align(Align.Center).padding(4))
    }
    let tint = if g.mode == M_OBSTACLE { zc_gold() } else if g.winner == 1 { zc_zombie() } else { zc_blue() }
    return column([
        text(title).bold().font_size(44).color(tint),
        column(lines).gap(6).align(Align.Center),
        column(board).gap(2).padding(10).bg(zc_panel()).radius(14).border(2, zc_rim()).shadow(0, 5, 0, zc_ink()),
        row([
            zt_button("Play again", zc_toxic(), 170, 50, || { zt_start(a) }),
            zt_button("Menu", zc_panel_light(), 150, 50, || { a.screen = SCR_MENU }).color(WHITE),
        ]).gap(14),
    ]).gap(14).align(Align.Center).justify(Justify.Center).bg(zc_bg()).grow(1.0)
}

fn zt_view(a: App) -> Node {
    if a.screen == SCR_REVEAL and a.has_game { return zt_role_reveal(a) }
    if a.screen == SCR_GAME and a.has_game { return zt_game_view(a) }
    if a.screen == SCR_END and a.has_game { return zt_end_view(a) }
    return zt_menu_view(a)
}

fn main() {
    let ms = all_maps()
    let a = App{ maps: ms, g: new_game(ms[0], M_CLASSIC, 0, 1, 1, 1, 0, 5.0, false), task: task_new(0), prof: zt_load_profile(), start_t: clock() }
    zt_fonts()
    zt_make_sounds(a)
    // ZT_SHOT=game|reveal|end starts straight on that screen (used for screenshots)
    let shot = getenv("ZT_SHOT") ?? ""
    if shot != "" {
        a.map_i = int(getenv("ZT_MAP") ?? "0")
        zt_start(a)
        if shot != "reveal" { a.screen = SCR_GAME }
        if shot == "end" {
            a.g.winner = 0
            a.screen = SCR_END
        }
    }
    ui_every(16, || { zt_tick(a) })
    ui_run("Zombie Tag", VIEW_W, VIEW_H, || zt_view(a))
}
