// counter.atf - the smallest window program: a number and two buttons.
// Shows: ui_run, a view function, column/row, text, button, chained style methods, a reusable style.
// Run:   atf run examples/ui/counter.atf

import "std/ui"

struct App { count: int = 0 }

// a reusable style, like a CSS class
let PRIMARY = style().bg(hex("#4f46e5")).color(WHITE).border(0, TRANSPARENT)

fn view(app: App) -> Node {
    return column([
        text("Counter").font_size(14).weight(600).color(hex("slate")),
        text("{app.count}").font_size(64).bold(),
        row([
            button("−", || { app.count -= 1 }).width(56),
            button("Reset", || { app.count = 0 }),
            button("+", || { app.count += 1 }).width(56).style(PRIMARY),
        ]).gap(8),
    ]).center().gap(8).grow()
}

fn main() {
    let app = App()
    // view runs again after every click, so the screen always shows app.count
    ui_run("Counter", 360, 260, || view(app))
}
