// spreadsheet.atf - a small Excel-style spreadsheet with a real formula engine.
// Shows: a recursive descent parser and evaluator written in ATF, cell references and ranges, SUM/AVERAGE/MIN/MAX/COUNT,
//        cycle detection, error values, a formula bar, keyboard navigation, a scrolling grid built from data.
// Run:   atf run examples/ui/spreadsheet.atf
// Try:   click a cell and type  =B2*C2   or   =SUM(D2:D6)   or   =AVERAGE(B2:B6)*2   in the formula bar.

import "std/ui"

const SS_COLS = 10
const SS_ROWS = 30

var ss_raw: {str: str} = {}       // what the user typed, by cell name ("B2")
var ss_cache: {str: float} = {}   // evaluated values, rebuilt for every screen
var ss_errs: {str: str} = {}
var ss_busy: {str: bool} = {}     // cells being evaluated right now (cycle detection)
var ss_sel = "A1"
var ss_fail = ""                  // the error of the formula being evaluated
var ss_t: [str] = []              // the tokens of the formula being evaluated
var ss_i = 0

fn ss_name(col: int, row: int) -> str {
    return chr(65 + col) + str(row + 1)
}

// "C12" -> (2, 11); (-1, -1) when it is not a cell name inside the sheet
fn ss_split(name: str) -> (int, int) {
    if name.len() < 2 { return (-1, -1) }
    let col = int(name.byte_at(0)) - 65
    let row = name[1..].parse_int()
    if col < 0 or col >= SS_COLS or row == nil { return (-1, -1) }
    if row! < 1 or row! > SS_ROWS { return (-1, -1) }
    return (col, row! - 1)
}

fn ss_is_digit(b: byte) -> bool { return b >= '0' and b <= '9' }
fn ss_is_alpha(b: byte) -> bool { return (b >= 'A' and b <= 'Z') or (b >= 'a' and b <= 'z') }

fn ss_tokens(s: str) -> [str] {
    var out: [str] = []
    var i = 0
    let n = s.len()
    while i < n {
        let b = s.byte_at(i)
        if b == ' ' {
            i += 1
        } else if ss_is_digit(b) or b == '.' {
            var j = i
            while j < n and (ss_is_digit(s.byte_at(j)) or s.byte_at(j) == '.') { j += 1 }
            out.push(s[i..j])
            i = j
        } else if ss_is_alpha(b) {
            var j = i
            while j < n and (ss_is_alpha(s.byte_at(j)) or ss_is_digit(s.byte_at(j))) { j += 1 }
            out.push(s[i..j].upper())
            i = j
        } else {
            out.push(s[i..i + 1])
            i += 1
        }
    }
    return out
}

fn ss_peek() -> str {
    if ss_i < ss_t.len() { return ss_t[ss_i] }
    return ""
}

fn ss_error(msg: str) {
    if ss_fail == "" { ss_fail = msg }
}

// the value of a cell, evaluating its formula the first time it is asked for
fn ss_ref(name: str) -> float {
    if name in ss_cache {
        if ss_errs[name] != "" { ss_error(ss_errs[name]) }
        return ss_cache[name]
    }
    if name in ss_busy {
        ss_error("#CYCLE")
        return 0.0
    }
    ss_busy[name] = true
    let saved_t = ss_t
    let saved_i = ss_i
    let outer = ss_fail
    ss_fail = ""
    var v = 0.0
    let raw = ss_raw.get(name, "")
    if raw.starts_with("=") {
        ss_t = ss_tokens(raw[1..])
        ss_i = 0
        v = ss_expr()
        if ss_i < ss_t.len() { ss_error("#ERR") }
    } else {
        let n = raw.trim().parse_float()
        if n != nil { v = n! }
    }
    ss_cache[name] = v
    ss_errs[name] = ss_fail
    ss_busy.remove(name)
    let mine = ss_fail
    ss_t = saved_t
    ss_i = saved_i
    ss_fail = outer
    if mine != "" { ss_error(mine) }
    return v
}

fn ss_has_number(name: str) -> bool {
    let raw = ss_raw.get(name, "").trim()
    return raw.starts_with("=") or raw.parse_float() != nil
}

fn ss_expr() -> float {
    var v = ss_term()
    while ss_peek() == "+" or ss_peek() == "-" {
        let op = ss_peek()
        ss_i += 1
        let r = ss_term()
        if op == "+" { v += r } else { v -= r }
    }
    return v
}

fn ss_term() -> float {
    var v = ss_unary()
    while ss_peek() == "*" or ss_peek() == "/" {
        let op = ss_peek()
        ss_i += 1
        let r = ss_unary()
        if op == "*" {
            v *= r
        } else if r == 0.0 {
            ss_error("#DIV/0!")
        } else {
            v /= r
        }
    }
    return v
}

fn ss_unary() -> float {
    if ss_peek() == "-" {
        ss_i += 1
        return -ss_unary()
    }
    let base = ss_atom()
    if ss_peek() == "^" {
        ss_i += 1
        return base ** ss_unary()
    }
    return base
}

// the numbers named by one function argument: a range like A1:B3, or a single expression
fn ss_args() -> [float] {
    var vals: [float] = []
    ss_i += 1   // the "("
    while ss_peek() != ")" {
        if ss_peek() == "" { ss_error("#ERR"); return vals }
        let first = ss_peek()
        if ss_i + 2 < ss_t.len() and ss_t[ss_i + 1] == ":" {
            let (c1, r1) = ss_split(first)
            let (c2, r2) = ss_split(ss_t[ss_i + 2])
            if c1 < 0 or c2 < 0 { ss_error("#REF!"); return vals }
            for r in min(r1, r2)..=max(r1, r2) {
                for c in min(c1, c2)..=max(c1, c2) {
                    let nm = ss_name(c, r)
                    if ss_has_number(nm) { vals.push(ss_ref(nm)) }
                }
            }
            ss_i += 3
        } else {
            vals.push(ss_expr())
        }
        if ss_peek() == "," { ss_i += 1 }
    }
    ss_i += 1   // the ")"
    return vals
}

fn ss_call(fname: str) -> float {
    let a = ss_args()
    if fname == "SUM" { return a.sum() }
    if fname == "COUNT" { return float(a.len()) }
    if fname == "ABS" and a.len() == 1 { return abs(a[0]) }
    if fname == "SQRT" and a.len() == 1 { return sqrt(a[0]) }
    if a.len() == 0 { ss_error("#ERR"); return 0.0 }
    if fname == "AVERAGE" or fname == "AVG" { return a.sum() / float(a.len()) }
    if fname == "MIN" { return a.min() }
    if fname == "MAX" { return a.max() }
    ss_error("#NAME?")
    return 0.0
}

fn ss_atom() -> float {
    let t = ss_peek()
    if t == "" { ss_error("#ERR"); return 0.0 }
    ss_i += 1
    if t == "(" {
        let v = ss_expr()
        if ss_peek() == ")" { ss_i += 1 } else { ss_error("#ERR") }
        return v
    }
    let b = t.byte_at(0)
    if ss_is_digit(b) or b == '.' {
        let n = t.parse_float()
        if n == nil { ss_error("#ERR"); return 0.0 }
        return n!
    }
    if ss_is_alpha(b) {
        if ss_peek() == "(" { return ss_call(t) }
        let (c, _) = ss_split(t)
        if c < 0 { ss_error("#REF!"); return 0.0 }
        return ss_ref(t)
    }
    ss_error("#ERR")
    return 0.0
}

// ---------------------------------------------------------------- showing cells

fn ss_fmt(v: float) -> str {
    if v == floor(v) and abs(v) < 1.0e15 { return str(int(v)) }
    var s = "{v:.4f}"
    while s.ends_with("0") { s = s[..s.len() - 1] }
    return s
}

fn ss_display(name: str) -> str {
    let raw = ss_raw.get(name, "")
    if raw == "" { return "" }
    let n = raw.trim().parse_float()
    if not raw.starts_with("=") and n == nil { return raw }   // text
    let v = ss_ref(name)
    if ss_errs[name] != "" { return ss_errs[name] }
    return ss_fmt(v)
}

fn ss_is_text(name: str) -> bool {
    let raw = ss_raw.get(name, "")
    return raw != "" and not raw.starts_with("=") and raw.trim().parse_float() == nil
}

fn ss_move(dc: int, dr: int) {
    let (c, r) = ss_split(ss_sel)
    ss_sel = ss_name(clamp(c + dc, 0, SS_COLS - 1), clamp(r + dr, 0, SS_ROWS - 1))
}

let SS_GREEN = hex("#217346")
let SS_HEAD = style().bg(hex("#f3f4f6")).color(hex("#374151")).border(1, hex("#d1d5db")).font_size(13).center()

fn ss_cell(name: str) -> Node {
    var st = style().bg(WHITE).border(1, hex("#e5e7eb")).padding(0, 6).font_size(14)
    if name == ss_sel { st = st.border(2, SS_GREEN).bg(hex("#f0fdf4")) }
    var shown = ss_display(name)
    var col = BLACK
    if shown.starts_with("#") { col = hex("#dc2626") }
    var align = Align.End
    if ss_is_text(name) { align = Align.Start }
    return box([text(shown).color(col).nowrap().text_align(align)]).style(st).size(96, 26).justify(Justify.Center)
        .cursor(Cursor.Pointer).on_click(|| { ss_sel = name })
}

fn ss_view() -> Node {
    ss_cache = {}
    ss_errs = {}
    ss_busy = {}
    var head: [Node] = [box().style(SS_HEAD).size(40, 26)]
    for c in 0..SS_COLS { head.push(box([text(chr(65 + c))]).style(SS_HEAD).size(96, 26)) }
    var rows: [Node] = [row(head).gap(0)]
    for r in 0..SS_ROWS {
        var cells: [Node] = [box([text(str(r + 1))]).style(SS_HEAD).size(40, 26)]
        for c in 0..SS_COLS { cells.push(ss_cell(ss_name(c, r))) }
        rows.push(row(cells).gap(0))
    }
    return column([
        row([
            text("Book1").bold().color(WHITE).font_size(15),
            spacer(),
            text("ATF Sheets").color(hex("#bbf7d0")).font_size(13),
        ]).bg(SS_GREEN).padding(8, 14),
        row([
            text(ss_sel).bold().width(54).text_align(Align.Center).bg(hex("#f3f4f6")).padding(6).radius(4),
            text("fx").italic().color(hex("slate")),
            textbox(ss_raw.get(ss_sel, ""), |s| { ss_raw[ss_sel] = s }).key("formula").grow().on_submit(|| { ss_move(0, 1) }),
        ]).gap(8).padding(8),
        scroll(rows).grow(),
    ]).bg(WHITE)
}

fn ss_demo() {
    let data = [
        ["Item", "Qty", "Price", "Total"],
        ["Pens", "12", "1.5", "=B2*C2"],
        ["Notebooks", "5", "3.2", "=B3*C3"],
        ["Folders", "20", "0.75", "=B4*C4"],
        ["Stapler", "2", "8", "=B5*C5"],
        ["Tape", "10", "1.1", "=B6*C6"],
        ["", "", "", ""],
        ["Sum", "=SUM(B2:B6)", "=AVERAGE(C2:C6)", "=SUM(D2:D6)"],
        ["Max total", "", "", "=MAX(D2:D6)"],
        ["With tax 17%", "", "", "=D8*1.17"],
    ]
    for r in 0..data.len() {
        for c in 0..data[r].len() {
            if data[r][c] != "" { ss_raw[ss_name(c, r)] = data[r][c] }
        }
    }
}

fn main() {
    ss_demo()
    ui_shortcut("up", || { ss_move(0, -1) })
    ui_shortcut("down", || { ss_move(0, 1) })
    ui_shortcut("left", || { ss_move(-1, 0) })
    ui_shortcut("right", || { ss_move(1, 0) })
    ui_shortcut("delete", || { ss_raw.remove(ss_sel) })
    ui_shortcut("f2", || { focus_field("formula") })
    ui_run("ATF Sheets", 760, 520, ss_view)
}
