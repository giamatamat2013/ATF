// calendar.atf - leap years, day of the week and a printed month calendar.
// Shows: integer math (Zeller-like formula), arrays of names, nested loops, format specs,
//        const values, early return.
// Run:   python run_atf.py run examples/calendar.atf

const MONTHS = ["January", "February", "March", "April", "May", "June", "July",
                "August", "September", "October", "November", "December"]
const DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]

fn is_leap(year: int) -> bool {
    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
}

fn days_in_month(year: int, month: int) -> int {
    return match month {
        2 => if is_leap(year) { 29 } else { 28 }
        4 | 6 | 9 | 11 => 30
        _ => 31
    }
}

// 0 = Sunday ... 6 = Saturday  (Sakamoto's algorithm)
fn weekday(year: int, month: int, day: int) -> int {
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    var y = year
    if month < 3 { y -= 1 }
    return (y + y / 4 - y / 100 + y / 400 + t[month - 1] + day) % 7
}

fn print_month(year: int, month: int) {
    let title = "{MONTHS[month - 1]} {year}"
    println(pad_center(title, 20).trim_end())
    println("Su Mo Tu We Th Fr Sa")
    var line = "   " * weekday(year, month, 1)
    for d in 1..=days_in_month(year, month) {
        line = line + "{d:>2}"
        if weekday(year, month, d) == 6 {
            println(line)
            line = ""
        } else {
            line = line + " "
        }
    }
    if line.len() > 0 { println(line.trim_end()) }
}

fn main() {
    for y in [1900, 2000, 2023, 2024, 2100] {
        println("{y} is a leap year? {is_leap(y)}")
    }

    for date in [(2000, 1, 1), (1969, 7, 20), (2024, 2, 29), (2038, 1, 19)] {
        let (y, m, d) = date
        println("{y}-{pad_zero(str(m), 2)}-{pad_zero(str(d), 2)} was a {DAYS[weekday(y, m, d)]}")
    }

    println()
    print_month(2024, 2)
    println()
    print_month(2023, 10)

    // how many Friday the 13ths are there in 2026?
    var count = 0
    for m in 1..=12 {
        if weekday(2026, m, 13) == 5 { count += 1 }
    }
    println()
    println("Friday the 13th happens {count} times in 2026")
}
