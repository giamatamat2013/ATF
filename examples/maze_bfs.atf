// maze_bfs.atf - find the shortest path through a maze with breadth first search.
// Shows: parsing a multi-line string, a queue as an array with a head index, 2D arrays of ints,
//        structs for points, tracing a path back through a parent table.
// Run:   python run_atf.py run examples/maze_bfs.atf

let MAZE = """
#####################
#S..#.......#.......#
#.#.#.#####.#.#####.#
#.#...#...#...#...#.#
#.#####.#.#####.#.#.#
#.......#.......#...#
#######.#########.###
#.....#.........#...#
#.###.#########.###.#
#...#...........#..E#
#####################
"""

struct Point {
    x: int,
    y: int
}

fn find(grid: [str], ch: str) -> Point {
    for y in 0..grid.len() {
        let x = grid[y].find(ch)
        if x >= 0 { return Point(x, y) }
    }
    panic("no {ch} in the maze")
}

fn solve(grid: [str]) -> [Point]? {
    let h = grid.len()
    let w = grid[0].len()
    let start = find(grid, "S")
    let goal = find(grid, "E")
    // parent[y * w + x] = index of the cell we came from, -1 = not visited yet
    let parent = array_make::<int>(w * h)
    parent.fill(-1)
    var queue: [Point] = [start]
    var head = 0
    parent[start.y * w + start.x] = start.y * w + start.x
    let dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    while head < queue.len() {
        let p = queue[head]
        head += 1
        if p.x == goal.x and p.y == goal.y {
            // walk back from the goal to the start
            var path: [Point] = []
            var cur = p.y * w + p.x
            while cur != start.y * w + start.x {
                path.push(Point(cur % w, cur / w))
                cur = parent[cur]
            }
            path.push(start)
            path.reverse()
            return path
        }
        for d in dirs {
            let nx = p.x + d.0
            let ny = p.y + d.1
            if nx < 0 or ny < 0 or nx >= w or ny >= h { continue }
            if grid[ny][nx] == "#" { continue }
            if parent[ny * w + nx] != -1 { continue }
            parent[ny * w + nx] = p.y * w + p.x
            queue.push(Point(nx, ny))
        }
    }
    return nil
}

fn main() {
    let grid = MAZE.trim().split("\n")
    println("maze is {grid[0].len()} x {grid.len()}")
    let path = solve(grid)
    if path == nil {
        println("no way out")
        return
    }
    let p = path!
    println("shortest path has {p.len() - 1} steps")

    // draw the path with 'o'. Strings are immutable, so every row becomes an array of characters.
    var rows: [[str]] = []
    for line in grid { rows.push(line.chars()) }
    for i in 1..p.len() - 1 {
        rows[p[i].y][p[i].x] = "o"
    }
    for r in rows { println("".join(r)) }

    // a goal behind a wall cannot be reached
    println("blocked maze: {solve(["S#E"])}")
    println("open corridor: {solve(["S.E"])}")
}
