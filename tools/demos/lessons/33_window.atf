import "std/ui"

let CARD = style().bg(WHITE).radius(16).padding(20).gap(12).shadow(0, 8, 24, rgba(15, 23, 42, 0.1))
let PRIMARY = style().bg(hex("#4f46e5")).color(WHITE).border(0, TRANSPARENT).hover(style().bg(hex("#4338ca"))).transition(150)

struct App { count: int = 0 }

fn view(app: App) -> Node {
    return column([
        text("You clicked {app.count} times").font_size(22).bold(),
        row([
            button("Reset", || { app.count = 0 }),
            spacer(),
            button("Click me", || { app.count += 1 }).style(PRIMARY),
        ]).gap(8),
    ]).style(CARD).margin(24)
}

fn main() {
    let app = App()
    ui_run("Counter", 420, 240, || view(app))
}
