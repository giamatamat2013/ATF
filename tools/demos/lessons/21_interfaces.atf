interface Shape {
    fn area(self) -> float
    fn describe(self) -> str => "a shape with area {self.area()}"
}

struct Circle { r: float }
struct Square { side: float }

impl Circle {
    fn area(self) -> float { return 3.0 * self.r * self.r }
}

impl Square {
    fn area(self) -> float { return self.side * self.side }
    fn describe(self) -> str { return "a square" }
}

fn main() {
    let shapes: [Shape] = [Circle(1.0), Square(2.0)]
    for s in shapes {
        println(s.describe())
        println(s.area())
    }
}
