fn main() {
    for i in 0..3 { print("{i} ") }
    println("")
    for i in 0..=3 { print("{i} ") }
    println("")
    for i in 0..20 step 5 { print("{i} ") }
    println("")
    for i in 10..0 step -3 { print("{i} ") }
    println("")
    let names = ["ada", "grace"]
    for i, name in names { println("{i}: {name}") }
    for ch in "hi" { print("[{ch}]") }
    println("")
    outer: for a in 1..=3 {
        for b in 1..=3 {
            if a * b == 4 {
                println("found {a} x {b}")
                break outer
            }
        }
    }
}
