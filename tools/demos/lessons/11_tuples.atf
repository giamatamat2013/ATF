fn min_max(values: [int]) -> (int, int) {
    var lo = values[0]
    var hi = values[0]
    for v in values {
        if v < lo { lo = v }
        if v > hi { hi = v }
    }
    return (lo, hi)
}

fn main() {
    let (lo, hi) = min_max([4, -2, 9, 3])
    println("lo={lo} hi={hi}")
    let pair = (1, "one")
    println(pair.0)
    println(pair.1)
    let (_, label) = pair
    println(label)
}
