import "std/test"

fn add(a: int, b: int) -> int { return a + b }

fn main() -> int {
    test("addition", || {
        expect_eq(add(1, 1), 2)
        expect(add(2, 2) > 3, "four is bigger than three")
    })
    test("negative numbers", || {
        expect_eq(add(-1, 1), 0)
    })
    expect_panics("division by zero", || {
        let z = 0
        println(1 / z)
    })
    return test_report()
}
