{
  "Function": {
    "prefix": "fn",
    "description": "Function with parameters and a result type",
    "body": [
      "fn ${1:name}(${2:x: int}) -> ${3:int} {",
      "\t${0:return x}",
      "}"
    ]
  },
  "Function without result": {
    "prefix": "fnv",
    "description": "Function that returns nothing",
    "body": [
      "fn ${1:name}(${2}) {",
      "\t$0",
      "}"
    ]
  },
  "Short function": {
    "prefix": "fne",
    "description": "One-expression function: fn f(x: int) -> int => ...",
    "body": [
      "fn ${1:name}(${2:x: int}) -> ${3:int} => ${0:x}"
    ]
  },
  "Generic function": {
    "prefix": "fng",
    "description": "Generic function with a type parameter",
    "body": [
      "fn ${1:name}<${2:T}>(${3:x}: $2) -> $2 {",
      "\t${0:return $3}",
      "}"
    ]
  },
  "Main": {
    "prefix": "main",
    "description": "Program entry point",
    "body": [
      "fn main() {",
      "\t${0:println(\"Hello, world!\")}",
      "}"
    ]
  },
  "Main with arguments": {
    "prefix": "mainargs",
    "description": "Entry point that receives the command line arguments and returns the exit code",
    "body": [
      "fn main(args: [str]) -> int {",
      "\tif args.len() < ${1:1} {",
      "\t\teprintln(\"usage: ${2:program} ${3:<file>}\")",
      "\t\treturn 1",
      "\t}",
      "\t$0",
      "\treturn 0",
      "}"
    ]
  },
  "Struct": {
    "prefix": "struct",
    "description": "Struct declaration",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int}$0",
      "}"
    ]
  },
  "Enum": {
    "prefix": "enum",
    "description": "Enum declaration (variants may carry data)",
    "body": [
      "enum ${1:Name} {",
      "\t${2:First},",
      "\t${3:Second(int)}$0",
      "}"
    ]
  },
  "Impl": {
    "prefix": "impl",
    "description": "Methods for a type",
    "body": [
      "impl ${1:Name} {",
      "\tfn ${2:method}(self${3}) -> ${4:str} {",
      "\t\t${0:return \"\"}",
      "\t}",
      "}"
    ]
  },
  "Struct with impl": {
    "prefix": "structimpl",
    "description": "Struct with a constructor and a to_str method",
    "body": [
      "struct ${1:Name} {",
      "\t${2:value}: ${3:int}",
      "}",
      "",
      "impl $1 {",
      "\tfn new($2: $3) -> $1 {",
      "\t\treturn $1($2)",
      "\t}",
      "",
      "\tfn to_str(self) -> str {",
      "\t\treturn \"$1({self.$2})\"",
      "\t}",
      "}$0"
    ]
  },
  "Interface": {
    "prefix": "interface",
    "description": "Interface declaration",
    "body": [
      "interface ${1:Name} {",
      "\tfn ${2:method}(self) -> ${3:str}$0",
      "}"
    ]
  },
  "Match": {
    "prefix": "match",
    "description": "match with a catch-all arm",
    "body": [
      "match ${1:value} {",
      "\t${2:0} => ${3:println(\"zero\")}",
      "\t_ => ${0:println(\"other\")}",
      "}"
    ]
  },
  "For in": {
    "prefix": "for",
    "description": "Loop over the items of an array, string, map or set",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t${0:println($1)}",
      "}"
    ]
  },
  "For range": {
    "prefix": "forr",
    "description": "Loop over a range of numbers",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t${0:println($1)}",
      "}"
    ]
  },
  "For index and value": {
    "prefix": "fori",
    "description": "Loop with the index and the value",
    "body": [
      "for ${1:i}, ${2:item} in ${3:items} {",
      "\t${0:println($1, $2)}",
      "}"
    ]
  },
  "While": {
    "prefix": "while",
    "description": "while loop",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ]
  },
  "While let": {
    "prefix": "whilelet",
    "description": "Repeat while an optional has a value",
    "body": [
      "while let ${1:value} = ${2:optional} {",
      "\t$0",
      "}"
    ]
  },
  "Loop": {
    "prefix": "loop",
    "description": "Endless loop (leave it with break)",
    "body": [
      "loop {",
      "\t$0",
      "\tbreak",
      "}"
    ]
  },
  "If": {
    "prefix": "if",
    "description": "if statement",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ]
  },
  "If else": {
    "prefix": "ifelse",
    "description": "if / else statement",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ]
  },
  "If let": {
    "prefix": "iflet",
    "description": "Run a block only when an optional has a value",
    "body": [
      "if let ${1:value} = ${2:optional} {",
      "\t$3",
      "} else {",
      "\t$0",
      "}"
    ]
  },
  "Let": {
    "prefix": "let",
    "description": "Immutable variable",
    "body": [
      "let ${1:name} = ${0:value}"
    ]
  },
  "Var": {
    "prefix": "var",
    "description": "Mutable variable",
    "body": [
      "var ${1:name} = ${0:value}"
    ]
  },
  "Const": {
    "prefix": "const",
    "description": "Compile-time constant (outside functions)",
    "body": [
      "const ${1:NAME} = ${0:value}"
    ]
  },
  "Lambda": {
    "prefix": "lambda",
    "description": "Anonymous function |x| expression",
    "body": [
      "|${1:x}| ${0:$1 * 2}"
    ]
  },
  "Lambda block": {
    "prefix": "lambdab",
    "description": "Anonymous function with a block body",
    "body": [
      "|${1:x}| {",
      "\t$0",
      "}"
    ]
  },
  "Test": {
    "prefix": "test",
    "description": "A test function that checks a condition with assert",
    "body": [
      "fn test_${1:name}() {",
      "\tassert(${2:1 + 1 == 2}, \"${3:$1 failed}\")$0",
      "}"
    ]
  },
  "Catch panic": {
    "prefix": "catch",
    "description": "Run code and recover from a panic",
    "body": [
      "let ${1:err} = catch_panic(|| {",
      "\t$0",
      "})",
      "if $1 != nil {",
      "\teprintln(\"failed: {$1!}\")",
      "}"
    ]
  },
  "Result function": {
    "prefix": "fnres",
    "description": "Function that returns a Result",
    "body": [
      "fn ${1:name}(${2:s: str}) -> Result<${3:int}, str> {",
      "\t$0",
      "\treturn Result.Ok(${4:0})",
      "}"
    ]
  },
  "Println": {
    "prefix": "pl",
    "description": "println with interpolation",
    "body": [
      "println(\"${1:value} = {${2:$1}}\")$0"
    ]
  },
  "Import": {
    "prefix": "import",
    "description": "Import another file (path relative to this file, without .atf)",
    "body": [
      "import \"${1:lib/module}\""
    ]
  },
  "Defer": {
    "prefix": "defer",
    "description": "Run a statement when the function ends",
    "body": [
      "defer ${0:println(\"done\")}"
    ]
  },
  "Web page": {
    "prefix": "htmlpage",
    "description": "A web page with std/html and a built-in animation",
    "body": [
      "import \"std/html\"",
      "",
      "fn main() {",
      "\tlet page = html_page(\"${1:Title}\", [",
      "\t\th(\"h1\").text(\"${2:Hello}\").anim(\"slide-up\"),",
      "\t])",
      "\twrite_file(\"index.html\", page)",
      "}"
    ]
  },
  "Animated value": {
    "prefix": "animate",
    "description": "A value that glides to its target (std/ui)",
    "body": [
      "let ${1:x} = animate(\"${2:key}\", ${3:target}, ${4:300})"
    ]
  },
  "Window program": {
    "prefix": "uiapp",
    "description": "A window program with std/ui: data, a view function and ui_run",
    "body": [
      "import \"std/ui\"",
      "",
      "struct ${1:App} {",
      "\tcount: int = 0",
      "}",
      "",
      "fn view(app: ${1:App}) -> Node {",
      "\treturn column([",
      "\t\ttext(\"Clicked {app.count} times\").font_size(22).bold(),",
      "\t\tbutton(\"Click me\", || { app.count += 1 }).bg(hex(\"#4f46e5\")).color(WHITE).border(0, TRANSPARENT),",
      "\t\t$0",
      "\t]).padding(24).gap(12).center().grow()",
      "}",
      "",
      "fn main() {",
      "\tlet app = ${1:App}()",
      "\tui_run(\"${2:My app}\", ${3:480}, ${4:320}, || view(app))",
      "}"
    ]
  },
  "Reusable style": {
    "prefix": "uistyle",
    "description": "A reusable std/ui style (like a CSS class) with a hover state",
    "body": [
      "let ${1:CARD} = style().bg(${2:WHITE}).radius(${3:12}).padding(${4:16})",
      "\t.hover(style().bg(${5:hex(\"#f1f5f9\")})).transition(150)"
    ]
  },
  "Row of elements": {
    "prefix": "uirow",
    "description": "A std/ui row: children side by side with a gap",
    "body": [
      "row([",
      "\t$0",
      "]).gap(${1:8})"
    ]
  },
  "Column of elements": {
    "prefix": "uicol",
    "description": "A std/ui column: children one under the other with a gap",
    "body": [
      "column([",
      "\t$0",
      "]).gap(${1:8})"
    ]
  },
  "Menu bar": {
    "prefix": "uimenu",
    "description": "A std/ui menu bar with a File menu",
    "body": [
      "menu_bar([",
      "\tmenu_button(\"File\", [",
      "\t\tmenu_item(\"${1:New}\", || ${2:new_file}()),",
      "\t\tmenu_item(\"Exit\", || ui_quit()),",
      "\t]),",
      "\t$0",
      "])"
    ]
  },
  "Text area": {
    "prefix": "uitextarea",
    "description": "A multi-line text field",
    "body": [
      "textarea(${1:app.text}, |s| { ${1:app.text} = s }).grow().rows(${2:10})"
    ]
  },
  "Select list": {
    "prefix": "uiselect",
    "description": "A choice from a list (a drop-down)",
    "body": [
      "select(${1:app.choice}, [${2:\"one\", \"two\", \"three\"}], |v| { ${1:app.choice} = v })"
    ]
  },
  "Dialog": {
    "prefix": "uidialog",
    "description": "A modal dialog shown while a flag is set (add it last in the root)",
    "body": [
      "if ${1:app.asking} {",
      "\troot.add(dialog(\"${2:Title}\", text(\"${3:Are you sure?}\"), [",
      "\t\tbutton(\"OK\", || { ${1:app.asking} = false }),",
      "\t], || { ${1:app.asking} = false }))",
      "}"
    ]
  },
  "Canvas": {
    "prefix": "uicanvas",
    "description": "A canvas you draw yourself",
    "body": [
      "canvas(|c| {",
      "\tc.rect(0, 0, c.w, c.h, ${1:WHITE})",
      "\t$0",
      "}).size(${2:300}, ${3:200})"
    ]
  },
  "Keyboard shortcut": {
    "prefix": "uishortcut",
    "description": "A keyboard shortcut for a window program",
    "body": [
      "ui_shortcut(\"${1:ctrl+s}\", || ${2:save}(${3:app}))"
    ]
  },
  "File dialogs": {
    "prefix": "uifile",
    "description": "Ask the user for a file to open or a place to save",
    "body": [
      "let ${1:path} = ${2|open_file_dialog,save_file_dialog|}(\"${3:Title}\", \"Text files|*.txt|All files|*.*\") ?? \"\"",
      "if ${1:path}.len() == 0 { return }",
      "$0"
    ]
  },
  "UI test": {
    "prefix": "uitest",
    "description": "Test a std/ui program without a window",
    "body": [
      "import \"std/ui\"",
      "",
      "fn main() {",
      "\tlet app = ${1:App}()",
      "\tui_headless(|| view(app), ${2:480}, ${3:320})",
      "\tui_click_text(\"${4:Click me}\")",
      "\tprintln(${5:app.count})",
      "}"
    ]
  },
  "Settings": {
    "prefix": "uisettings",
    "description": "Load and save program settings with std/app",
    "body": [
      "import \"std/app\"",
      "",
      "let settings = settings_open(\"${1:myapp}\")",
      "let ${2:theme} = settings.get(\"${2:theme}\", \"${3:light}\")",
      "settings.set(\"${2:theme}\", ${2:theme})",
      "settings.save()"
    ]
  },
  "Command-line parser": {
    "prefix": "argsparse",
    "description": "A command-line program with std/args and std/log",
    "body": [
      "import \"std/args\"",
      "import \"std/log\"",
      "",
      "fn main(argv: [str]) -> int {",
      "\tlet p = args_parser(\"${1:tool}\", \"${2:what it does}\")",
      "\tp.flag(\"verbose\", \"v\", \"more output\")",
      "\tp.option(\"${3:output}\", \"${4:o}\", \"${5:where to write}\", \"${6:out.txt}\")",
      "\tp.positional(\"${7:input}\", \"${8:the input file}\")",
      "\tlet a = p.parse_or_exit(argv)",
      "\tif a.flag(\"verbose\") { log_set_level(LOG_DEBUG) }",
      "\t$0",
      "\treturn 0",
      "}"
    ]
  },
  "Regex match": {
    "prefix": "regex",
    "description": "Find a regular expression in text with std/regex",
    "body": [
      "import \"std/regex\"",
      "",
      "let re = regex(\"${1:(\\\\d+)-(\\\\d+)}\")",
      "if let m = re.find(${2:text}) {",
      "\tprintln(m.text, m.group(1))",
      "}"
    ]
  },
  "Test": {
    "prefix": "test",
    "description": "Tests with std/test",
    "body": [
      "import \"std/test\"",
      "",
      "fn main() -> int {",
      "\ttest(\"${1:name}\", || { expect_eq(${2:1 + 1}, ${3:2}) })",
      "\treturn test_report()",
      "}"
    ]
  },
  "HTTP GET": {
    "prefix": "httpget",
    "description": "Download a page with std/http",
    "body": [
      "import \"std/http\"",
      "",
      "match http_get(\"${1:https://example.com/}\") {",
      "\tResult.Ok(r) => println(r.status, r.body.len())",
      "\tResult.Err(e) => println(\"request failed: \" + e)",
      "}"
    ]
  },
  "XML read": {
    "prefix": "xmlread",
    "description": "Read an XML file with std/xml",
    "body": [
      "import \"std/xml\"",
      "",
      "match xml_read_file(\"${1:data.xml}\") {",
      "\tResult.Ok(root) => {",
      "\t\tfor n in root.find_all(\"${2:item}\") {",
      "\t\t\tprintln(n.attr_or(\"${3:id}\", \"\"), n.inner_text())",
      "\t\t}",
      "\t}",
      "\tResult.Err(e) => println(\"bad XML: \" + e)",
      "}"
    ]
  },
  "Web server": {
    "prefix": "httpserve",
    "description": "A small web server with std/httpd",
    "body": [
      "import \"std/httpd\"",
      "",
      "fn main() {",
      "\tvar app = router_new()",
      "\tapp.get(\"/\", |req| http_html(\"<h1>${1:Hello}</h1>\"))",
      "\tapp.get(\"/hello/:name\", |req| http_text(\"Hello, \" + req.params[\"name\"]))",
      "\tlet server = http_listen(${2:8080}).unwrap()",
      "\tprintln(\"open http://127.0.0.1:{server.port}/\")",
      "\tserver.serve(|req| app.handle(req))",
      "}"
    ]
  },
  "TCP client": {
    "prefix": "tcpclient",
    "description": "Talk to a TCP server with std/net",
    "body": [
      "import \"std/net\"",
      "",
      "match tcp_connect(\"${1:example.com}\", ${2:80}) {",
      "\tResult.Ok(conn) => {",
      "\t\tconn.write_line(\"${3:hello}\")",
      "\t\tprintln(conn.read_line() ?? \"no answer\")",
      "\t\tconn.close()",
      "\t}",
      "\tResult.Err(e) => println(\"connect failed: \" + e)",
      "}"
    ]
  }
}
