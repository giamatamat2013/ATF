{
  "name": "atf",
  "displayName": "ATF",
  "description": "Syntax highlighting, snippets, compiler diagnostics, run/build commands and outline for ATF (Accessible Typed Fast), a small compiled programming language (.atf files).",
  "version": "1.3.1",
  "publisher": "tamat2013",
  "author": {
    "name": "TAMAT2013"
  },
  "icon": "icon.png",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "atf"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:atf"
  ],
  "contributes": {
    "commands": [
      { "command": "atf.run", "title": "ATF: Run File", "icon": "$(play)" },
      { "command": "atf.build", "title": "ATF: Build File" },
      { "command": "atf.check", "title": "ATF: Check File" },
      { "command": "atf.watch", "title": "ATF: Run File on Every Save" },
      { "command": "atf.test", "title": "ATF: Run Tests" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "atf.run", "when": "resourceLangId == atf" }
      ]
    },
    "keybindings": [
      { "command": "atf.run", "key": "f5", "when": "editorLangId == atf" },
      { "command": "atf.run", "key": "ctrl+f5", "when": "editorLangId == atf" }
    ],
    "configuration": {
      "title": "ATF",
      "properties": {
        "atf.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ATF compiler (atf.exe). Empty: bin/atf.exe or atf.cmd in the workspace, else `atf` from PATH."
        },
        "atf.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Automatically add `import \"std/...\"` at the top of the file when you use a function or type from a standard library module."
        },
        "atf.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `atf check` when an .atf file is opened or saved and show errors in the editor."
        }
      }
    },
    "languages": [
      {
        "id": "atf",
        "aliases": [
          "atf",
          "atf"
        ],
        "extensions": [
          ".atf"
        ],
        "firstLine": "^#!.*\\batf\\b",
        "icon": {
          "light": "./atf-file.svg",
          "dark": "./atf-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "atf",
        "scopeName": "source.atf",
        "path": "./syntaxes/atf.tmLanguage.json"
      },
      {
        "scopeName": "markdown.atf.codeblock",
        "path": "./syntaxes/atf.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.atf": "atf"
        }
      }
    ],
    "snippets": [
      {
        "language": "atf",
        "path": "./snippets/atf.json"
      }
    ],
    "configurationDefaults": {
      "[atf]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "problemMatchers": [
      {
        "name": "atf",
        "label": "ATF compiler errors",
        "owner": "atf",
        "source": "atf",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning): (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+--> (.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ]
  }
}
